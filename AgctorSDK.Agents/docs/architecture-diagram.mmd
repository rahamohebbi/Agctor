graph TB
    subgraph AgctorSDK_Agents [AgctorSDK.Agents]
        subgraph Agent_types [Agent implementations namespace AgctorSDK.Core.Agents]
            Agent[Agent implements IAgent]
            LLMAgent[LLMAgent extends Agent]
            CoderAgent[CoderAgent extends Agent]
            HumanAgent[HumanAgentAdapter extends Agent]
            PullRequestAgent[PullRequestAgent extends Agent]
            TaskScoperAgent[TaskScoperAgent extends Agent]
            SessionCoord[SessionCoordinatorAgent extends Agent]
            SessionMem[SessionMemoryAgent extends Agent]
            PersonExt[PersonExtractorProjectAgent extends Agent]
            MemCur[MemoryCuratorProjectAgent extends Agent]
            PersonQ[PersonQueryProjectAgent extends Agent]
            EchoAgent[EchoAgent implements IAgent only]
        end

        subgraph Actor_primitives [Actor primitives]
            BaseActor[BaseActor implements IActor]
        end

        subgraph Factory_registry [Factory and registry]
            AgentFactory[AgentFactory]
            TracingFactory[TracingAgentFactory decorates IAgentFactory]
            AgentRegistry[AgentRegistry]
            AgentTypeOptions[AgentTypeOptions AgentOptions]
        end

        subgraph Runtime_adapters [Runtime adapters]
            InMem[InMemoryActorRuntime]
            Proto[ProtoActorAdapter]
            Orleans[OrleansAdapter]
        end

        subgraph Task_exec [Task executors]
            CgExec[CodeGraphTaskExecutor]
            PrExec[PullRequestTaskExecutor]
        end

        subgraph Tool_models [Tool DTOs]
            ToolReq[ToolRequest]
            ToolRes[ToolResult]
        end
    end

    subgraph Core_contracts [AgctorSDK.Core contracts]
        IAgent[IAgent extends IActor]
        IActor[IActor]
        IFactory[IAgentFactory IAgentRegistry IActorRuntimeAdapter]
        Msgs[Core message types]
    end

    subgraph External [External]
        Ollama[Ollama HTTP]
        ProtoLib[Proto.Actor Proto.Cluster Proto.Remote]
    end

    Agent --> IAgent
    LLMAgent --> Agent
    CoderAgent --> Agent
    EchoAgent -.-> IAgent
    BaseActor --> IActor
    AgentFactory --> Agent
    AgentFactory --> InMem
    AgentFactory --> Proto
    AgentFactory --> AgentRegistry
    InMem -.-> IActor
    Proto -.-> IActor
    Orleans -.-> IActor
    LLMAgent --> Ollama
    Proto --> ProtoLib
    CgExec --> AgentFactory
    PrExec --> AgentFactory
    Agent --> Msgs

    style Agent fill:#b3e5fc
    style AgentFactory fill:#fff9c4
