@page
@model AgctorSDK.Host.Pages.Dashboard.ActorRuntimeModel
@{
    ViewData["Title"] = "Actor runtime";
}
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Actor runtime</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        Select an actor model, configure it, manage local Docker sidecars, and save for the next Host boot via
        <code class="text-xs bg-gray-100 dark:bg-gray-800 px-1 rounded">appsettings.User.json</code>.
        <strong class="font-medium text-amber-800 dark:text-amber-200">Restart the Host</strong> after saving to apply.
    </p>
</div>

<div id="actor-runtime-banner" class="hidden mb-4 p-4 rounded-lg bg-green-50 border border-green-200 dark:bg-green-900/20 dark:border-green-800" role="status">
    <p id="actor-runtime-banner-text" class="text-sm font-medium text-green-900 dark:text-green-100"></p>
    <p class="text-sm text-green-800 dark:text-green-200 mt-2"><strong>Restart the Host</strong> to load the selected actor runtime.</p>
</div>

@await Component.InvokeAsync("ActorRuntimeDashboard", new { selectedRuntimeId = Model.SelectedRuntime })

@section Scripts {
    <script src="~/js/dashboard/terminal-command-panel.js" asp-append-version="true"></script>
    <script src="~/js/dashboard/actor-runtime-dashboard.js" asp-append-version="true"></script>
}
