@page
@model AgctorSDK.Host.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Host Configuration";
}
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Host Configuration Overview</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Runtime, LLM, MCP, tools, and scenarios.</p>
</div>

<div id="overview-content" class="space-y-6">
    <div class="flex items-center justify-center p-8 rounded-lg bg-gray-100 dark:bg-gray-800">
        <div class="text-center">
            <div role="status">
                <svg class="inline w-8 h-8 text-gray-200 animate-spin dark:text-gray-600 fill-blue-600" viewBox="0 0 100 101" fill="none"><path d="M100 50.5908C100 78.2051 77.6142 100.591 50 100.591C22.3858 100.591 0 78.2051 0 50.5908C0 22.9766 22.3858 0.59082 50 0.59082C77.6142 0.59082 100 22.9766 100 50.5908Z" fill="currentColor"/><path d="M93.9676 39.0409C96.393 38.4038 97.8624 35.9116 97.0079 33.5539C95.2932 28.8227 92.871 24.3692 89.8167 20.348C85.8452 15.1192 80.8826 10.7238 75.2124 7.41289C69.5422 4.10194 63.2754 1.94025 56.7698 1.05124C51.7666 0.367541 46.6976 0.446843 41.7345 1.27873C39.2613 1.69328 37.813 4.19778 38.4501 6.62326C39.0873 9.04874 41.5694 10.4717 44.0505 10.1071C47.8511 9.54855 51.7191 9.52689 55.5402 10.0491C60.8642 10.7766 65.9928 12.5457 70.6331 15.2552C75.2735 17.9648 79.3347 21.5619 82.5849 25.841C84.9175 28.9121 86.7997 32.2913 88.1811 35.8758C89.083 38.2158 91.5421 39.6781 93.9676 39.0409Z" fill="currentFill"/></svg>
                <span class="sr-only">Loading...</span>
            </div>
            <p class="mt-2 text-gray-600 dark:text-gray-400">Loading configuration...</p>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function() {
    const el = document.getElementById('overview-content');
    function esc(s) { const d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; }
    fetch('/api/Config').then(r => r.ok ? r.json() : Promise.reject(r))
        .then(config => {
            const runtime = config.runtime || {};
            const llm = config.llm || {};
            const mcp = config.mcp || {};
            const bg = config.backgroundServices || {};
            const agentTypes = config.agentTypes ? Object.keys(config.agentTypes) : [];
            const tools = (config.tools || []).map(t => t.id);
            const scenarios = config.scenarios ? Object.keys(config.scenarios) : [];
            el.innerHTML = `
                <div class="grid gap-6 md:grid-cols-2">
                    <div class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
                        <h2 class="mb-4 text-lg font-semibold text-gray-900 dark:text-white">Runtime</h2>
                        <dl class="space-y-2 text-sm">
                            <div><dt class="text-gray-500 dark:text-gray-400">Name</dt><dd class="font-medium text-gray-900 dark:text-white">${esc(runtime.name)}</dd></div>
                            ${runtime.protoHost ? '<div><dt class="text-gray-500 dark:text-gray-400">Proto host</dt><dd class="font-medium text-gray-900 dark:text-white">' + esc(runtime.protoHost) + '</dd></div>' : ''}
                            ${runtime.protoPort != null ? '<div><dt class="text-gray-500 dark:text-gray-400">Proto port</dt><dd class="font-medium text-gray-900 dark:text-white">' + runtime.protoPort + '</dd></div>' : ''}
                        </dl>
                    </div>
                    <div class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
                        <h2 class="mb-4 text-lg font-semibold text-gray-900 dark:text-white">LLM (Ollama)</h2>
                        <p class="mb-3 text-xs text-gray-500 dark:text-gray-400">Global default for Host LLM usage. Base URL is set in appsettings; model is saved to <code class="text-[11px] bg-gray-100 dark:bg-gray-800 px-1 rounded">appsettings.json</code> when you click Set as default.</p>
                        <dl class="space-y-2 text-sm">
                            <div><dt class="text-gray-500 dark:text-gray-400">Ollama URL</dt><dd id="llm-ollama-url" class="font-mono text-gray-900 dark:text-white break-all">${esc(llm.ollamaApiUrl)}</dd></div>
                            <div><dt class="text-gray-500 dark:text-gray-400">Default model</dt><dd id="llm-default-model" class="font-medium text-gray-900 dark:text-white">${esc(llm.defaultModel)}</dd></div>
                        </dl>
                        <div class="mt-4 space-y-3 border-t border-gray-200 pt-4 dark:border-gray-600">
                            <button type="button" id="llm-refresh-models" class="inline-flex items-center px-3 py-2 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-100 dark:bg-gray-700 dark:text-gray-200 dark:border-gray-600 dark:hover:bg-gray-600">Refresh models</button>
                            <div>
                                <label for="llm-model-select" class="block text-xs font-medium text-gray-600 dark:text-gray-300">Local models</label>
                                <select id="llm-model-select" class="mt-1 block w-full rounded-lg border border-gray-300 bg-white px-2 py-2 text-sm text-gray-900 dark:border-gray-600 dark:bg-gray-900 dark:text-white"></select>
                            </div>
                            <button type="button" id="llm-set-default" class="inline-flex items-center px-3 py-2 text-xs font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700">Set as default</button>
                            <p id="llm-action-msg" class="hidden text-sm"></p>
                        </div>
                    </div>
                    <div class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
                        <h2 class="mb-4 text-lg font-semibold text-gray-900 dark:text-white">MCP</h2>
                        <dl class="space-y-2 text-sm">
                            <div><dt class="text-gray-500 dark:text-gray-400">Host</dt><dd class="font-medium text-gray-900 dark:text-white">${esc(mcp.host)}</dd></div>
                            <div><dt class="text-gray-500 dark:text-gray-400">Port</dt><dd class="font-medium text-gray-900 dark:text-white">${mcp.port ?? ''}</dd></div>
                        </dl>
                    </div>
                    <div class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
                        <h2 class="mb-4 text-lg font-semibold text-gray-900 dark:text-white">Paths &amp; Services</h2>
                        <dl class="space-y-2 text-sm">
                            <div><dt class="text-gray-500 dark:text-gray-400">Generated code root</dt><dd class="font-mono text-gray-900 dark:text-white break-all text-xs">${esc(config.generatedCodeRoot)}</dd></div>
                            <div><dt class="text-gray-500 dark:text-gray-400">TaskScoper</dt><dd class="font-medium text-gray-900 dark:text-white">${bg.taskScoperScanIntervalSeconds ?? ''}s</dd></div>
                            <div><dt class="text-gray-500 dark:text-gray-400">TaskFlow</dt><dd class="font-medium text-gray-900 dark:text-white">${bg.taskFlowIntervalSeconds ?? ''}s</dd></div>
                        </dl>
                    </div>
                </div>
                <div class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
                    <h2 class="mb-4 text-lg font-semibold text-gray-900 dark:text-white">Registered agent types</h2>
                    <div class="flex flex-wrap gap-2">${agentTypes.map(t => '<span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300">' + esc(t) + '</span>').join('')}</div>
                </div>
                <div class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
                    <h2 class="mb-4 text-lg font-semibold text-gray-900 dark:text-white">Tools</h2>
                    <div class="flex flex-wrap gap-2">${tools.map(t => '<span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-green-900 dark:text-green-300">' + esc(t) + '</span>').join('')}</div>
                </div>
                <div class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
                    <h2 class="mb-4 text-lg font-semibold text-gray-900 dark:text-white">Scenarios</h2>
                    <div class="flex flex-wrap gap-2">${scenarios.map(s => '<span class="bg-gray-100 text-gray-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-gray-700 dark:text-gray-300">' + esc(s) + '</span>').join('')}</div>
                </div>
            `;
            initLlmCard();
        })
        .catch(() => {
            el.innerHTML = '<div class="p-6 bg-red-50 border border-red-200 rounded-lg dark:bg-gray-800 dark:border-red-800"><p class="text-red-700 dark:text-red-400">Failed to load configuration.</p></div>';
        });

    function initLlmCard() {
        const msg = document.getElementById('llm-action-msg');
        const select = document.getElementById('llm-model-select');
        const refresh = document.getElementById('llm-refresh-models');
        const save = document.getElementById('llm-set-default');
        if (!msg || !select || !refresh || !save) return;

        function showMsg(text, isErr) {
            msg.textContent = text;
            msg.classList.remove('hidden', 'text-green-700', 'dark:text-green-400', 'text-amber-800', 'dark:text-amber-200', 'text-red-700', 'dark:text-red-400');
            msg.classList.add(isErr ? 'text-red-700' : 'text-green-700', isErr ? 'dark:text-red-400' : 'dark:text-green-400');
            msg.classList.remove('hidden');
        }

        function showWarn(text) {
            msg.textContent = text;
            msg.classList.remove('hidden', 'text-green-700', 'dark:text-green-400', 'text-red-700', 'dark:text-red-400');
            msg.classList.add('text-amber-800', 'dark:text-amber-200');
        }

        async function reloadLlmSummary() {
            const r = await fetch('/api/Config');
            if (!r.ok) return;
            const c = await r.json();
            const llm = c.llm || {};
            const urlEl = document.getElementById('llm-ollama-url');
            const modelEl = document.getElementById('llm-default-model');
            if (urlEl) urlEl.textContent = llm.ollamaApiUrl ?? '';
            if (modelEl) modelEl.textContent = llm.defaultModel ?? '';
        }

        /** Same as Refresh: fetch /api/Llm/models and fill the select; sync selection to current default. */
        async function loadModels(silent) {
            if (!silent) msg.classList.add('hidden');
            refresh.disabled = true;
            try {
                const r = await fetch('/api/Llm/models');
                if (!r.ok) {
                    const err = await r.json().catch(function () { return {}; });
                    showMsg((err.message || 'Could not list models. Is Ollama running?'), true);
                    return;
                }
                const data = await r.json();
                const models = data.models || [];
                select.replaceChildren();
                for (let i = 0; i < models.length; i++) {
                    const m = models[i];
                    const opt = document.createElement('option');
                    opt.value = m.name;
                    opt.textContent = m.name;
                    select.appendChild(opt);
                }
                const cur = document.getElementById('llm-default-model');
                if (cur && cur.textContent && select.options.length) {
                    for (let j = 0; j < select.options.length; j++) {
                        if (select.options[j].value === cur.textContent) { select.selectedIndex = j; break; }
                    }
                }
                if (!silent) {
                    showMsg(models.length ? ('Loaded ' + models.length + ' model(s).') : 'No models reported by Ollama.', false);
                }
            } catch (e) {
                showMsg('Failed to reach Host for model list.', true);
            } finally {
                refresh.disabled = false;
            }
        }

        refresh.addEventListener('click', function () { loadModels(false); });

        void loadModels(true);

        save.addEventListener('click', async function () {
            msg.classList.add('hidden');
            const model = (select.value || '').trim();
            if (!model) {
                showMsg('Choose a model from the list (wait for models to load or use Refresh models).', true);
                return;
            }
            save.disabled = true;
            try {
                const r = await fetch('/api/Llm/default-model', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ model: model })
                });
                if (!r.ok) {
                    const err = await r.json().catch(function () { return {}; });
                    showMsg(err.message || 'Save failed.', true);
                    return;
                }
                const body = await r.json().catch(function () { return {}; });
                await reloadLlmSummary();
                if (body.warning) showWarn('Saved. ' + body.warning);
                else showMsg('Default model updated in appsettings.json.', false);
            } catch (e) {
                showMsg('Request failed.', true);
            } finally {
                save.disabled = false;
            }
        });
    }
})();
</script>
}
