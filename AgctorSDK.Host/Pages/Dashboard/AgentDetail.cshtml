@page "/Dashboard/AgentDetail/{id}"
@model AgctorSDK.Host.Pages.Dashboard.AgentDetailModel
@{
    ViewData["Title"] = "Agent: " + (Model.Id ?? "");
}
<div class="mb-6">
    <a href="/Dashboard/Agents" class="text-sm font-medium text-blue-600 dark:text-blue-500 hover:underline">← Agents</a>
    <h1 class="mt-2 text-2xl font-bold text-gray-900 dark:text-white">Agent: @(Model.Id ?? "")</h1>
</div>

<div id="agent-detail-content" class="space-y-6">
    <div class="flex items-center justify-center p-8 rounded-lg bg-gray-100 dark:bg-gray-800">
        <div class="text-center">
            <div role="status">
                <svg class="inline w-8 h-8 text-gray-200 animate-spin dark:text-gray-600 fill-blue-600" viewBox="0 0 100 101" fill="none"><path d="M100 50.5908C100 78.2051 77.6142 100.591 50 100.591C22.3858 100.591 0 78.2051 0 50.5908C0 22.9766 22.3858 0.59082 50 0.59082C77.6142 0.59082 100 22.9766 100 50.5908Z" fill="currentColor"/><path d="M93.9676 39.0409C96.393 38.4038 97.8624 35.9116 97.0079 33.5539C95.2932 28.8227 92.871 24.3692 89.8167 20.348C85.8452 15.1192 80.8826 10.7238 75.2124 7.41289C69.5422 4.10194 63.2754 1.94025 56.7698 1.05124C51.7666 0.367541 46.6976 0.446843 41.7345 1.27873C39.2613 1.69328 37.813 4.19778 38.4501 6.62326C39.0873 9.04874 41.5694 10.4717 44.0505 10.1071C47.8511 9.54855 51.7191 9.52689 55.5402 10.0491C60.8642 10.7766 65.9928 12.5457 70.6331 15.2552C75.2735 17.9648 79.3347 21.5619 82.5849 25.841C84.9175 28.9121 86.7997 32.2913 88.1811 35.8758C89.083 38.2158 91.5421 39.6781 93.9676 39.0409Z" fill="currentFill"/></svg>
                <span class="sr-only">Loading...</span>
            </div>
            <p class="mt-2 text-gray-600 dark:text-gray-400">Loading agent...</p>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function() {
    const id = @Json.Serialize(Model.Id);
    if (!id) { document.getElementById('agent-detail-content').innerHTML = '<div class="p-6 bg-red-50 border border-red-200 rounded-lg dark:bg-gray-800 dark:border-red-800"><p class="text-red-700 dark:text-red-400">Missing agent id.</p></div>'; return; }
    const el = document.getElementById('agent-detail-content');
    function esc(s) { const d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; }
    fetch('/api/agents/' + encodeURIComponent(id) + '/detail').then(r => r.ok ? r.json() : (r.status === 404 ? null : Promise.reject(r)))
        .then(data => {
            if (!data) { el.innerHTML = '<div class="p-6 bg-red-50 border border-red-200 rounded-lg dark:bg-gray-800 dark:border-red-800"><p class="text-red-700 dark:text-red-400">Agent not found.</p></div>'; return; }
            let detailHtml = '';
            if (data.detail) {
                if (data.type === 'LLMAgent' && data.detail.ollamaApiUrl !== undefined)
                    detailHtml = '<div class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700"><h2 class="mb-4 text-lg font-semibold text-gray-900 dark:text-white">LLM</h2><dl class="space-y-2 text-sm"><div><dt class="text-gray-500 dark:text-gray-400">Ollama URL</dt><dd class="font-mono text-gray-900 dark:text-white break-all">' + esc(data.detail.ollamaApiUrl) + '</dd></div><div><dt class="text-gray-500 dark:text-gray-400">Default model</dt><dd class="font-medium text-gray-900 dark:text-white">' + esc(data.detail.defaultModel || '') + '</dd></div></dl></div>';
                else if (data.type === 'CoderAgent' && data.detail.tools)
                    detailHtml = '<div class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700"><h2 class="mb-4 text-lg font-semibold text-gray-900 dark:text-white">Tools pipeline</h2><p class="text-gray-600 dark:text-gray-400 mb-2">' + esc(data.detail.pipeline || '') + '</p><ul class="list-disc list-inside">' + data.detail.tools.map(t => '<li class="text-gray-900 dark:text-white">' + esc(t) + '</li>').join('') + '</ul></div>';
                else
                    detailHtml = '<div class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700"><h2 class="mb-4 text-lg font-semibold text-gray-900 dark:text-white">Detail</h2><pre class="p-4 text-sm bg-gray-100 dark:bg-gray-700 rounded overflow-x-auto">' + esc(JSON.stringify(data.detail, null, 2)) + '</pre></div>';
            }
            el.innerHTML = '<div class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700 mb-6"><h2 class="mb-4 text-lg font-semibold text-gray-900 dark:text-white">Info</h2><dl class="space-y-2 text-sm"><div><dt class="text-gray-500 dark:text-gray-400">Id</dt><dd class="font-medium text-gray-900 dark:text-white">' + esc(data.id) + '</dd></div><div><dt class="text-gray-500 dark:text-gray-400">Type</dt><dd><span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300">' + esc(data.type) + '</span></dd></div><div><dt class="text-gray-500 dark:text-gray-400">Status</dt><dd class="font-medium text-gray-900 dark:text-white">' + esc(data.status) + '</dd></div></dl></div>' + detailHtml;
        })
        .catch(() => { el.innerHTML = '<div class="p-6 bg-red-50 border border-red-200 rounded-lg dark:bg-gray-800 dark:border-red-800"><p class="text-red-700 dark:text-red-400">Failed to load agent detail.</p></div>'; });
})();
</script>
}
