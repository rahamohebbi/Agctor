@page "/Dashboard/ProjectMemory/Schema"
@model AgctorSDK.Host.Pages.Dashboard.ProjectMemory.SchemaModel
@{
    ViewData["Title"] = "Schema studio";
}
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Storage rules (schema)</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Edit YAML segments resolved by the project loader. Save writes atomically under the project root.</p>
</div>

<div id="pm-schema-root" class="space-y-4">
    <p class="text-gray-600 dark:text-gray-400">Loading schema bundle…</p>
</div>

@section Scripts {
    <script src="~/js/dashboard/project-memory-schema.js" asp-append-version="true"></script>
}
