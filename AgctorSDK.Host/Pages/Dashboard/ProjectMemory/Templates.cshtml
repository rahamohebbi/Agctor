@page "/Dashboard/ProjectMemory/Templates"
@model AgctorSDK.Host.Pages.Dashboard.ProjectMemory.TemplatesModel
@{
    ViewData["Title"] = "Agent templates";
}
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Agent templates</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Seed <code class="text-xs bg-gray-100 dark:bg-gray-800 px-1 rounded">.agctor/agents/</code> from vetted patterns; customize after creation. For definitions + scenarios in one place see <a href="/Dashboard/Agents" class="text-blue-600 hover:underline dark:text-blue-400">Agents (unified)</a>.</p>
</div>

<div id="pm-templates-root" class="space-y-8">
    <p class="text-gray-600 dark:text-gray-400">Loading templates…</p>
</div>

@section Scripts {
    <script src="~/js/dashboard/project-memory-templates.js" asp-append-version="true"></script>
}
