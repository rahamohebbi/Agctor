@page "/Dashboard/ProjectMemory/Playground"
@model AgctorSDK.Host.Pages.Dashboard.ProjectMemory.PlaygroundModel
@{
    ViewData["Title"] = "Agent playground";
}
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Project memory agent playground</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Chat-style testing with <strong>streaming</strong> and a persisted transcript. Pick a <strong>project</strong>, then a <strong>session</strong>, then send messages. Each project has a <strong>scenario</strong> (set at creation; changeable from the chat column). The scenario auto-picks the right agent; use <em>Advanced</em> under the composer to override. The <strong>Trace timeline</strong> below refreshes after each streamed turn.</p>
</div>

<div id="pm-play-root" class="space-y-4">
    @* Three-region workspace: projects | sessions | chat (stacks on small screens). *@
    <div class="flex flex-col gap-4 xl:flex-row xl:items-stretch xl:gap-0 xl:rounded-lg xl:overflow-hidden xl:border xl:border-gray-200 xl:dark:border-gray-700 xl:shadow dark:xl:bg-gray-800/50">
        @* Projects rail *@
        <aside class="w-full shrink-0 xl:w-56 xl:border-r xl:border-gray-200 xl:dark:border-gray-700 p-4 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700 xl:rounded-none xl:border-0 xl:shadow-none">
            <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-2">Projects</h2>
            <div id="pm-play-project-list" class="max-h-[40vh] xl:max-h-none xl:overflow-y-auto space-y-1 mb-4" role="listbox" aria-label="Projects"></div>
            <div class="border-t border-gray-200 dark:border-gray-600 pt-3 space-y-2">
                <label for="pm-play-project-name" class="block text-xs font-medium text-gray-700 dark:text-gray-300">New project</label>
                <input type="text" id="pm-play-project-name" class="w-full rounded-lg border border-gray-300 bg-gray-50 p-2 text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white" placeholder="Name…" autocomplete="off" />
                <label for="pm-play-scenario-new" class="block text-xs font-medium text-gray-700 dark:text-gray-300">Scenario</label>
                <select id="pm-play-scenario-new" class="w-full rounded-lg border border-gray-300 bg-gray-50 p-2 text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white"></select>
                <button type="button" id="pm-play-new-project" class="w-full px-3 py-2 text-sm font-medium text-gray-800 bg-gray-100 rounded-lg hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-100 dark:hover:bg-gray-600">Create project</button>
                <p class="text-[11px] text-gray-500 dark:text-gray-400">Scenario applies to this project only. You can change it later from the chat column.</p>
            </div>
        </aside>

        @* Sessions column *@
        <aside class="w-full shrink-0 xl:w-64 xl:border-r xl:border-gray-200 xl:dark:border-gray-700 p-4 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700 xl:rounded-none xl:border-0 xl:shadow-none flex flex-col min-h-[12rem]">
            <div class="flex items-center justify-between gap-2 mb-2">
                <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Sessions</h2>
                <button type="button" id="pm-play-refresh" class="px-2 py-1 text-xs font-medium text-blue-700 bg-blue-50 rounded hover:bg-blue-100 dark:bg-blue-900/30 dark:text-blue-200">Refresh</button>
            </div>
            <div id="pm-play-session-list" class="flex-1 overflow-y-auto max-h-[40vh] xl:max-h-[min(60vh,28rem)] space-y-1 mb-3" role="listbox" aria-label="Sessions in this project"></div>
            <button type="button" id="pm-play-new-session" class="w-full px-3 py-2 text-sm font-medium text-gray-800 bg-gray-100 rounded-lg hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-100 dark:hover:bg-gray-600">New session</button>
            <p id="pm-play-hint" class="mt-2 text-[11px] text-gray-500 dark:text-gray-400"></p>
        </aside>

        @* Chat + debug (flow + trace below transcript per PRD-017). Hidden until a session is chosen. *@
        <div class="flex-1 min-w-0 flex flex-col min-h-0 p-4 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700 xl:rounded-none xl:border-0 xl:shadow-none">
            <div id="pm-play-no-session" class="hidden flex flex-1 min-h-[280px] items-center justify-center rounded-lg border border-dashed border-gray-200 bg-gray-50 dark:border-gray-600 dark:bg-gray-900/30">
                <p class="text-sm text-gray-500 dark:text-gray-400 text-center px-4">Select or create a new session.</p>
            </div>
            <div id="pm-play-session-detail" class="space-y-4 flex-1 flex flex-col min-h-0">
            <div id="pm-play-project-header" class="hidden rounded-lg border border-gray-200 bg-gray-50 p-3 dark:border-gray-600 dark:bg-gray-900/40">
                <div class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-0.5">Selected project</div>
                <div id="pm-play-project-title" class="text-sm font-semibold text-gray-900 dark:text-white truncate"></div>
                <div class="mt-2 flex flex-wrap items-center gap-2">
                    <span id="pm-play-project-scenario-label" class="text-sm text-gray-800 dark:text-gray-200"></span>
                    <button type="button" id="pm-play-change-scenario" class="text-xs font-medium text-blue-700 hover:underline dark:text-blue-300">Change scenario…</button>
                </div>
                <div class="mt-2 grid gap-3 sm:grid-cols-2">
                    <div>
                        <label for="pm-play-focus-entity" class="block text-xs font-medium text-gray-700 dark:text-gray-300">Focus person</label>
                        <select id="pm-play-focus-entity" class="mt-0.5 w-full rounded-lg border border-gray-300 bg-white p-2 text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                            <option value="">(none — infer from chat)</option>
                        </select>
                        <p class="mt-1 text-[10px] text-gray-500 dark:text-gray-400">Scopes pronouns and short questions to this person for the project scenario workspace.</p>
                    </div>
                    <div>
                        <label for="pm-play-visual-max-photos" class="block text-xs font-medium text-gray-700 dark:text-gray-300">Photos in context</label>
                        <input type="number" id="pm-play-visual-max-photos" min="1" max="12" step="1" value="3" class="mt-0.5 w-full max-w-[6rem] rounded-lg border border-gray-300 bg-white p-2 text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                        <p class="mt-1 text-[10px] text-gray-500 dark:text-gray-400">How many recent photos coaches can use when you ask about “this photo” (newest first).</p>
                        <p id="pm-play-visual-max-hint" class="mt-0.5 text-[10px] text-blue-700/80 dark:text-blue-300/80 hidden"></p>
                    </div>
                </div>
                <div id="pm-play-scenario-change-panel" class="hidden mt-3 pt-3 border-t border-gray-200 dark:border-gray-600 space-y-2">
                    <p class="text-[11px] text-amber-800 dark:text-amber-200/90">Changing scenario affects routing and flow for <strong>this project</strong> going forward; older transcript lines were produced under the previous scenario.</p>
                    <label for="pm-play-scenario-change" class="block text-xs font-medium text-gray-700 dark:text-gray-300">New scenario</label>
                    <select id="pm-play-scenario-change" class="w-full max-w-md rounded-lg border border-gray-300 bg-white p-2 text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white"></select>
                    <div class="flex flex-wrap gap-2">
                        <button type="button" id="pm-play-scenario-apply" class="px-3 py-1.5 text-xs font-medium text-white bg-blue-600 rounded hover:bg-blue-700">Apply</button>
                        <button type="button" id="pm-play-scenario-cancel" class="px-3 py-1.5 text-xs font-medium text-gray-700 bg-gray-100 rounded hover:bg-gray-200 dark:bg-gray-600 dark:text-gray-100">Cancel</button>
                    </div>
                </div>
            </div>

            <div class="p-4 bg-gray-50 border border-gray-200 rounded-lg dark:bg-gray-900/30 dark:border-gray-600 min-h-[280px] flex flex-col">
                <div class="flex items-center justify-between mb-2">
                    <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Transcript</h2>
                    <span id="pm-play-status" class="text-xs text-gray-500 dark:text-gray-400" role="status"></span>
                </div>
                <div id="pm-play-messages" class="pm-chat-feed flex-1 overflow-y-auto max-h-[50vh] pr-1 text-sm" aria-live="polite"></div>
                <div id="pm-play-composer" class="mt-4 space-y-2">
                    <div id="pm-play-attach-chips" class="hidden flex flex-wrap gap-2" aria-live="polite"></div>
                    <div class="flex gap-2 items-end">
                        <button type="button" id="pm-play-attach" class="self-end px-3 py-2.5 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-100 dark:hover:bg-gray-600 shrink-0" title="Attach photos">📷</button>
                        <input type="file" id="pm-play-file-input" accept="image/*" multiple class="hidden" />
                        <textarea id="pm-play-input" rows="3" class="flex-1 rounded-lg border border-gray-300 bg-white p-2.5 text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white" placeholder="Type a message… (paste or drop images)"></textarea>
                        <button type="button" id="pm-play-send" class="self-end px-4 py-2.5 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 shrink-0">Send</button>
                    </div>
                </div>

                <div id="pm-play-daily-life" class="mt-3 hidden rounded-lg border border-emerald-200 bg-emerald-50/80 p-3 dark:border-emerald-800 dark:bg-emerald-950/30">
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                        <h3 class="text-xs font-semibold uppercase tracking-wide text-emerald-800 dark:text-emerald-200">Reminders <span id="pm-play-nudges-scenario" class="font-normal normal-case"></span></h3>
                        <button type="button" id="pm-play-refresh-signals" class="text-[11px] font-medium text-emerald-800 hover:underline dark:text-emerald-200">Refresh</button>
                    </div>
                    <ul id="pm-play-life-signals" class="text-xs text-emerald-900 dark:text-emerald-100 space-y-1 list-disc pl-4"></ul>
                    <p class="mt-2 text-[10px] text-emerald-800/80 dark:text-emerald-200/70">Type in the message box above — the scenario flow and router handle saves, questions, and coaching.</p>
                </div>

                <div id="pm-play-inbox" class="mt-3 hidden rounded-lg border border-amber-200 bg-amber-50/80 p-3 dark:border-amber-800 dark:bg-amber-950/30">
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                        <h3 class="text-xs font-semibold uppercase tracking-wide text-amber-900 dark:text-amber-100">
                            Confirmation inbox
                            <span id="pm-play-inbox-badge" class="hidden ml-1.5 inline-flex min-w-[1.25rem] items-center justify-center rounded-full bg-amber-600 px-1.5 py-0.5 text-[10px] font-bold text-white normal-case">0</span>
                            <span id="pm-play-inbox-count" class="font-normal normal-case"></span>
                        </h3>
                        <button type="button" id="pm-play-refresh-inbox" class="text-[11px] font-medium text-amber-900 hover:underline dark:text-amber-100">Refresh</button>
                    </div>
                    <ul id="pm-play-inbox-list" class="text-xs text-amber-950 dark:text-amber-50 space-y-2"></ul>
                    <p class="mt-2 text-[10px] text-amber-900/80 dark:text-amber-100/70">Facts that could not be routed automatically. Approve to write them into people files; reject to discard.</p>
                </div>

                <details id="pm-play-privacy" class="mt-3 hidden group rounded-lg border border-gray-200 bg-gray-50/90 p-3 dark:border-gray-600 dark:bg-gray-900/40">
                    <summary class="cursor-pointer select-none text-xs font-semibold uppercase tracking-wide text-gray-700 dark:text-gray-200">Privacy</summary>
                    <div class="mt-3 space-y-3 text-xs text-gray-700 dark:text-gray-300">
                        <label class="flex items-center gap-2">
                            <input type="checkbox" id="pm-play-privacy-auto-ingest" class="rounded border-gray-300" checked />
                            Auto-ingest new chat turns on session checkpoint/delete
                        </label>
                        <div class="flex flex-wrap items-end gap-2">
                            <div class="flex-1 min-w-[8rem]">
                                <label for="pm-play-forget-entity" class="block text-[10px] font-medium mb-1">Forget person</label>
                                <select id="pm-play-forget-entity" class="w-full rounded border border-gray-300 bg-white p-1.5 text-xs dark:bg-gray-700 dark:border-gray-600 dark:text-white"></select>
                            </div>
                            <button type="button" id="pm-play-forget-btn" class="px-2 py-1.5 text-xs font-medium text-red-700 border border-red-300 rounded hover:bg-red-50 dark:text-red-300 dark:border-red-700 dark:hover:bg-red-950/40">Delete folder</button>
                        </div>
                        <button type="button" id="pm-play-export-btn" class="text-[11px] font-medium text-blue-700 hover:underline dark:text-blue-300">Export scenario people (zip)</button>
                    </div>
                </details>

                @* PRD-017 Advanced disclosure: agent is auto-picked from the scenario; operators rarely need to touch it. *@
                <details id="pm-play-advanced" class="mt-3 group">
                    <summary class="cursor-pointer select-none text-xs font-medium text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200">
                        <span class="inline-flex items-center gap-1">
                            <svg class="h-3 w-3 transition-transform group-open:rotate-90" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.168 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z" clip-rule="evenodd"/></svg>
                            Advanced
                        </span>
                        <span id="pm-play-agent-auto-label" class="ml-2 text-[11px] font-normal text-gray-500 dark:text-gray-400"></span>
                    </summary>
                    <div class="mt-2 rounded-lg border border-gray-200 bg-white p-3 dark:border-gray-600 dark:bg-gray-800/70 space-y-2">
                        <label for="pm-play-agent" class="block text-xs font-medium text-gray-700 dark:text-gray-300">Agent spec (override)</label>
                        <select id="pm-play-agent" class="w-full rounded-lg border border-gray-300 bg-gray-50 p-2 text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white"></select>
                        <p class="text-[11px] text-gray-500 dark:text-gray-400">Options are scoped to this scenario's personas. The <strong>extractor</strong> is chosen automatically because it's the only agent that can write updates to disk. Override only for debugging a specific persona.</p>
                        <button type="button" id="pm-play-agent-reset" class="text-[11px] font-medium text-blue-700 hover:underline dark:text-blue-300">Reset to scenario default</button>
                    </div>
                </details>
            </div>

            <div id="pm-play-flow-card" class="p-4 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
                <div class="flex items-center justify-between gap-2 mb-2">
                    <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Request pipeline (debug)</h2>
                    <span class="text-[10px] text-gray-500 dark:text-gray-400">SSE from <code class="text-[10px]">/playground/message/stream</code></span>
                </div>
                <p class="text-xs text-gray-600 dark:text-gray-300 mb-2">When a <strong>scenario id</strong> is resolved and the catalog scenario has a valid <strong>flow</strong> graph, the server runs that graph: each step uses the previous step’s output as input; Router uses the graph (LLM or rule-based). Initial chips show Chat input and Router; after routing, a <code>flow_plan_tail</code> event adds branch lanes (parallel) or a linear tail. Multiple matching personas may run in <strong>parallel</strong>, <strong>sequential</strong> (extract before query), or <strong>auto</strong> (router LLM decides). The final reply uses the scenario <code>outputPolicy</code> (people scenarios use <code>ranked</code> so <strong>person-query</strong> wins over ingest personas). Markdown on disk is updated when <strong>person-extractor</strong> output parses as <code>memoryIntents</code> JSON and ingest succeeds.</p>
                <div id="pm-play-flow-steps" class="flex flex-wrap items-start gap-1 min-h-[2rem]"></div>
                <p id="pm-play-flow-detail" class="mt-2 text-[11px] font-mono text-gray-600 dark:text-gray-400 break-words"></p>
            </div>

            @await Component.InvokeAsync("TraceTimeline", new
            {
                componentId = "pm-play-trace-timeline",
                title = "Trace timeline",
                emptyMessage = "Send a message to see LLM, ingest, and persist spans for this request.",
                heightPx = 320
            })
            </div>
        </div>
    </div>
</div>

<style>
    .pm-play-md p { margin: 0; }
    .pm-play-md ol, .pm-play-md ul { margin: 0.25rem 0 0.25rem 1.25rem; padding: 0; }
    .pm-play-md code { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 0.75rem; background: rgba(156, 163, 175, 0.2); border-radius: 0.25rem; padding: 0.05rem 0.25rem; }
    .pm-flow-node { transition: border-color 0.15s, background-color 0.15s; }
    .pm-flow-node .pm-flow-dot { transition: background-color 0.15s; }
    .pm-flow-pending .pm-flow-dot { background-color: #9ca3af; }
    .pm-flow-running .pm-flow-dot { background-color: #eab308; animation: pm-flow-pulse 1s ease-in-out infinite; }
    .pm-flow-done .pm-flow-dot { background-color: #22c55e; }
    .pm-flow-skipped .pm-flow-dot { background-color: #94a3b8; }
    .pm-flow-error .pm-flow-dot { background-color: #ef4444; }
    .pm-flow-running { border-color: #eab308 !important; }
    .pm-flow-done { border-color: #22c55e !important; }
    .pm-flow-error { border-color: #ef4444 !important; }
    .pm-flow-lane { min-width: 0; background: rgba(249, 250, 251, 0.6); }
    .dark .pm-flow-lane { background: rgba(17, 24, 39, 0.45); }
    .pm-flow-parallel { flex-basis: 100%; }
    @@keyframes pm-flow-pulse { 50% { opacity: 0.45; } }
    .pm-play-list-btn { width: 100%; text-align: left; padding: 0.5rem 0.625rem; border-radius: 0.5rem; border: 1px solid transparent; font-size: 0.875rem; }
    .pm-play-list-btn:hover { background-color: rgba(243, 244, 246, 1); }
    .dark .pm-play-list-btn:hover { background-color: rgba(55, 65, 81, 0.6); }
    .pm-play-list-btn.pm-play-active { border-color: rgb(59, 130, 246); background-color: rgb(239, 246, 255); }
    .dark .pm-play-list-btn.pm-play-active { border-color: rgb(96, 165, 250); background-color: rgba(30, 58, 138, 0.35); }

    /* Chat transcript — messenger-style turns with persona identity */
    .pm-chat-feed { display: flex; flex-direction: column; gap: 0.875rem; }
    .pm-chat-turn { display: flex; align-items: flex-start; gap: 0.625rem; max-width: 100%; animation: pm-chat-in 0.22s ease-out; }
    @@keyframes pm-chat-in { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
    .pm-chat-turn--user { flex-direction: row-reverse; align-self: flex-end; max-width: min(100%, 36rem); }
    .pm-chat-turn--assistant { align-self: flex-start; max-width: min(100%, 42rem); }
    .pm-chat-avatar {
        flex-shrink: 0; width: 2.25rem; height: 2.25rem; border-radius: 9999px;
        display: flex; align-items: center; justify-content: center;
        font-size: 0.65rem; font-weight: 700; letter-spacing: 0.02em; color: #fff;
        box-shadow: 0 1px 2px rgba(0,0,0,0.12);
    }
    .pm-chat-avatar--user { background: linear-gradient(135deg, #3b82f6, #2563eb); }
    .pm-chat-body { min-width: 0; flex: 1; }
    .pm-chat-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.35rem 0.5rem; margin-bottom: 0.25rem; }
    .pm-chat-name { font-size: 0.75rem; font-weight: 600; line-height: 1.2; }
    .pm-chat-role { font-size: 0.625rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; opacity: 0.72; }
    .pm-chat-phase { font-size: 0.625rem; font-style: italic; opacity: 0.85; }
    .pm-chat-phase--live { color: #ca8a04; }
    .dark .pm-chat-phase--live { color: #facc15; }
    .pm-chat-bubble {
        border-radius: 0.875rem; padding: 0.625rem 0.875rem; border: 1px solid;
        line-height: 1.45; word-break: break-word;
    }
    .pm-chat-turn--user .pm-chat-bubble {
        background: #eff6ff; border-color: #bfdbfe; color: #1e3a8a;
    }
    .dark .pm-chat-turn--user .pm-chat-bubble {
        background: rgba(30, 58, 138, 0.35); border-color: #1d4ed8; color: #dbeafe;
    }
    .pm-chat-turn--assistant .pm-chat-bubble { border-width: 1px; }
    .pm-chat-bubble--streaming {
        box-shadow: 0 0 0 1px rgba(234, 179, 8, 0.35);
    }
    .pm-persona--extractor .pm-chat-avatar { background: linear-gradient(135deg, #10b981, #059669); }
    .pm-persona--extractor .pm-chat-bubble { background: #ecfdf5; border-color: #a7f3d0; color: #064e3b; }
    .dark .pm-persona--extractor .pm-chat-bubble { background: rgba(6, 78, 59, 0.35); border-color: #065f46; color: #d1fae5; }
    .pm-persona--query .pm-chat-avatar { background: linear-gradient(135deg, #3b82f6, #1d4ed8); }
    .pm-persona--query .pm-chat-bubble { background: #eff6ff; border-color: #bfdbfe; color: #1e3a8a; }
    .dark .pm-persona--query .pm-chat-bubble { background: rgba(30, 58, 138, 0.35); border-color: #1e40af; color: #dbeafe; }
    .pm-persona--style .pm-chat-avatar { background: linear-gradient(135deg, #a855f7, #7c3aed); }
    .pm-persona--style .pm-chat-bubble { background: #faf5ff; border-color: #e9d5ff; color: #581c87; }
    .dark .pm-persona--style .pm-chat-bubble { background: rgba(88, 28, 135, 0.35); border-color: #6b21a8; color: #f3e8ff; }
    .pm-persona--fitness .pm-chat-avatar { background: linear-gradient(135deg, #f97316, #ea580c); }
    .pm-persona--fitness .pm-chat-bubble { background: #fff7ed; border-color: #fed7aa; color: #7c2d12; }
    .dark .pm-persona--fitness .pm-chat-bubble { background: rgba(124, 45, 18, 0.35); border-color: #9a3412; color: #ffedd5; }
    .pm-persona--relationship .pm-chat-avatar { background: linear-gradient(135deg, #ec4899, #db2777); }
    .pm-persona--relationship .pm-chat-bubble { background: #fdf2f8; border-color: #fbcfe8; color: #831843; }
    .dark .pm-persona--relationship .pm-chat-bubble { background: rgba(131, 24, 67, 0.35); border-color: #9d174d; color: #fce7f3; }
    .pm-persona--curator .pm-chat-avatar { background: linear-gradient(135deg, #f59e0b, #d97706); }
    .pm-persona--curator .pm-chat-bubble { background: #fffbeb; border-color: #fde68a; color: #78350f; }
    .dark .pm-persona--curator .pm-chat-bubble { background: rgba(120, 53, 15, 0.35); border-color: #b45309; color: #fef3c7; }
