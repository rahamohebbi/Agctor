@page "/Dashboard/ProjectMemory/Agents"
@model AgctorSDK.Host.Pages.Dashboard.ProjectMemory.AgentsModel
@{
    ViewData["Title"] = "Project memory — Agents (advanced)";
}
<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Agents <span class="text-base font-normal text-gray-500 dark:text-gray-400">(advanced)</span></h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Role definitions under <code class="text-xs bg-gray-100 dark:bg-gray-800 px-1 rounded">.agctor/agents/</code>. Full editor, templates, and playground — also available from <a href="/Dashboard/Agents" class="text-blue-600 hover:underline dark:text-blue-400">Agents (unified)</a>.</p>
    </div>
    <div class="flex gap-2">
        <a href="/Dashboard/ProjectMemory/Templates" class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-100 dark:bg-gray-800 dark:text-gray-200 dark:border-gray-600 dark:hover:bg-gray-700">From template</a>
        <a href="/Dashboard/ProjectMemory/Playground" class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-100 dark:bg-gray-800 dark:text-gray-200 dark:border-gray-600 dark:hover:bg-gray-700">Playground</a>
        <a href="/Dashboard/ProjectMemory/Agents/Edit" class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700">New agent</a>
    </div>
</div>

@await Html.PartialAsync("_ProjectMemoryAgentsLegacyBanner")

<div id="pm-agents-root" class="space-y-4">
    <div class="flex items-center justify-center p-8 rounded-lg bg-gray-100 dark:bg-gray-800">
        <p class="text-gray-600 dark:text-gray-400">Loading agents…</p>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard/project-memory-agents.js" asp-append-version="true"></script>
}
