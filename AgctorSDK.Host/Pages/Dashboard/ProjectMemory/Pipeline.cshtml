@page "/Dashboard/ProjectMemory/Pipeline"
@model AgctorSDK.Host.Pages.Dashboard.ProjectMemory.PipelineModel
@{
    ViewData["Title"] = "Pipeline";
}
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Project memory pipeline</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Run the deterministic multi-agent flow: extract, route/write, and query. This is the Phase 2 operator UI for the orchestrator endpoint.</p>
</div>

<div id="pm-pipe-root" class="space-y-4">
    <div class="p-4 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
            <div>
                <label for="pm-pipe-mode" class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Mode</label>
                <select id="pm-pipe-mode" class="w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                    <option value="auto" selected>auto (ingest + query)</option>
                    <option value="ingestOnly">ingestOnly (extract + write)</option>
                    <option value="queryOnly">queryOnly (read + answer)</option>
                </select>
            </div>
            <div class="md:col-span-2">
                <label for="pm-pipe-project" class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Project filter (optional)</label>
                <select id="pm-pipe-project" class="w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white"></select>
            </div>
            <div class="md:col-span-2">
                <label for="pm-pipe-session" class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Session (optional context)</label>
                <select id="pm-pipe-session" class="w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white"></select>
            </div>
            <div class="flex items-end gap-2">
                <button type="button" id="pm-pipe-new-session" class="flex-1 px-3 py-2.5 text-sm font-medium text-gray-800 bg-gray-100 rounded-lg hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-100 dark:hover:bg-gray-600">New session</button>
                <button type="button" id="pm-pipe-refresh" class="px-3 py-2.5 text-sm font-medium text-blue-700 bg-blue-50 rounded-lg hover:bg-blue-100 dark:bg-blue-900/30 dark:text-blue-200">Refresh</button>
                <button type="button" id="pm-pipe-copy-link" class="px-3 py-2.5 text-sm font-medium text-indigo-700 bg-indigo-50 rounded-lg hover:bg-indigo-100 dark:bg-indigo-900/30 dark:text-indigo-200">Copy link</button>
            </div>
        </div>
        <p id="pm-pipe-hint" class="mt-3 text-xs text-gray-500 dark:text-gray-400"></p>
    </div>

    <div class="p-4 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
        <label for="pm-pipe-input" class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Message</label>
        <textarea id="pm-pipe-input" rows="4" class="w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white" placeholder="Example: Raha is now a staff engineer."></textarea>
        <div class="mt-3 flex items-center gap-3">
            <button type="button" id="pm-pipe-run" class="px-4 py-2.5 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700">Run pipeline</button>
            <span id="pm-pipe-status" class="text-xs text-gray-500 dark:text-gray-400" role="status"></span>
        </div>
    </div>

    <div class="p-4 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
        <h2 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">Result</h2>
        <div id="pm-pipe-result" class="text-sm text-gray-600 dark:text-gray-300">No run yet.</div>
        <h2 class="text-sm font-semibold text-gray-900 dark:text-white mt-5 mb-2">Timeline</h2>
        <div id="pm-pipe-steps" class="space-y-2 text-sm"></div>
    </div>
</div>

<style>
    .pm-pipe-md p { margin: 0; }
    .pm-pipe-md ol, .pm-pipe-md ul { margin: 0.25rem 0 0.25rem 1.25rem; padding: 0; }
    .pm-pipe-md code { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 0.75rem; background: rgba(156, 163, 175, 0.2); border-radius: 0.25rem; padding: 0.05rem 0.25rem; }
    .pm-pipe-md pre { white-space: pre-wrap; word-break: break-word; }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dompurify@3.1.6/dist/purify.min.js"></script>
    <script src="~/js/dashboard/project-memory-pipeline.js" asp-append-version="true"></script>
}
