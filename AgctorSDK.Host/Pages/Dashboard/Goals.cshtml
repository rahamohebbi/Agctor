@page
@model AgctorSDK.Host.Pages.Dashboard.GoalsModel
@{
    ViewData["Title"] = "Goals";
}
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Goals</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Set and add high-level goals. The TaskScoper turns them into a task DAG; TaskFlow runs the tasks.</p>
</div>

<div id="goals-content" class="space-y-6">
    <div class="flex items-center justify-center p-8 rounded-lg bg-gray-100 dark:bg-gray-800">
        <div class="text-center">
            <div role="status">
                <svg class="inline w-8 h-8 text-gray-200 animate-spin dark:text-gray-600 fill-blue-600" viewBox="0 0 100 101" fill="none"><path d="M100 50.5908C100 78.2051 77.6142 100.591 50 100.591C22.3858 100.591 0 78.2051 0 50.5908C0 22.9766 22.3858 0.59082 50 0.59082C77.6142 0.59082 100 22.9766 100 50.5908Z" fill="currentColor"/><path d="M93.9676 39.0409C96.393 38.4038 97.8624 35.9116 97.0079 33.5539C95.2932 28.8227 92.871 24.3692 89.8167 20.348C85.8452 15.1192 80.8826 10.7238 75.2124 7.41289C69.5422 4.10194 63.2754 1.94025 56.7698 1.05124C51.7666 0.367541 46.6976 0.446843 41.7345 1.27873C39.2613 1.69328 37.813 4.19778 38.4501 6.62326C39.0873 9.04874 41.5694 10.4717 44.0505 10.1071C47.8511 9.54855 51.7191 9.52689 55.5402 10.0491C60.8642 10.7766 65.9928 12.5457 70.6331 15.2552C75.2735 17.9648 79.3347 21.5619 82.5849 25.841C84.9175 28.9121 86.7997 32.2913 88.1811 35.8758C89.083 38.2158 91.5421 39.6781 93.9676 39.0409Z" fill="currentFill"/></svg>
                <span class="sr-only">Loading...</span>
            </div>
            <p class="mt-2 text-gray-600 dark:text-gray-400">Loading goals...</p>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function() {
    const el = document.getElementById('goals-content');
    let goalsList = [];
    let editingGoal = null;
    function esc(s) { const d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; }

    function setFormAddMode() {
        editingGoal = null;
        const t = document.getElementById('goal-form-title');
        const b = document.getElementById('goal-form-submit-btn');
        const c = document.getElementById('goal-form-cancel-btn');
        if (t) t.textContent = 'Add goal';
        if (b) b.textContent = 'Add goal';
        if (c) c.classList.add('hidden');
        const titleEl = document.getElementById('goal-title');
        const descEl = document.getElementById('goal-description');
        if (titleEl) titleEl.value = '';
        if (descEl) descEl.value = '';
    }
    function setFormEditMode(goal) {
        editingGoal = goal;
        document.getElementById('goal-title').value = goal.title || '';
        document.getElementById('goal-description').value = goal.description || '';
        document.getElementById('goal-form-title').textContent = 'Edit goal';
        var submitBtn = document.getElementById('goal-form-submit-btn');
        var cancelBtn = document.getElementById('goal-form-cancel-btn');
        var msgEl = document.getElementById('goal-form-message');
        cancelBtn.classList.remove('hidden');
        if (statusNum(goal) === 1) {
            submitBtn.textContent = 'Update goal';
            submitBtn.disabled = true;
            if (msgEl) { msgEl.textContent = 'Pause or Stop the goal to edit and save.'; msgEl.className = 'mt-3 text-sm text-amber-600 dark:text-amber-400'; }
        } else {
            submitBtn.textContent = 'Update goal';
            submitBtn.disabled = false;
            if (msgEl) msgEl.textContent = '';
        }
    }

    const statusNames = { 0: 'Pending', 1: 'InProgress', 2: 'Paused', 3: 'Completed', 4: 'Failed', 5: 'Cancelled' };
    function statusBadgeClass(status) {
        const num = typeof status === 'number' ? status : -1;
        const s = (typeof status === 'string' ? status : statusNames[num] || '').toLowerCase();
        if (s === 'pending' || num === 0) return 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300';
        if (s === 'inprogress' || num === 1) return 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300';
        if (s === 'paused' || num === 2) return 'bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-300';
        if (s === 'completed' || num === 3) return 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300';
        if (s === 'failed' || num === 4) return 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300';
        if (s === 'cancelled' || num === 5) return 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300';
        return 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300';
    }
    function statusLabel(status) {
        if (typeof status === 'number' && statusNames[status] !== undefined) return statusNames[status];
        return status || 'Pending';
    }
    function statusNum(g) { const s = g.status; return typeof s === 'number' ? s : (typeof s === 'string' ? { pending:0,inprogress:1,paused:2,completed:3,failed:4,cancelled:5 }[s.toLowerCase()] : 0); }
    function canPlay(g) { const n = statusNum(g); return n === 0 || n === 2; }
    function canPause(g) { return statusNum(g) === 1; }
    function canStop(g) { const n = statusNum(g); return n === 0 || n === 1 || n === 2; }
    function canEdit(g) { return statusNum(g) !== 1; }

    function render(goals) {
        const list = Array.isArray(goals) ? goals : [];
        goalsList = list;
        if (editingGoal) setFormAddMode();
        el.innerHTML = `
            <div class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
                <h2 id="goal-form-title" class="mb-2 text-lg font-semibold text-gray-900 dark:text-white">Add goal</h2>
                <p class="mb-4 text-sm text-gray-500 dark:text-gray-400">New goals are picked up by TaskScoper and turned into tasks. Use one line per task; dependencies: <code class="text-xs bg-gray-100 dark:bg-gray-700 px-1 rounded">Task2:Task1,Task0</code>.</p>
                <form id="goal-form" class="space-y-4">
                    <div>
                        <label for="goal-title" class="block mb-1 text-sm font-medium text-gray-700 dark:text-gray-300">Title</label>
                        <input type="text" id="goal-title" name="title" required maxlength="200" placeholder="e.g. Implement feature X"
                            class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white dark:placeholder-gray-400" />
                    </div>
                    <div>
                        <label for="goal-description" class="block mb-1 text-sm font-medium text-gray-700 dark:text-gray-300">Description</label>
                        <textarea id="goal-description" name="description" rows="4" placeholder="One line per task. Example:&#10;TaskA&#10;TaskB:TaskA&#10;TaskC:TaskB"
                            class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white dark:placeholder-gray-400"></textarea>
                    </div>
                    <div class="flex gap-2">
                        <button type="submit" id="goal-form-submit-btn" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800">
                            Add goal
                        </button>
                        <button type="button" id="goal-form-cancel-btn" class="hidden px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 dark:bg-gray-600 dark:text-gray-300 dark:hover:bg-gray-500">Cancel</button>
                    </div>
                </form>
                <div id="goal-form-message" class="mt-3 min-h-[1.5rem] text-sm"></div>
            </div>
            <div class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
                <h2 class="mb-2 text-lg font-semibold text-gray-900 dark:text-white">Goals</h2>
                <p class="mb-4 text-sm text-gray-500 dark:text-gray-400">Stored in goals.json. TaskScoper runs periodically and converts Pending goals into tasks.</p>
                ${list.length ? '<ul class="divide-y divide-gray-200 dark:divide-gray-700">' + list.map(g => {
                    const desc = (g.description || '').slice(0, 120);
                    return '<li class="py-4 flex flex-wrap items-start justify-between gap-2">' +
                        '<div class="min-w-0 flex-1">' +
                        '<p class="font-medium text-gray-900 dark:text-white">' + esc(g.title || '(no title)') + '</p>' +
                        (desc ? '<p class="mt-1 text-sm text-gray-500 dark:text-gray-400 truncate" title="' + esc(g.description || '') + '">' + esc(desc) + (g.description && g.description.length > 120 ? '…' : '') + '</p>' : '') +
                        '<span class="inline-block mt-2 text-xs font-mono text-gray-400 dark:text-gray-500">' + esc(g.id) + '</span>' +
                        '</div>' +
                        '<span class="text-xs font-medium px-2.5 py-0.5 rounded ' + statusBadgeClass(g.status) + '">' + esc(statusLabel(g.status)) + '</span>' +
                        '<div class="flex flex-wrap gap-1 items-center">' +
                        (canPlay(g) ? '<button type="button" data-status-id="' + esc(g.id) + '" data-status-to="1" class="px-2 py-1 text-xs font-medium text-green-600 dark:text-green-400 hover:bg-green-50 dark:hover:bg-green-900/20 rounded" title="Start or resume">Play</button>' : '') +
                        (canPause(g) ? '<button type="button" data-status-id="' + esc(g.id) + '" data-status-to="2" class="px-2 py-1 text-xs font-medium text-amber-600 dark:text-amber-400 hover:bg-amber-50 dark:hover:bg-amber-900/20 rounded" title="Pause">Pause</button>' : '') +
                        (canStop(g) ? '<button type="button" data-status-id="' + esc(g.id) + '" data-status-to="5" class="px-2 py-1 text-xs font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded" title="Stop">Stop</button>' : '') +
                        (canEdit(g) ? '<button type="button" data-edit-id="' + esc(g.id) + '" class="px-2 py-1 text-xs font-medium text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded">Edit</button>' : '<span class="px-2 py-1 text-xs text-gray-400 dark:text-gray-500" title="Pause or Stop to edit">Edit</span>') +
                        '<button type="button" data-delete-id="' + esc(g.id) + '" class="px-2 py-1 text-xs font-medium text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 rounded">Delete</button>' +
                        '</div>' +
                        '</li>';
                }).join('') + '</ul>' : '<p class="text-gray-500 dark:text-gray-400">No goals yet. Add one above.</p>'}
            </div>
        `;

        const form = document.getElementById('goal-form');
        const msgEl = document.getElementById('goal-form-message');
        const cancelBtn = document.getElementById('goal-form-cancel-btn');
        if (cancelBtn) cancelBtn.addEventListener('click', function() { setFormAddMode(); if (msgEl) msgEl.textContent = ''; });
        if (form && msgEl) {
            form.addEventListener('submit', async function(e) {
                e.preventDefault();
                const title = document.getElementById('goal-title').value.trim();
                const description = document.getElementById('goal-description').value.trim();
                if (!title) { msgEl.textContent = 'Title is required.'; msgEl.className = 'mt-3 text-sm text-red-600 dark:text-red-400'; return; }
                const isEdit = !!editingGoal;
                if (isEdit && statusNum(editingGoal) === 1) { msgEl.textContent = 'Pause or Stop the goal to edit and save.'; msgEl.className = 'mt-3 text-sm text-amber-600 dark:text-amber-400'; return; }
                msgEl.textContent = isEdit ? 'Updating…' : 'Adding…';
                msgEl.className = 'mt-3 text-sm text-gray-600 dark:text-gray-400';
                try {
                    let res;
                    if (isEdit) {
                        const body = { id: editingGoal.id, title: title, description: description, status: editingGoal.status };
                        res = await fetch('/api/goals/' + editingGoal.id, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
                    } else {
                        res = await fetch('/api/goals', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ title: title, description: description }) });
                    }
                    const data = await res.json().catch(() => ({}));
                    if (res.ok) {
                        msgEl.textContent = isEdit ? 'Goal updated. Refreshing…' : 'Goal added. Refreshing…';
                        msgEl.className = 'mt-3 text-sm text-green-600 dark:text-green-400';
                        const goals = await fetch('/api/goals').then(r => r.json());
                        setFormAddMode();
                        render(goals);
                        msgEl.textContent = isEdit ? 'Goal updated.' : 'Goal added.';
                    } else {
                        msgEl.textContent = data.title || data.message || (isEdit ? 'Failed to update goal.' : 'Failed to add goal.');
                        msgEl.className = 'mt-3 text-sm text-red-600 dark:text-red-400';
                    }
                } catch (err) {
                    msgEl.textContent = 'Error: ' + (err.message || 'Request failed');
                    msgEl.className = 'mt-3 text-sm text-red-600 dark:text-red-400';
                }
            });
        }

        el.querySelectorAll('button[data-status-id]').forEach(btn => {
            btn.addEventListener('click', async function() {
                const id = btn.getAttribute('data-status-id');
                const toStatus = parseInt(btn.getAttribute('data-status-to'), 10);
                const goal = goalsList.find(function(g) { return String(g.id) === String(id); });
                if (!goal || isNaN(toStatus)) return;
                const newStatus = toStatus;
                const body = { id: goal.id, title: goal.title || '', description: goal.description || '', status: newStatus };
                try {
                    const res = await fetch('/api/goals/' + id, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
                    if (res.ok) {
                        const goals = await fetch('/api/goals').then(r => r.json());
                        render(goals);
                    }
                } catch (_) {}
            });
        });
        el.querySelectorAll('button[data-edit-id]').forEach(btn => {
            btn.addEventListener('click', function() {
                const id = btn.getAttribute('data-edit-id');
                const goal = goalsList.find(function(g) { return String(g.id) === String(id); });
                if (goal) setFormEditMode(goal);
            });
        });
        el.querySelectorAll('button[data-delete-id]').forEach(btn => {
            btn.addEventListener('click', async function() {
                const id = btn.getAttribute('data-delete-id');
                if (!id || !confirm('Delete this goal?')) return;
                try {
                    const res = await fetch('/api/goals/' + id, { method: 'DELETE' });
                    if (res.ok) {
                        const goals = await fetch('/api/goals').then(r => r.json());
                        render(goals);
                    }
                } catch (_) {}
            });
        });
    }

    fetch('/api/goals')
        .then(r => r.ok ? r.json() : Promise.reject(r))
        .then(goals => render(goals))
        .catch(() => {
            el.innerHTML = '<div class="p-6 bg-red-50 border border-red-200 rounded-lg dark:bg-gray-800 dark:border-red-800"><p class="text-red-700 dark:text-red-400">Failed to load goals.</p></div>';
        });
})();
</script>
}
