@page
@model AgctorSDK.Host.Pages.Dashboard.CodeGraphModel
@{
    ViewData["Title"] = "CodeGraph";
}
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">CodeGraph</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Solution → Project → File → Class → Method actor hierarchy and embedding store summary (when code-graph-demo scenario is active).</p>
</div>

<div id="codegraph-content" class="space-y-6">
    <div class="flex items-center justify-center p-8 rounded-lg bg-gray-100 dark:bg-gray-800">
        <div class="text-center">
            <div role="status">
                <svg class="inline w-8 h-8 text-gray-200 animate-spin dark:text-gray-600 fill-blue-600" viewBox="0 0 100 101" fill="none"><path d="M100 50.5908C100 78.2051 77.6142 100.591 50 100.591C22.3858 100.591 0 78.2051 0 50.5908C0 22.9766 22.3858 0.59082 50 0.59082C77.6142 0.59082 100 22.9766 100 50.5908Z" fill="currentColor"/><path d="M93.9676 39.0409C96.393 38.4038 97.8624 35.9116 97.0079 33.5539C95.2932 28.8227 92.871 24.3692 89.8167 20.348C85.8452 15.1192 80.8826 10.7238 75.2124 7.41289C69.5422 4.10194 63.2754 1.94025 56.7698 1.05124C51.7666 0.367541 46.6976 0.446843 41.7345 1.27873C39.2613 1.69328 37.813 4.19778 38.4501 6.62326C39.0873 9.04874 41.5694 10.4717 44.0505 10.1071C47.8511 9.54855 51.7191 9.52689 55.5402 10.0491C60.8642 10.7766 65.9928 12.5457 70.6331 15.2552C75.2735 17.9648 79.3347 21.5619 82.5849 25.841C84.9175 28.9121 86.7997 32.2913 88.1811 35.8758C89.083 38.2158 91.5421 39.6781 93.9676 39.0409Z" fill="currentFill"/></svg>
                <span class="sr-only">Loading...</span>
            </div>
            <p class="mt-2 text-gray-600 dark:text-gray-400">Loading CodeGraph...</p>
        </div>
    </div>
</div>

<div id="codegraph-panels" class="hidden space-y-6">
    @await Component.InvokeAsync("EmbeddingStore", new
    {
        componentId = "codegraph-embedding-store",
        title = "Embedding store",
        description = "Code vectors stored for semantic search (e.g. by Indexer and Search agents)."
    })

    @await Component.InvokeAsync("AgentChat", new
    {
        componentId = "codegraph-agent-chat",
        title = "Chat with agents"
    })

    @await Component.InvokeAsync("ActorTree", new
    {
        componentId = "codegraph-actor-tree",
        title = "Actor tree",
        description = "Hierarchy: Solution → Project → File → Class → Method. Each node is an actor in the CodeGraph runtime. Refreshes after chat and Index now.",
        emptyMessage = "No actor tree."
    })

    @await Component.InvokeAsync("EmbeddingDebug", new
    {
        componentId = "embedding-debug-details",
        title = "Embedding vectors (debug)",
        description = "Load stored vectors to inspect or visualize (table + 2D scatter using first two dimensions)."
    })

    @await Component.InvokeAsync("RawJson", new
    {
        componentId = "codegraph-raw-json-panel",
        title = "Raw JSON"
    })
</div>

<div class="hidden">
    @await Component.InvokeAsync("TraceTimeline", new
    {
        componentId = "codegraph-trace-timeline",
        title = "Trace timeline",
        emptyMessage = "Send a message to visualize trace activity.",
        heightPx = 360
    })
</div>

<style>
    .codegraph-chat-markdown p {
        margin: 0;
    }

    .codegraph-chat-markdown ol,
    .codegraph-chat-markdown ul {
        margin: 0.25rem 0 0.25rem 1.25rem;
        padding: 0;
    }

    .codegraph-chat-markdown code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        font-size: 0.75rem;
        background: rgba(156, 163, 175, 0.2);
        border-radius: 0.25rem;
        padding: 0.05rem 0.25rem;
    }
</style>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3.1.6/dist/purify.min.js"></script>
@* Page orchestration lives in wwwroot/js/dashboard/codegraph-page.js (PRD-007 Phase 4). *@
<script src="~/js/dashboard/codegraph-page.js" asp-append-version="true"></script>
}
