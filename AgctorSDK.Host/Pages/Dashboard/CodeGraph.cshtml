@page
@model AgctorSDK.Host.Pages.Dashboard.CodeGraphModel
@{
    ViewData["Title"] = "CodeGraph";
}
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">CodeGraph</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Solution → Project → File → Class → Method actor hierarchy and embedding store summary (when code-graph-demo scenario is active).</p>
</div>

<div id="codegraph-content" class="space-y-6">
    <div class="flex items-center justify-center p-8 rounded-lg bg-gray-100 dark:bg-gray-800">
        <div class="text-center">
            <div role="status">
                <svg class="inline w-8 h-8 text-gray-200 animate-spin dark:text-gray-600 fill-blue-600" viewBox="0 0 100 101" fill="none"><path d="M100 50.5908C100 78.2051 77.6142 100.591 50 100.591C22.3858 100.591 0 78.2051 0 50.5908C0 22.9766 22.3858 0.59082 50 0.59082C77.6142 0.59082 100 22.9766 100 50.5908Z" fill="currentColor"/><path d="M93.9676 39.0409C96.393 38.4038 97.8624 35.9116 97.0079 33.5539C95.2932 28.8227 92.871 24.3692 89.8167 20.348C85.8452 15.1192 80.8826 10.7238 75.2124 7.41289C69.5422 4.10194 63.2754 1.94025 56.7698 1.05124C51.7666 0.367541 46.6976 0.446843 41.7345 1.27873C39.2613 1.69328 37.813 4.19778 38.4501 6.62326C39.0873 9.04874 41.5694 10.4717 44.0505 10.1071C47.8511 9.54855 51.7191 9.52689 55.5402 10.0491C60.8642 10.7766 65.9928 12.5457 70.6331 15.2552C75.2735 17.9648 79.3347 21.5619 82.5849 25.841C84.9175 28.9121 86.7997 32.2913 88.1811 35.8758C89.083 38.2158 91.5421 39.6781 93.9676 39.0409Z" fill="currentFill"/></svg>
                <span class="sr-only">Loading...</span>
            </div>
            <p class="mt-2 text-gray-600 dark:text-gray-400">Loading CodeGraph...</p>
        </div>
    </div>
</div>

<div class="hidden">
    @await Component.InvokeAsync("TraceTimeline", new
    {
        componentId = "codegraph-trace-timeline",
        title = "Trace timeline",
        emptyMessage = "Send a message to visualize trace activity.",
        heightPx = 360
    })
</div>

<style>
    .codegraph-file-node {
        display: flex;
        width: 100%;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.75rem;
        border: 1px solid transparent;
        padding: 0.35rem 0.5rem;
        margin: 0;
        background: rgba(59, 130, 246, 0.04);
        cursor: pointer;
        text-align: left;
        border-radius: 0.375rem;
        transition: background-color 120ms ease, border-color 120ms ease;
    }

    .codegraph-file-node,
    .codegraph-file-node * {
        cursor: pointer;
    }

    .codegraph-file-node:hover,
    .codegraph-file-node:focus-visible {
        background: rgba(59, 130, 246, 0.10);
        border-color: rgba(59, 130, 246, 0.30);
    }

    .codegraph-file-node-main {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
        flex: 1 1 auto;
    }

    .codegraph-file-node-name {
        color: rgb(29 78 216);
        font-weight: 600;
    }

    .codegraph-file-node-path {
        color: rgb(107 114 128);
        font-size: 0.75rem;
        line-height: 1.25rem;
        word-break: break-all;
    }

    .codegraph-file-node-action {
        color: rgb(29 78 216);
        font-size: 0.75rem;
        font-weight: 600;
        white-space: nowrap;
        padding-top: 0.1rem;
    }

    .dark .codegraph-file-node-name,
    .dark .codegraph-file-node-action {
        color: rgb(147 197 253);
    }

    .dark .codegraph-file-node-path {
        color: rgb(156 163 175);
    }
</style>

@section Scripts {
<script>
(function() {
    const el = document.getElementById('codegraph-content');
    function esc(s) { const d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; }

    function typeBadgeClass(type) {
        const t = (type || '').toLowerCase();
        if (t.includes('solution')) return 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-300';
        if (t.includes('project')) return 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300';
        if (t.includes('file')) return 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300';
        if (t.includes('class')) return 'bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-300';
        if (t.includes('method')) return 'bg-cyan-100 text-cyan-800 dark:bg-cyan-900 dark:text-cyan-300';
        return 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300';
    }

    function renderActorNode(node, depth) {
        if (!node) return '';
        const indent = depth * 16;
        const type = node.actorType || node.ActorType || '';
        const name = node.name || node.Name || '(unnamed)';
        const path = node.physicalPath || node.PhysicalPath || '';
        const id = node.id || node.Id || '';
        const children = node.children || node.Children || [];
        const hasChildren = Array.isArray(children) && children.length > 0;
        const badgeClass = typeBadgeClass(type);
        const nodeId = 'node-' + (id || Math.random().toString(36).slice(2)).replace(/[^a-z0-9]/gi, '-');
        const isFile = type.toLowerCase().includes('file') && !!path;
        let html = '<div class="border-l-2 border-gray-200 dark:border-gray-600 ml-2 pl-3 py-1" style="margin-left: ' + indent + 'px">';
        html += '<div class="flex items-start gap-2 flex-wrap">';
        html += '<span class="text-xs font-medium px-2 py-0.5 rounded ' + badgeClass + '">' + esc(type) + '</span>';
        if (isFile) {
            html += '<button type="button" data-role="file-node" data-path="' + esc(path) + '" class="codegraph-file-node">';
            html += '<span class="codegraph-file-node-main">';
            html += '<span class="codegraph-file-node-name">' + esc(name) + '</span>';
            html += '<span class="codegraph-file-node-path" title="' + esc(path) + '">' + esc(path) + '</span>';
            html += '</span>';
            html += '<span class="codegraph-file-node-action">Preview</span>';
            html += '</button>';
        } else {
            html += '<span class="font-medium text-gray-900 dark:text-white">' + esc(name) + '</span>';
            if (path) html += '<span class="text-sm text-gray-500 dark:text-gray-400 truncate" title="' + esc(path) + '">' + esc(path) + '</span>';
        }
        html += '</div>';
        if (hasChildren) {
            html += '<div class="mt-1 space-y-0" id="' + esc(nodeId) + '-children">';
            for (let i = 0; i < children.length; i++)
                html += renderActorNode(children[i], depth + 1);
            html += '</div>';
        }
        html += '</div>';
        return html;
    }

    function renderActorTree(actorTree) {
        if (!actorTree) return '<p class="text-gray-500 dark:text-gray-400">No actor tree.</p>';
        return '<div class="space-y-0 text-sm">' + renderActorNode(actorTree, 0) + '</div>';
    }

    function renderFilePreviewModal() {
        return '<div id="codegraph-file-modal" class="fixed inset-0 z-50 items-center justify-center bg-gray-900/60 p-4" style="display:none;" aria-hidden="true">' +
            '<div class="w-full max-w-5xl rounded-lg bg-white shadow-xl dark:bg-gray-800">' +
            '<div class="flex items-center justify-between border-b border-gray-200 px-4 py-3 dark:border-gray-700">' +
            '<div>' +
            '<h3 id="codegraph-file-modal-title" class="text-lg font-semibold text-gray-900 dark:text-white">File preview</h3>' +
            '<p id="codegraph-file-modal-path" class="text-xs text-gray-500 dark:text-gray-400"></p>' +
            '</div>' +
            '<button type="button" id="codegraph-file-modal-close" class="rounded px-3 py-1.5 text-sm font-medium text-gray-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-700">Close</button>' +
            '</div>' +
            '<div class="p-4">' +
            '<p id="codegraph-file-modal-status" class="mb-3 text-sm text-gray-500 dark:text-gray-400">Select a file to preview.</p>' +
            '<pre id="codegraph-file-modal-content" class="max-h-[70vh] overflow-auto rounded bg-gray-100 p-4 text-xs text-gray-800 dark:bg-gray-900 dark:text-gray-100"></pre>' +
            '</div>' +
            '</div>' +
            '</div>';
    }

    function closeFileModal() {
        const modal = document.getElementById('codegraph-file-modal');
        if (!modal) return;
        modal.style.display = 'none';
        modal.setAttribute('aria-hidden', 'true');
    }

    function setFileModalState(statusText, contentText, path, title) {
        const status = document.getElementById('codegraph-file-modal-status');
        const content = document.getElementById('codegraph-file-modal-content');
        const pathEl = document.getElementById('codegraph-file-modal-path');
        const titleEl = document.getElementById('codegraph-file-modal-title');
        if (status) status.textContent = statusText || '';
        if (content) content.textContent = contentText || '';
        if (pathEl) pathEl.textContent = path || '';
        if (titleEl) titleEl.textContent = title || 'File preview';
    }

    async function openFilePreview(path) {
        const modal = document.getElementById('codegraph-file-modal');
        if (!modal || !path) return;
        setFileModalState('Loading file content...', '', path, 'File preview');
        modal.style.display = 'flex';
        modal.setAttribute('aria-hidden', 'false');
        try {
            const response = await fetch('/api/CodeGraph/file-content?path=' + encodeURIComponent(path));
            if (!response.ok) {
                setFileModalState('Unable to load file content.', 'The selected file could not be loaded from the active actor tree.', path, 'File preview');
                return;
            }
            const data = await response.json();
            setFileModalState('Showing file content.', data.content || '', data.path || path, data.fileName || 'File preview');
        } catch (_) {
            setFileModalState('Unable to load file content.', 'The selected file could not be loaded from the active actor tree.', path, 'File preview');
        }
    }

    function setLoadVectorsButtonState(button, vectorCount) {
        if (!button) return;
        const count = Number(vectorCount || 0);
        const hasVectors = count > 0;
        button.dataset.vectorCount = String(count);
        button.disabled = !hasVectors;
        button.title = hasVectors ? 'Load stored embedding vectors' : 'No vectors in the embedding store yet';
        button.className = hasVectors
            ? 'px-3 py-1.5 text-sm font-medium text-white bg-gray-600 rounded hover:bg-gray-700 dark:bg-gray-600 dark:hover:bg-gray-700'
            : 'px-3 py-1.5 text-sm font-medium text-white bg-gray-400 rounded cursor-not-allowed dark:bg-gray-500';
    }

    fetch('/api/CodeGraph/current')
        .then(r => { if (r.status === 404) return null; return r.ok ? r.json() : Promise.reject(r); })
        .then(ctx => {
            if (!ctx) {
                el.innerHTML = '<div class="p-6 bg-amber-50 border border-amber-200 rounded-lg dark:bg-gray-800 dark:border-amber-800">' +
                    '<h2 class="text-lg font-semibold text-amber-900 dark:text-amber-200">CodeGraph not active</h2>' +
                    '<p class="mt-2 text-amber-800 dark:text-amber-200">Run the <strong>code-graph-demo</strong> scenario to create the actor model and embedding store.</p>' +
                    '<p class="mt-2 text-sm text-amber-700 dark:text-amber-300">Go to the <a href="/Dashboard/Agents" class="underline font-medium hover:no-underline">Agents</a> page, select &quot;code-graph-demo&quot; and click <strong>Apply</strong>.</p>' +
                    '</div>';
                return;
            }
            let html = '';
            const summary = ctx.embeddingStoreSummary;
            const vectorCount = summary && (summary.vectorCount !== undefined) ? summary.vectorCount : 0;
            const embeddingState = summary && summary.state ? summary.state : 'NotReady';
            const graphVersion = summary && summary.graphVersion !== undefined ? summary.graphVersion : 0;
            const indexedGraphVersion = summary && summary.indexedGraphVersion !== undefined ? summary.indexedGraphVersion : 0;
            const lastIndexedAt = summary && summary.lastIndexedAt ? summary.lastIndexedAt : '';
            const lastError = summary && summary.lastError ? summary.lastError : '';
            const loadVectorsBtnClass = vectorCount > 0
                ? 'px-3 py-1.5 text-sm font-medium text-white bg-gray-600 rounded hover:bg-gray-700 dark:bg-gray-600 dark:hover:bg-gray-700'
                : 'px-3 py-1.5 text-sm font-medium text-white bg-gray-400 rounded cursor-not-allowed dark:bg-gray-500';
            html += '<div class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">' +
                '<h2 class="mb-2 text-lg font-semibold text-gray-900 dark:text-white">Embedding store</h2>' +
                '<p class="mb-1 text-sm text-gray-500 dark:text-gray-400">Code vectors stored for semantic search (e.g. by Indexer and Search agents).</p>' +
                '<div class="flex flex-wrap items-center gap-3">' +
                '<p class="text-gray-900 dark:text-white">Vector count: <span id="codegraph-vector-count" class="font-semibold text-lg">' + esc(String(vectorCount)) + '</span></p>' +
                '<p class="text-gray-900 dark:text-white">State: <span id="codegraph-embedding-state" class="font-medium">' + esc(String(embeddingState)) + '</span></p>' +
                '<button type="button" id="index-now-btn" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800">Index now</button>' +
                '<span id="index-message" class="text-sm min-w-[8rem]"></span>' +
                '</div>' +
                '<p class="mt-2 text-xs text-gray-500 dark:text-gray-400">Graph version: <span id="codegraph-graph-version">' + esc(String(graphVersion)) + '</span> | Indexed version: <span id="codegraph-indexed-graph-version">' + esc(String(indexedGraphVersion)) + '</span></p>' +
                (lastIndexedAt ? '<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Last indexed: <span id="codegraph-last-indexed-at">' + esc(String(lastIndexedAt)) + '</span></p>' : '<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Last indexed: <span id="codegraph-last-indexed-at">Not yet indexed</span></p>') +
                (lastError ? '<p class="mt-1 text-xs text-red-600 dark:text-red-400" id="codegraph-embedding-error">Last error: ' + esc(String(lastError)) + '</p>' : '<p class="mt-1 text-xs text-gray-500 dark:text-gray-400" id="codegraph-embedding-error"></p>') +
                '<p class="mt-2 text-xs text-gray-500 dark:text-gray-400">Click &quot;Index now&quot; to ask the embedding coordinator to refresh semantic-search embeddings.</p>' +
                '</div>';
            const tree = ctx.actorTree;
            html += '<div class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">' +
                '<h2 class="mb-2 text-lg font-semibold text-gray-900 dark:text-white">Chat with agents</h2>' +
                '<p id="codegraph-chat-help" class="mb-3 text-sm text-gray-500 dark:text-gray-400">query-agent answers questions about indexed code. Use coder-agent to write or edit code, and refactor-agent for refactors. Click Index now before asking code questions.</p>' +
                '<div class="flex flex-wrap gap-2 mb-3">' +
                '<label for="codegraph-chat-agent" class="sr-only">Agent</label>' +
                '<select id="codegraph-chat-agent" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg p-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white">' +
                '<option value="query-agent">query-agent (Q&amp;A, code questions)</option>' +
                '<option value="coder-agent">coder-agent (write/edit code)</option>' +
                '<option value="refactor-agent">refactor-agent (refactor)</option>' +
                '</select>' +
                '<textarea id="codegraph-chat-input" rows="2" placeholder="e.g. Where is Square defined?" class="flex-1 min-w-[200px] bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white dark:placeholder-gray-400"></textarea>' +
                '<button type="button" id="codegraph-chat-send" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 dark:bg-blue-600 dark:hover:bg-blue-700">Send</button>' +
                '</div>' +
                '<div id="codegraph-chat-messages" class="mt-2 p-3 rounded-lg bg-gray-50 dark:bg-gray-700/50 max-h-64 overflow-y-auto text-sm space-y-2"></div>' +
                '<div id="codegraph-trace-host" class="mt-4"></div>' +
                '</div>' +
                '<div class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">' +
                '<h2 class="mb-2 text-lg font-semibold text-gray-900 dark:text-white">Actor tree</h2>' +
                '<p class="mb-4 text-sm text-gray-500 dark:text-gray-400">Hierarchy: Solution → Project → File → Class → Method. Each node is an actor in the CodeGraph runtime. Refreshes after chat and Index now.</p>' +
                '<div id="codegraph-actor-tree-container" class="overflow-x-auto">' + renderActorTree(tree) + '</div>' +
                '</div>';
            html += '<details class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700" id="embedding-debug-details">' +
                '<summary class="cursor-pointer text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300">Embedding vectors (debug)</summary>' +
                '<div id="embedding-debug-content" class="mt-3">' +
                '<p class="text-sm text-gray-500 dark:text-gray-400 mb-2">Load stored vectors to inspect or visualize (table + 2D scatter using first two dimensions).</p>' +
                '<button type="button" id="load-vectors-btn" class="' + loadVectorsBtnClass + '"' + (vectorCount > 0 ? '' : ' disabled title="No vectors in the embedding store yet"') + '>Load vectors</button>' +
                '<div id="embedding-debug-result" class="mt-3"></div>' +
                '</div></details>';
            html += '<details class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">' +
                '<summary class="cursor-pointer text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300">Raw JSON</summary>' +
                '<pre class="mt-3 p-4 text-xs bg-gray-100 dark:bg-gray-700 rounded overflow-x-auto max-h-96 overflow-y-auto">' + esc(JSON.stringify(ctx, null, 2)) + '</pre>' +
                '</details>';
            html += renderFilePreviewModal();
            el.innerHTML = html || '<div class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700"><p class="text-gray-500 dark:text-gray-400">No context data.</p></div>';
            const traceHost = document.getElementById('codegraph-trace-host');
            const traceTimeline = document.getElementById('codegraph-trace-timeline');
            if (traceHost && traceTimeline) {
                traceHost.appendChild(traceTimeline);
                if (window.agctorTraceTimeline) {
                    window.agctorTraceTimeline.clear('codegraph-trace-timeline');
                }
            }
            const indexBtn = document.getElementById('index-now-btn');
            const indexMsg = document.getElementById('index-message');
            if (indexBtn && indexMsg) {
                indexBtn.addEventListener('click', async function() {
                    indexBtn.disabled = true;
                    indexMsg.textContent = 'Indexing...';
                    indexMsg.className = 'text-sm text-gray-600 dark:text-gray-400';
                    try {
                        const res = await fetch('/api/agents/embedding-coordinator-agent/message', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ payload: 'index' })
                        });
                        const data = await res.json().catch(() => ({}));
                        if (res.ok) {
                            indexMsg.textContent = 'Done. Refreshing...';
                            indexMsg.className = 'text-sm text-green-600 dark:text-green-400';
                            const updated = await fetch('/api/CodeGraph/current').then(r => r.ok ? r.json() : null);
                            const countEl = document.getElementById('codegraph-vector-count');
                            const stateEl = document.getElementById('codegraph-embedding-state');
                            const graphVersionEl = document.getElementById('codegraph-graph-version');
                            const indexedVersionEl = document.getElementById('codegraph-indexed-graph-version');
                            const lastIndexedEl = document.getElementById('codegraph-last-indexed-at');
                            const errorEl = document.getElementById('codegraph-embedding-error');
                            const updatedCount = updated && updated.embeddingStoreSummary ? (updated.embeddingStoreSummary.vectorCount ?? 0) : 0;
                            if (countEl) countEl.textContent = String(updatedCount);
                            if (stateEl && updated && updated.embeddingStoreSummary) stateEl.textContent = String(updated.embeddingStoreSummary.state ?? 'Unknown');
                            if (graphVersionEl && updated && updated.embeddingStoreSummary) graphVersionEl.textContent = String(updated.embeddingStoreSummary.graphVersion ?? 0);
                            if (indexedVersionEl && updated && updated.embeddingStoreSummary) indexedVersionEl.textContent = String(updated.embeddingStoreSummary.indexedGraphVersion ?? 0);
                            if (lastIndexedEl && updated && updated.embeddingStoreSummary) lastIndexedEl.textContent = String(updated.embeddingStoreSummary.lastIndexedAt ?? 'Not yet indexed');
                            if (errorEl && updated && updated.embeddingStoreSummary) errorEl.textContent = updated.embeddingStoreSummary.lastError ? ('Last error: ' + updated.embeddingStoreSummary.lastError) : '';
                            setLoadVectorsButtonState(document.getElementById('load-vectors-btn'), updatedCount);
                            indexMsg.textContent = 'Indexing complete.';
                        } else {
                            indexMsg.textContent = data.message || 'Indexing failed.';
                            indexMsg.className = 'text-sm text-red-600 dark:text-red-400';
                        }
                    } catch (e) {
                        indexMsg.textContent = 'Error: ' + (e.message || 'Request failed');
                        indexMsg.className = 'text-sm text-red-600 dark:text-red-400';
                    }
                    indexBtn.disabled = false;
                });
            }
            const loadVectorsBtn = document.getElementById('load-vectors-btn');
            const debugResult = document.getElementById('embedding-debug-result');
            setLoadVectorsButtonState(loadVectorsBtn, vectorCount);
            if (loadVectorsBtn && debugResult) {
                loadVectorsBtn.addEventListener('click', async function() {
                    if (loadVectorsBtn.disabled) return;
                    loadVectorsBtn.disabled = true;
                    loadVectorsBtn.textContent = 'Loading...';
                    try {
                        const r = await fetch('/api/CodeGraph/embeddings');
                        if (!r.ok) { debugResult.innerHTML = '<p class="text-sm text-red-600">No embeddings or CodeGraph not active.</p>'; return; }
                        const records = await r.json();
                        if (!records || records.length === 0) {
                            debugResult.innerHTML = '<p class="text-sm text-gray-500">No vectors in store. Click &quot;Index now&quot; first.</p>';
                            return;
                        }
                        const previewLen = 8;
                        let tableHtml = '<div class="overflow-x-auto max-h-64 overflow-y-auto"><table class="text-sm w-full border border-gray-200 dark:border-gray-600"><thead><tr class="bg-gray-100 dark:bg-gray-700"><th class="text-left p-2">Actor ID</th><th class="text-left p-2">Text</th><th class="text-left p-2">Dims</th><th class="text-left p-2">First ' + previewLen + ' values</th></tr></thead><tbody>';
                        records.forEach(rec => {
                            const vec = rec.vector || [];
                            const preview = vec.slice(0, previewLen).map(v => Number(v).toFixed(3)).join(', ');
                            tableHtml += '<tr class="border-t border-gray-200 dark:border-gray-600"><td class="p-2 font-mono text-xs">' + esc(rec.actorId) + '</td><td class="p-2">' + esc(rec.text) + '</td><td class="p-2">' + vec.length + '</td><td class="p-2 font-mono text-xs text-gray-600 dark:text-gray-400">' + esc(preview) + (vec.length > previewLen ? '...' : '') + '</td></tr>';
                        });
                        tableHtml += '</tbody></table></div>';
                        const d0 = records.map(r => (r.vector && r.vector[0]) != null ? Number(r.vector[0]) : 0);
                        const d1 = records.map(r => (r.vector && r.vector[1]) != null ? Number(r.vector[1]) : 0);
                        const min0 = Math.min(...d0), max0 = Math.max(...d0), min1 = Math.min(...d1), max1 = Math.max(...d1);
                        const range0 = max0 - min0 || 1, range1 = max1 - min1 || 1;
                        const w = 400, h = 300, pad = 30;
                        let svg = '<p class="text-xs text-gray-500 dark:text-gray-400 mt-2">2D preview: first dimension (x) vs second dimension (y). For full PCA/t-SNE use external tools (e.g. TensorBoard, Python).</p>';
                        svg += '<svg width="' + w + '" height="' + h + '" class="border border-gray-200 dark:border-gray-600 rounded mt-1" viewBox="0 0 ' + w + ' ' + h + '">';
                        records.forEach((rec, i) => {
                            const x = pad + (d0[i] - min0) / range0 * (w - 2 * pad);
                            const y = h - pad - (d1[i] - min1) / range1 * (h - 2 * pad);
                            svg += '<circle cx="' + x + '" cy="' + y + '" r="4" fill="#3b82f6" opacity="0.8"/><title>' + esc(rec.text) + '</title>';
                        });
                        svg += '</svg>';
                        debugResult.innerHTML = tableHtml + svg;
                    } catch (e) {
                        debugResult.innerHTML = '<p class="text-sm text-red-600">Error: ' + esc(e.message || 'Request failed') + '</p>';
                    }
                    loadVectorsBtn.textContent = 'Load vectors';
                    setLoadVectorsButtonState(loadVectorsBtn, loadVectorsBtn.dataset.vectorCount || 0);
                });
            }
            const chatSend = document.getElementById('codegraph-chat-send');
            const chatInput = document.getElementById('codegraph-chat-input');
            const chatAgent = document.getElementById('codegraph-chat-agent');
            const chatHelp = document.getElementById('codegraph-chat-help');
            const chatMessages = document.getElementById('codegraph-chat-messages');
            const fileModal = document.getElementById('codegraph-file-modal');
            const fileModalClose = document.getElementById('codegraph-file-modal-close');
            if (chatSend && chatInput && chatAgent && chatHelp && chatMessages) {
                function syncChatAgentUi() {
                    const agentId = chatAgent.value;
                    if (agentId === 'query-agent') {
                        chatHelp.textContent = 'query-agent answers questions about indexed code. Use coder-agent to write or edit code, and refactor-agent for refactors. Click Index now before asking code questions.';
                        chatInput.placeholder = 'e.g. Where is Square defined?';
                        return;
                    }

                    if (agentId === 'coder-agent') {
                        chatHelp.textContent = 'coder-agent is for creating or editing code in the demo workspace.';
                        chatInput.placeholder = 'e.g. Create a new file named Geometry.cs with a Triangle class';
                        return;
                    }

                    chatHelp.textContent = 'refactor-agent is for code cleanups and structural changes to existing code.';
                    chatInput.placeholder = 'e.g. Refactor Calculator to extract division validation';
                }

                syncChatAgentUi();
                chatAgent.addEventListener('change', syncChatAgentUi);
                chatSend.addEventListener('click', async function() {
                    const prompt = chatInput.value.trim();
                    if (!prompt) return;
                    const agentId = chatAgent.value;
                    chatSend.disabled = true;
                    chatMessages.innerHTML += '<div class="text-gray-600 dark:text-gray-300"><strong>You</strong>: ' + esc(prompt) + '</div>';
                    chatInput.value = '';
                    if (window.agctorTraceTimeline) {
                        window.agctorTraceTimeline.clear('codegraph-trace-timeline');
                    }
                    try {
                        const res = await fetch('/api/agents/' + encodeURIComponent(agentId) + '/message', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ payload: prompt })
                        });
                        const data = await res.json().catch(function() { return {}; });
                        const reply = res.ok && data.responseData != null ? (typeof data.responseData === 'string' ? data.responseData : JSON.stringify(data.responseData)) : (data.errorMessage || 'No response.');
                        const status = res.ok ? 'text-green-700 dark:text-green-300' : 'text-red-600 dark:text-red-400';
                        chatMessages.innerHTML += '<div class="' + status + '"><strong>' + esc(agentId) + '</strong>: ' + esc(reply) + '</div>';
                        chatMessages.scrollTop = chatMessages.scrollHeight;
                        var updated = await fetch('/api/CodeGraph/current').then(function(r) { return r.ok ? r.json() : null; });
                        if (updated) {
                            var treeEl = document.getElementById('codegraph-actor-tree-container');
                            var countEl = document.getElementById('codegraph-vector-count');
                            var stateEl = document.getElementById('codegraph-embedding-state');
                            var graphVersionEl = document.getElementById('codegraph-graph-version');
                            var indexedVersionEl = document.getElementById('codegraph-indexed-graph-version');
                            var lastIndexedEl = document.getElementById('codegraph-last-indexed-at');
                            var errorEl = document.getElementById('codegraph-embedding-error');
                            var updatedCount = updated.embeddingStoreSummary != null ? (updated.embeddingStoreSummary.vectorCount ?? 0) : 0;
                            if (treeEl && updated.actorTree) treeEl.innerHTML = renderActorTree(updated.actorTree);
                            if (countEl) countEl.textContent = String(updatedCount);
                            if (stateEl && updated.embeddingStoreSummary) stateEl.textContent = String(updated.embeddingStoreSummary.state ?? 'Unknown');
                            if (graphVersionEl && updated.embeddingStoreSummary) graphVersionEl.textContent = String(updated.embeddingStoreSummary.graphVersion ?? 0);
                            if (indexedVersionEl && updated.embeddingStoreSummary) indexedVersionEl.textContent = String(updated.embeddingStoreSummary.indexedGraphVersion ?? 0);
                            if (lastIndexedEl && updated.embeddingStoreSummary) lastIndexedEl.textContent = String(updated.embeddingStoreSummary.lastIndexedAt ?? 'Not yet indexed');
                            if (errorEl && updated.embeddingStoreSummary) errorEl.textContent = updated.embeddingStoreSummary.lastError ? ('Last error: ' + updated.embeddingStoreSummary.lastError) : '';
                            setLoadVectorsButtonState(document.getElementById('load-vectors-btn'), updatedCount);
                        }
                        var traceId = data.traceId || data.TraceId;
                        if (traceId && window.agctorTraceTimeline) {
                            window.agctorTraceTimeline.load('codegraph-trace-timeline', traceId);
                        }
                    } catch (e) {
                        chatMessages.innerHTML += '<div class="text-red-600 dark:text-red-400"><strong>Error</strong>: ' + esc(e.message || 'Request failed') + '</div>';
                        chatMessages.scrollTop = chatMessages.scrollHeight;
                    }
                    chatSend.disabled = false;
                });
            }
            if (fileModal && fileModalClose) {
                fileModalClose.addEventListener('click', closeFileModal);
                fileModal.addEventListener('click', function(e) {
                    if (e.target === fileModal) closeFileModal();
                });
            }
            document.querySelectorAll('[data-role="file-node"]').forEach(function(button) {
                button.addEventListener('click', function() {
                    openFilePreview(button.getAttribute('data-path') || '');
                });
            });
        })
        .catch(() => {
            el.innerHTML = '<div class="p-6 bg-red-50 border border-red-200 rounded-lg dark:bg-gray-800 dark:border-red-800"><p class="text-red-700 dark:text-red-400">Failed to load CodeGraph context.</p></div>';
        });
})();
</script>
}
