@page
@model AgctorSDK.Host.Pages.Dashboard.AgentsModel
@{
    ViewData["Title"] = "Agents";
}
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Agents</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Registered agent types (from configuration) and active agent instances (created in this session, e.g. after applying a scenario).</p>
</div>

<div id="agents-content" class="space-y-6">
    <div class="flex items-center justify-center p-8 rounded-lg bg-gray-100 dark:bg-gray-800">
        <div class="text-center">
            <div role="status">
                <svg class="inline w-8 h-8 text-gray-200 animate-spin dark:text-gray-600 fill-blue-600" viewBox="0 0 100 101" fill="none"><path d="M100 50.5908C100 78.2051 77.6142 100.591 50 100.591C22.3858 100.591 0 78.2051 0 50.5908C0 22.9766 22.3858 0.59082 50 0.59082C77.6142 0.59082 100 22.9766 100 50.5908Z" fill="currentColor"/><path d="M93.9676 39.0409C96.393 38.4038 97.8624 35.9116 97.0079 33.5539C95.2932 28.8227 92.871 24.3692 89.8167 20.348C85.8452 15.1192 80.8826 10.7238 75.2124 7.41289C69.5422 4.10194 63.2754 1.94025 56.7698 1.05124C51.7666 0.367541 46.6976 0.446843 41.7345 1.27873C39.2613 1.69328 37.813 4.19778 38.4501 6.62326C39.0873 9.04874 41.5694 10.4717 44.0505 10.1071C47.8511 9.54855 51.7191 9.52689 55.5402 10.0491C60.8642 10.7766 65.9928 12.5457 70.6331 15.2552C75.2735 17.9648 79.3347 21.5619 82.5849 25.841C84.9175 28.9121 86.7997 32.2913 88.1811 35.8758C89.083 38.2158 91.5421 39.6781 93.9676 39.0409Z" fill="currentFill"/></svg>
                <span class="sr-only">Loading...</span>
            </div>
            <p class="mt-2 text-gray-600 dark:text-gray-400">Loading agents...</p>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function() {
    const el = document.getElementById('agents-content');
    let configData = null;
    let agentsData = [];
    let currentScenario = null;
    let lastLoadedAt = null;
    const backendErrors = new Map();
    let refreshTimer = null;
    let selectedScenarioName = '';

    function esc(s) { const d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML; }

    function setBackendError(key, message) {
        if (!message) {
            backendErrors.delete(key);
            return;
        }
        backendErrors.set(key, message);
    }

    function clearBackendError(key) {
        backendErrors.delete(key);
    }

    function renderBackendErrors() {
        const errors = Array.from(backendErrors.entries());
        if (errors.length === 0) return '';
        return '<div class="p-4 mb-4 rounded-lg bg-red-50 border border-red-200 dark:bg-red-900/20 dark:border-red-800">' +
            '<p class="text-sm font-medium text-red-800 dark:text-red-200">Backend issues</p>' +
            '<ul class="mt-2 space-y-1 text-sm text-red-700 dark:text-red-300">' +
            errors.map(([key, msg]) => '<li><strong>' + esc(key) + ':</strong> ' + esc(msg) + '</li>').join('') +
            '</ul>' +
            '</div>';
    }

    function refreshMetaText(list) {
        const count = Array.isArray(list) ? list.length : 0;
        const loaded = lastLoadedAt
            ? new Date(lastLoadedAt).toLocaleTimeString()
            : 'Not loaded yet';
        return 'Showing ' + count + ' active agent(s). Last refreshed at ' + esc(loaded) + '.';
    }

    function scenarioOptions(config) {
        const scenarios = config.scenarios || {};
        const keys = Object.keys(scenarios);
        if (keys.length === 0) return '<option value="">No scenarios</option>';
        return '<option value="">Select a scenario...</option>' + keys.map(name =>
            '<option value="' + esc(name) + '">' + esc(name) + (scenarios[name] ? ' — ' + esc(scenarios[name]) : '') + '</option>'
        ).join('');
    }

    function render(config, agents, current) {
        const list = Array.isArray(agents) ? agents : [];
        const types = config.agentTypes ? Object.keys(config.agentTypes) : [];
        const errorBlock = renderBackendErrors();
        const effectiveSelectedScenario = selectedScenarioName || (current && current.scenarioName) || '';
        const currentBlock = current
            ? '<div class="p-4 mb-4 rounded-lg bg-amber-50 border border-amber-200 dark:bg-amber-900/20 dark:border-amber-800"><p class="text-sm font-medium text-amber-800 dark:text-amber-200">Current scenario</p><p class="mt-1 font-semibold text-amber-900 dark:text-white">' + esc(current.scenarioName) + '</p>' + (current.description ? '<p class="mt-1 text-sm text-amber-700 dark:text-amber-300">' + esc(current.description) + '</p>' : '') + '</div>'
            : '<div class="p-4 mb-4 rounded-lg bg-gray-50 border border-gray-200 dark:bg-gray-800 dark:border-gray-700"><p class="text-sm text-gray-500 dark:text-gray-400">No scenario active for this session. Select a scenario below and click Apply to create and register its agents.</p></div>';
        el.innerHTML = errorBlock + currentBlock + `
            <div class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
                <h2 class="mb-4 text-lg font-semibold text-gray-900 dark:text-white">Activate scenario</h2>
                <p class="mb-3 text-sm text-gray-500 dark:text-gray-400">Select a scenario and click Apply to create and register its agents in this session.</p>
                <div class="flex flex-wrap items-end gap-3">
                    <div class="min-w-[200px]">
                        <label for="scenario-select" class="block mb-1 text-sm font-medium text-gray-700 dark:text-gray-300">Scenario</label>
                        <select id="scenario-select" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                            ${scenarioOptions(config)}
                        </select>
                    </div>
                    <button type="button" data-apply-scenario class="px-4 py-2.5 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800">
                        Apply
                    </button>
                    <button type="button" data-refresh-agents class="px-4 py-2.5 text-sm font-medium text-gray-900 bg-gray-100 rounded-lg hover:bg-gray-200 focus:ring-4 focus:ring-gray-200 dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600 dark:focus:ring-gray-700">
                        Refresh
                    </button>
                </div>
                <div id="scenario-message" class="mt-3 min-h-[1.5rem] text-sm"></div>
            </div>
            <div class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
                <h2 class="mb-2 text-lg font-semibold text-gray-900 dark:text-white">Registered types</h2>
                <p class="mb-3 text-sm text-gray-500 dark:text-gray-400">Agent types available in configuration (from appsettings). These can be instantiated when you apply a scenario.</p>
                <div class="flex flex-wrap gap-2">${types.map(t => '<span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300">' + esc(t) + '</span>').join('')}</div>
            </div>
            <div class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
                <h2 class="mb-2 text-lg font-semibold text-gray-900 dark:text-white">Active agents</h2>
                <p class="mb-1 text-sm text-gray-500 dark:text-gray-400">Agent instances created in this session (e.g. after applying a scenario above). Click an agent to view type-specific details.</p>
                <p class="mb-3 text-xs text-gray-500 dark:text-gray-400">${refreshMetaText(list)}</p>
                ${list.length ? '<ul class="divide-y divide-gray-200 dark:divide-gray-700">' + list.map(a => '<li class="py-3"><a href="/Dashboard/AgentDetail/' + encodeURIComponent(a.id) + '" class="font-medium text-blue-600 dark:text-blue-500 hover:underline">' + esc(a.id) + '</a><span class="text-gray-500 dark:text-gray-400 text-sm ml-2">' + esc(a.type) + '</span></li>').join('') + '</ul>' : '<p class="text-gray-500 dark:text-gray-400">No agents. Select a scenario above and click Apply to activate agents.</p>'}
            </div>
        `;

        const select = document.getElementById('scenario-select');
        if (select) {
            select.value = effectiveSelectedScenario;
            selectedScenarioName = select.value || '';
        }
    }

    function showScenarioMessage(msg, isError) {
        const msgEl = document.getElementById('scenario-message');
        if (!msgEl) return;
        msgEl.textContent = msg;
        msgEl.className = 'mt-3 min-h-[1.5rem] text-sm ' + (isError ? 'text-red-600 dark:text-red-400' : 'text-green-600 dark:text-green-400');
    }

    async function fetchJson(url, errorKey, fallbackValue) {
        try {
            const res = await fetch(url);
            const data = await res.json().catch(() => null);
            if (!res.ok) {
                const msg = (data && (data.message || data.errorMessage || data.title)) || ('Request failed with status ' + res.status);
                setBackendError(errorKey, msg);
                return fallbackValue;
            }
            clearBackendError(errorKey);
            return data;
        } catch (e) {
            setBackendError(errorKey, e.message || 'Request failed');
            return fallbackValue;
        }
    }

    async function refreshRuntimeData(showInlineError) {
        const [agents, current] = await Promise.all([
            fetchJson('/api/agents', 'agents-api', agentsData),
            fetchJson('/api/Test/current-scenario', 'current-scenario-api', currentScenario)
        ]);

        agentsData = Array.isArray(agents) ? agents : [];
        currentScenario = current;
        lastLoadedAt = Date.now();

        if (configData) {
            render(configData, agentsData, currentScenario);
        }

        if (showInlineError && backendErrors.size > 0) {
            showScenarioMessage('One or more backend issues were detected. See the red panel above.', true);
        }
    }

    async function applyScenario() {
        const select = document.getElementById('scenario-select');
        if (!select || !select.value) {
            showScenarioMessage('Please select a scenario.', true);
            return;
        }
        const scenarioName = select.value;
        selectedScenarioName = scenarioName;
        showScenarioMessage('Applying...', false);
        try {
            const res = await fetch('/api/Test/setup-scenario', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ scenarioName: scenarioName, parameters: {} })
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok || data.success === false) {
                const msg = data.errorMessage || data.message || 'Failed to apply scenario.';
                setBackendError('scenario-apply', msg);
                await refreshRuntimeData(false);
                showScenarioMessage(msg, true);
                return;
            }
            clearBackendError('scenario-apply');
            const count = data.createdAgentIds ? data.createdAgentIds.length : 0;
            const successMsg = 'Scenario applied. ' + count + ' agent(s) created.';
            await refreshRuntimeData(false);
            showScenarioMessage(successMsg, false);
        } catch (e) {
            const msg = 'Error: ' + (e.message || 'Request failed.');
            setBackendError('scenario-apply', msg);
            await refreshRuntimeData(false);
            showScenarioMessage(msg, true);
        }
    }

    el.addEventListener('click', function(e) {
        if (e.target.matches('button[data-apply-scenario]')) applyScenario();
        if (e.target.matches('button[data-refresh-agents]')) refreshRuntimeData(true);
    });

    el.addEventListener('change', function(e) {
        if (e.target.matches('#scenario-select')) {
            selectedScenarioName = e.target.value || '';
        }
    });

    fetchJson('/api/Config', 'config-api', null)
        .then(async config => {
            if (!config) {
                el.innerHTML = '<div class="p-6 bg-red-50 border border-red-200 rounded-lg dark:bg-gray-800 dark:border-red-800"><p class="text-red-700 dark:text-red-400">Failed to load configuration. See the backend issues panel when available.</p></div>';
                return;
            }

            configData = config;
            selectedScenarioName = (currentScenario && currentScenario.scenarioName) || selectedScenarioName;
            await refreshRuntimeData(false);

            if (refreshTimer) window.clearInterval(refreshTimer);
            refreshTimer = window.setInterval(function() {
                refreshRuntimeData(false);
            }, 5000);
        })
        .catch(() => {
            el.innerHTML = '<div class="p-6 bg-red-50 border border-red-200 rounded-lg dark:bg-gray-800 dark:border-red-800"><p class="text-red-700 dark:text-red-400">Failed to load agents.</p></div>';
        });
})();
</script>
}
