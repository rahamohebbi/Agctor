@page
@model AgctorSDK.Host.Pages.Dashboard.AgentsModel
@{
    ViewData["Title"] = "Agents";
}
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Agents</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Unified runtime agents + agent definitions. Toggle C# runtime types, inspect project-memory YAML definitions (non-runtime specs), and apply a scenario for this session (default startup scenario remains configured in <code class="text-xs bg-gray-100 dark:bg-gray-800 px-1 rounded">Agctor:Dashboard:ScenarioName</code>).</p>
</div>

<div class="mb-6 p-4 rounded-lg bg-slate-50 border border-slate-200 dark:bg-slate-800/40 dark:border-slate-600" role="note">
    <p class="text-sm text-slate-800 dark:text-slate-200">
        <span class="font-medium">Full YAML studio</span> (all fields, templates, playground deep links):
        <a href="/Dashboard/ProjectMemory/Agents" class="text-blue-600 font-medium hover:underline dark:text-blue-400">Project memory → Agents (advanced)</a>.
    </p>
</div>

<div id="agents-content" class="space-y-6">
    <div class="flex items-center justify-center p-8 rounded-lg bg-gray-100 dark:bg-gray-800">
        <div class="text-center">
            <div role="status">
                <svg class="inline w-8 h-8 text-gray-200 animate-spin dark:text-gray-600 fill-blue-600" viewBox="0 0 100 101" fill="none"><path d="M100 50.5908C100 78.2051 77.6142 100.591 50 100.591C22.3858 100.591 0 78.2051 0 50.5908C0 22.9766 22.3858 0.59082 50 0.59082C77.6142 0.59082 100 22.9766 100 50.5908Z" fill="currentColor"/><path d="M93.9676 39.0409C96.393 38.4038 97.8624 35.9116 97.0079 33.5539C95.2932 28.8227 92.871 24.3692 89.8167 20.348C85.8452 15.1192 80.8826 10.7238 75.2124 7.41289C69.5422 4.10194 63.2754 1.94025 56.7698 1.05124C51.7666 0.367541 46.6976 0.446843 41.7345 1.27873C39.2613 1.69328 37.813 4.19778 38.4501 6.62326C39.0873 9.04874 41.5694 10.4717 44.0505 10.1071C47.8511 9.54855 51.7191 9.52689 55.5402 10.0491C60.8642 10.7766 65.9928 12.5457 70.6331 15.2552C75.2735 17.9648 79.3347 21.5619 82.5849 25.841C84.9175 28.9121 86.7997 32.2913 88.1811 35.8758C89.083 38.2158 91.5421 39.6781 93.9676 39.0409Z" fill="currentFill"/></svg>
                <span class="sr-only">Loading...</span>
            </div>
            <p class="mt-2 text-gray-600 dark:text-gray-400">Loading agents...</p>
        </div>
    </div>
</div>

@* Drawer host lives outside #agents-content so table re-render does not remove it (PRD-013 Phase 2). *@
<div id="agents-pm-drawer-host" class="hidden fixed inset-0 z-50 flex justify-end" aria-hidden="true">
    <button type="button" class="flex-1 min-w-0 bg-gray-900/50 border-0 cursor-default p-0" data-agents-drawer-backdrop aria-label="Close panel"></button>
    <div id="agents-pm-drawer-panel" class="w-full max-w-lg bg-white dark:bg-gray-900 h-full shadow-xl border-l border-gray-200 dark:border-gray-700 overflow-y-auto"></div>
</div>

@section Scripts {
    <script src="~/js/dashboard/agents-page.js" asp-append-version="true"></script>
}
