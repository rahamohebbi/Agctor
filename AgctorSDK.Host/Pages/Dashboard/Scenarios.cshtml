@page "/Dashboard/Scenarios"
@model AgctorSDK.Host.Pages.Dashboard.ScenariosModel
@{
    ViewData["Title"] = "Scenarios";
}
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Scenario catalog</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Choose and configure how a chat session behaves: which programs start, which AI profiles are used, and how messages flow. Saving here updates your config file; use <strong class="font-medium text-gray-700 dark:text-gray-200">Apply</strong> to load a scenario into the current session.</p>
</div>

<div class="mb-4 grid gap-3 md:grid-cols-3">
    <div class="p-3 rounded-lg border border-gray-200 bg-white dark:bg-gray-800 dark:border-gray-700">
        <p class="text-xs text-gray-500 dark:text-gray-400">Configured default</p>
        <p id="sc-chip-default" class="mt-1 text-sm font-semibold text-gray-900 dark:text-white">—</p>
    </div>
    <div class="p-3 rounded-lg border border-gray-200 bg-white dark:bg-gray-800 dark:border-gray-700">
        <p class="text-xs text-gray-500 dark:text-gray-400">Current session</p>
        <p id="sc-chip-current" class="mt-1 text-sm font-semibold text-gray-900 dark:text-white">—</p>
    </div>
    <div class="p-3 rounded-lg border border-gray-200 bg-white dark:bg-gray-800 dark:border-gray-700">
        <p class="text-xs text-gray-500 dark:text-gray-400">Editor state</p>
        <p id="sc-chip-dirty" class="mt-1 text-sm font-semibold text-gray-900 dark:text-white">No local edits</p>
    </div>
</div>

<div id="scenarios-root" class="grid gap-4 lg:grid-cols-3">
    <div class="p-4 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
            <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Scenarios</h2>
            <div class="flex flex-wrap gap-1.5">
                <button type="button" id="scenarios-refresh" class="px-3 py-1.5 text-xs font-medium text-blue-700 bg-blue-50 rounded-lg hover:bg-blue-100 dark:bg-blue-900/30 dark:text-blue-200">Refresh</button>
                <button type="button" id="sc-new-scenario" class="px-3 py-1.5 text-xs font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700">New</button>
                <button type="button" id="sc-delete-scenario" class="px-3 py-1.5 text-xs font-medium text-red-700 bg-red-50 rounded-lg hover:bg-red-100 dark:bg-red-900/30 dark:text-red-200">Delete</button>
            </div>
        </div>
        <p id="sc-list-status" class="mb-2 min-h-[1rem] text-xs text-gray-600 dark:text-gray-400" aria-live="polite"></p>
        <div id="scenarios-list" class="space-y-2 text-sm"></div>
    </div>

    <div class="space-y-4 lg:col-span-2">
        <div class="p-4 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
            <h2 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">Run scenario now</h2>
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">Loads this scenario into your current chat session and starts the agents listed below.</p>
            <div class="flex flex-wrap items-center gap-2">
                <button type="button" id="sc-apply" class="px-4 py-2.5 text-sm font-medium text-white bg-emerald-600 rounded-lg hover:bg-emerald-700">Apply to current session</button>
                <a href="/Dashboard/Agents" class="px-4 py-2.5 text-sm font-medium text-gray-800 bg-gray-100 rounded-lg hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-100 dark:hover:bg-gray-600">Open Agents</a>
                <span id="sc-apply-status" class="text-xs text-gray-500 dark:text-gray-400"></span>
            </div>
        </div>

        <div class="p-4 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
            <h2 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">Scenario catalog editor (configuration)</h2>
            <div id="scenarios-empty" class="text-xs text-gray-500 dark:text-gray-400">Select a scenario to edit.</div>
            <div id="scenarios-editor" class="hidden space-y-3">
                <div class="grid gap-3 md:grid-cols-2">
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Internal id</label>
                        <input id="sc-id" disabled class="w-full rounded-lg border border-gray-300 bg-gray-100 p-2.5 text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                        <p class="mt-1 text-[11px] text-gray-500 dark:text-gray-400">Stable name used in config files. You cannot rename it here after creation.</p>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Scenario type</label>
                        <input id="sc-kind" disabled class="w-full rounded-lg border border-gray-300 bg-gray-100 p-2.5 text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                        <p id="sc-kind-help" class="mt-1 text-[11px] leading-snug text-gray-600 dark:text-gray-300" aria-live="polite"></p>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Display name</label>
                    <input id="sc-display-name" class="w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                    <p class="mt-1 text-[11px] text-gray-500 dark:text-gray-400">Friendly title shown in this list and elsewhere in the dashboard.</p>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Description</label>
                    <textarea id="sc-description" rows="2" class="w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white"></textarea>
                    <p class="mt-1 text-[11px] text-gray-500 dark:text-gray-400">Short summary of what this scenario is for (for your reference, not sent to the AI).</p>
                </div>
                <div id="sc-handler-section" class="hidden space-y-2">
                    <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Built-in setup program</label>
                    <p class="text-[11px] leading-snug text-gray-500 dark:text-gray-400">Demo scenarios ship with a fixed program that wires agents together automatically. You do not edit this field.</p>
                    <div id="sc-handler-help" class="rounded-md border border-amber-200 bg-amber-50 px-2.5 py-2 text-[11px] leading-snug text-amber-950 dark:border-amber-900/50 dark:bg-amber-900/20 dark:text-amber-100" aria-live="polite"></div>
                    <input id="sc-handler" disabled class="w-full rounded-lg border border-gray-300 bg-gray-100 p-2.5 text-sm font-mono dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                </div>
                <div id="sc-declarative-hint" class="hidden rounded-md border border-blue-200 bg-blue-50 px-2.5 py-2 text-[11px] leading-snug text-blue-900 dark:border-blue-900/50 dark:bg-blue-900/20 dark:text-blue-200">
                    <strong class="font-medium">You configure this scenario.</strong> Choose which agents start when you apply it, attach memory personas below, and use the visual flow designer to define how chat steps run. No built-in setup program is used.
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Agents to start when applied</label>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mb-2">Live workers for your chat session (for example, something that coordinates messages or remembers context). Persona definitions (how the AI thinks and what it remembers) are added in the section below and on the <a href="/Dashboard/Agents" class="underline hover:no-underline">Agents</a> page.</p>
                    <div id="sc-agent-chips" class="min-h-[2.5rem] flex flex-wrap gap-2 rounded-lg border border-gray-300 bg-gray-50 p-2.5 dark:bg-gray-700 dark:border-gray-600"></div>
                    <div class="mt-2 flex flex-wrap items-center gap-2">
                        <input id="sc-agent-add" list="sc-agent-suggestions" placeholder="Search or type an agent name…" class="min-w-[18rem] flex-1 rounded-lg border border-gray-300 bg-white p-2.5 text-sm dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                        <datalist id="sc-agent-suggestions"></datalist>
                        <button type="button" id="sc-agent-add-btn" class="px-3 py-2 text-sm font-medium text-gray-800 bg-gray-100 rounded-lg hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-100 dark:hover:bg-gray-600">Add</button>
                        <button type="button" id="sc-agent-clear-btn" class="px-3 py-2 text-sm font-medium text-red-700 bg-red-50 rounded-lg hover:bg-red-100 dark:bg-red-900/30 dark:text-red-200">Clear all</button>
                    </div>
                    <div id="sc-agent-validation" class="mt-2 text-xs space-y-1"></div>
                    <div id="sc-agent-preview" class="mt-2 text-xs text-gray-600 dark:text-gray-300"></div>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">AI memory &amp; behavior profiles</label>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mb-2">Attach profiles that tell the AI how to extract facts, organize memory, and answer questions (for example <code>person-extractor</code>, <code>memory-curator</code>, <code>person-query</code>).</p>
                    <div class="mb-2 rounded-md border border-blue-200 bg-blue-50 px-2.5 py-2 text-xs text-blue-900 dark:border-blue-900/50 dark:bg-blue-900/20 dark:text-blue-200">
                        These profiles are instructions and settings, not separate running programs. They are used when your flow runs an AI step. Edit the full definition on the <a href="/Dashboard/Agents" class="underline hover:no-underline">Agents</a> page.
                    </div>
                    <div id="sc-persona-chips" class="min-h-[2.5rem] flex flex-wrap gap-2 rounded-lg border border-gray-300 bg-gray-50 p-2.5 dark:bg-gray-700 dark:border-gray-600"></div>
                    <div class="mt-2 flex flex-wrap items-center gap-2">
                        <input id="sc-persona-add" list="sc-persona-suggestions" placeholder="Type persona id..." class="min-w-[18rem] flex-1 rounded-lg border border-gray-300 bg-white p-2.5 text-sm dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                        <datalist id="sc-persona-suggestions"></datalist>
                        <button type="button" id="sc-persona-add-btn" class="px-3 py-2 text-sm font-medium text-gray-800 bg-gray-100 rounded-lg hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-100 dark:hover:bg-gray-600">Add</button>
                        <button type="button" id="sc-persona-clear-btn" class="px-3 py-2 text-sm font-medium text-red-700 bg-red-50 rounded-lg hover:bg-red-100 dark:bg-red-900/30 dark:text-red-200">Clear all</button>
                        <button type="button" id="sc-persona-defaults-btn" class="px-3 py-2 text-sm font-medium text-blue-700 bg-blue-50 rounded-lg hover:bg-blue-100 dark:bg-blue-900/30 dark:text-blue-200">Attach people defaults</button>
                    </div>
                    <div id="sc-persona-validation" class="mt-2 text-xs space-y-1"></div>
                    <div id="sc-persona-preview" class="mt-2 text-xs text-gray-600 dark:text-gray-300"></div>
                </div>
                <div>
                    <p class="mb-2 text-[11px] leading-snug text-gray-500 dark:text-gray-400">Optional shortcuts: pick which profile plays each role when the system needs to extract facts, organize memory, or answer questions. Leave blank if you only use the flow designer.</p>
                    <div class="grid gap-3 md:grid-cols-3">
                        <div>
                            <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Fact extraction profile (optional)</label>
                            <input id="sc-bind-extractor" list="sc-persona-suggestions" placeholder="person-extractor" class="w-full rounded-lg border border-gray-300 bg-white p-2.5 text-sm dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Memory organization profile (optional)</label>
                            <input id="sc-bind-curator" list="sc-persona-suggestions" placeholder="memory-curator" class="w-full rounded-lg border border-gray-300 bg-white p-2.5 text-sm dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Question answering profile (optional)</label>
                            <input id="sc-bind-query" list="sc-persona-suggestions" placeholder="person-query" class="w-full rounded-lg border border-gray-300 bg-white p-2.5 text-sm dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
                        </div>
                    </div>
                </div>
                <details class="rounded-lg border border-gray-200 dark:border-gray-700 p-2">
                    <summary class="cursor-pointer text-xs font-medium text-gray-700 dark:text-gray-300">Advanced: edit raw agent type lines</summary>
                    <textarea id="sc-agent-types" rows="6" class="mt-2 w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm font-mono dark:bg-gray-700 dark:border-gray-600 dark:text-white"></textarea>
                </details>
                <div class="rounded-lg border border-indigo-200 bg-indigo-50/80 p-3 dark:border-indigo-800 dark:bg-indigo-900/20">
                    <p class="text-xs font-medium text-indigo-900 dark:text-indigo-100">Conversation flow</p>
                    <p class="mt-1 text-[11px] text-indigo-800 dark:text-indigo-200">Design the path each message takes (chat in → AI steps → reply out). This is where you connect routers and AI profiles for custom scenarios.</p>
                    <button type="button" id="sc-open-flow" class="mt-2 px-3 py-2 text-xs font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700">Open visual designer</button>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" id="sc-save" class="px-4 py-2.5 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700">Save catalog changes</button>
                    <button type="button" id="sc-discard" class="px-4 py-2.5 text-sm font-medium text-gray-800 bg-gray-100 rounded-lg hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-100 dark:hover:bg-gray-600">Discard edits</button>
                    <button type="button" id="sc-reload" class="px-4 py-2.5 text-sm font-medium text-gray-800 bg-gray-100 rounded-lg hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-100 dark:hover:bg-gray-600">Reload from disk</button>
                    <span id="sc-status" class="text-xs text-gray-500 dark:text-gray-400"></span>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="sc-new-modal" class="hidden fixed inset-0 z-50 overflow-y-auto" aria-modal="true" role="dialog" aria-labelledby="sc-new-title">
    <div class="flex min-h-full items-center justify-center p-4">
        <div class="fixed inset-0 bg-gray-900/60" data-sc-new-backdrop></div>
        <div class="relative w-full max-w-md rounded-xl border border-gray-200 bg-white p-4 shadow-xl dark:border-gray-700 dark:bg-gray-900">
            <h2 id="sc-new-title" class="text-base font-semibold text-gray-900 dark:text-white">New scenario</h2>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Creates a declarative entry in the user catalog (<code class="text-[10px]">agctor-scenarios.user.json</code>).</p>
            <div class="mt-3 space-y-3">
                <div>
                    <label for="sc-new-id" class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Id</label>
                    <input id="sc-new-id" type="text" autocomplete="off" placeholder="my-scenario" class="w-full rounded-lg border border-gray-300 bg-white p-2.5 text-sm dark:border-gray-600 dark:bg-gray-800 dark:text-white" />
                    <p class="mt-1 text-[10px] text-gray-500 dark:text-gray-400">Letters, digits, hyphen, underscore, or dot (1–120 chars).</p>
                </div>
                <div>
                    <label for="sc-new-display" class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Display name</label>
                    <input id="sc-new-display" type="text" autocomplete="off" placeholder="Optional — defaults to id" class="w-full rounded-lg border border-gray-300 bg-white p-2.5 text-sm dark:border-gray-600 dark:bg-gray-800 dark:text-white" />
                </div>
                <p id="sc-new-error" class="hidden text-xs text-red-600 dark:text-red-400" role="alert"></p>
            </div>
            <div class="mt-4 flex flex-wrap justify-end gap-2">
                <button type="button" class="rounded-lg border border-gray-300 px-3 py-2 text-xs font-medium dark:border-gray-600" data-sc-new-cancel>Cancel</button>
                <button type="button" id="sc-new-submit" class="rounded-lg bg-indigo-600 px-3 py-2 text-xs font-medium text-white hover:bg-indigo-700">Create</button>
            </div>
        </div>
    </div>
</div>

<div id="sc-flow-modal" class="hidden fixed inset-0 z-50 overflow-y-auto" aria-modal="true" role="dialog" aria-labelledby="sc-flow-title">
    <div class="flex min-h-full items-center justify-center p-3 sm:p-4">
        <div class="fixed inset-0 bg-gray-900/60" data-sc-flow-backdrop></div>
        <div id="sc-flow-panel" class="relative flex w-[min(94vw,1680px)] max-w-[98vw] min-w-[36rem] max-h-[94vh] min-h-[32rem] flex-col overflow-hidden rounded-xl border border-gray-200 bg-white shadow-xl dark:border-gray-700 dark:bg-gray-900 resize" style="height: 82vh;">
            <div class="flex shrink-0 items-start justify-between border-b border-gray-200 px-4 py-3 dark:border-gray-700">
                <div>
                    <h2 id="sc-flow-title" class="text-base font-semibold text-gray-900 dark:text-white">Scenario flow designer</h2>
                    <p class="text-xs text-gray-500 dark:text-gray-400">Canonical GraphDocument — flows execute server-side (<code class="text-[10px]">POST /api/scenarios/{id}/flow/run</code> or coordinator chat when applied); <strong class="text-gray-700 dark:text-gray-300">parallel</strong> edges must join one <strong class="text-gray-700 dark:text-gray-300">Merge</strong>. <strong class="text-gray-700 dark:text-gray-300">Router</strong> can use <code class="text-[10px]">routerMode: llm</code> (Ollama picks LlmNode targets). <strong class="text-gray-700 dark:text-gray-300">LlmNode</strong> uses project-memory YAML + Ollama. Drag the corner grip to resize.</p>
                </div>
                <button type="button" class="rounded-lg px-2 py-1 text-sm text-gray-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800" data-sc-flow-close aria-label="Close">✕</button>
            </div>
            <div class="flex min-h-0 flex-1 flex-col gap-3 p-4 md:flex-row md:items-stretch">
                <div class="flex w-full shrink-0 flex-col md:w-72 min-h-0 md:max-w-[min(22rem,42vw)]">
                    <div class="flex min-h-0 max-h-[min(58vh,720px)] flex-1 flex-col overflow-y-auto rounded-lg border border-gray-200 bg-white/70 p-2 shadow-sm dark:border-gray-600 dark:bg-gray-900/50">
                        <p class="text-xs font-medium text-gray-700 dark:text-gray-300">Add node</p>
                        <div class="flex flex-col gap-1.5">
                            @* group-hover shows copy below the chip; survives moving the pointer onto the text (same group). Native title remains for accessibility. *@
                            <div class="group">
                                <button type="button" title="Branches flow after ChatInput. Rule-based routing matches outgoing edges; LLM mode (routerMode: llm) lets Ollama choose LlmNode targets." class="w-full rounded border border-gray-300 px-2 py-1.5 text-left text-xs hover:bg-gray-50 dark:border-gray-600 dark:hover:bg-gray-800" data-flow-add="Router">Router</button>
                                <div role="tooltip" class="mt-1 hidden rounded-md border border-gray-200 bg-gray-50 px-2 py-1.5 text-[10px] leading-snug text-gray-700 shadow-sm group-hover:block dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200">
                                    Branches flow after <strong class="font-medium text-gray-900 dark:text-gray-100">ChatInput</strong>. <strong class="font-medium">Rule-based:</strong> each outgoing edge has a condition so one branch runs. <strong class="font-medium">LLM mode</strong> (<code class="text-[9px]">routerMode: llm</code>): Ollama picks which <strong class="font-medium">LlmNode</strong> persona(s) run next from labeled branches.
                                </div>
                            </div>
                            <div class="group">
                                <button type="button" title="One LLM step: persona YAML + Ollama; set config.personaId from the scenario roster." class="w-full rounded border border-gray-300 px-2 py-1.5 text-left text-xs hover:bg-gray-50 dark:border-gray-600 dark:hover:bg-gray-800" data-flow-add="LlmNode">LlmNode</button>
                                <div role="tooltip" class="mt-1 hidden rounded-md border border-gray-200 bg-gray-50 px-2 py-1.5 text-[10px] leading-snug text-gray-700 shadow-sm group-hover:block dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200">
                                    One local <strong class="font-medium text-gray-900 dark:text-gray-100">LLM</strong> turn per node: that persona’s project-memory <strong class="font-medium">YAML</strong> (tools, paths, tone) plus Ollama. Set <code class="text-[9px]">config.personaId</code> from this scenario’s roster; optional extra catalog tools in the inspector.
                                </div>
                            </div>
                            <div class="group">
                                <button type="button" title="Join parallel branches before Output; required when multiple paths run together." class="w-full rounded border border-gray-300 px-2 py-1.5 text-left text-xs hover:bg-gray-50 dark:border-gray-600 dark:hover:bg-gray-800" data-flow-add="Merge">Merge</button>
                                <div role="tooltip" class="mt-1 hidden rounded-md border border-gray-200 bg-gray-50 px-2 py-1.5 text-[10px] leading-snug text-gray-700 shadow-sm group-hover:block dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200">
                                    Joins <strong class="font-medium text-gray-900 dark:text-gray-100">parallel</strong> branches before <strong class="font-medium">Output</strong>. When several paths run at once they must meet here so results combine cleanly. Omit only when the router fans out to a single branch (no true parallelism).
                                </div>
                            </div>
                        </div>
                        <button type="button" id="sc-flow-connect" title="Direction follows node types (ChatInput → Router → LlmNode → Merge → Output) when both are known; otherwise first selected → second." class="mt-2 w-full rounded-lg border border-gray-300 px-2 py-1.5 text-xs font-medium hover:bg-gray-50 dark:border-gray-600 dark:hover:bg-gray-800">Connect 2 selected</button>
                        <button type="button" id="sc-flow-delete-edges" class="mt-1.5 w-full rounded-lg border border-red-200 bg-red-50 px-2 py-1.5 text-xs font-medium text-red-900 hover:bg-red-100 dark:border-red-900 dark:bg-red-950/50 dark:text-red-100 dark:hover:bg-red-950">Delete selected edge(s)</button>
                        <details class="mt-2 rounded border border-gray-200 bg-gray-50/90 p-1.5 dark:border-gray-600 dark:bg-gray-800/60">
                            <summary class="cursor-pointer select-none text-[10px] font-medium text-gray-700 dark:text-gray-300">Canvas shortcuts</summary>
                            <p class="mt-1.5 text-[10px] leading-relaxed text-gray-600 dark:text-gray-400">Nodes: click or shift+drag box-select; selected nodes show a <strong class="text-amber-600">yellow ring</strong>. <strong class="text-gray-800 dark:text-gray-200">Connect 2 selected</strong> picks arrow direction from types. Edges: click to select (gold). <strong class="text-gray-800 dark:text-gray-200">Delete</strong> / <strong class="text-gray-800 dark:text-gray-200">Backspace</strong> removes selected edges. <strong class="text-gray-800 dark:text-gray-200">Alt+drag</strong> from a selected edge onto a node rewires the nearest end.</p>
                        </details>
                        <div id="sc-flow-edge-panel" class="hidden mt-3 rounded border border-amber-200 bg-amber-50/80 p-2 dark:border-amber-800 dark:bg-amber-950/40">
                            <p class="text-[10px] font-semibold text-amber-900 dark:text-amber-200">Selected edge</p>
                            <p id="sc-flow-edge-meta" class="mt-1 font-mono text-[9px] text-gray-600 dark:text-gray-400"></p>
                            <p id="sc-flow-edge-router-context" class="mt-1 hidden text-[9px] leading-snug text-amber-900/90 dark:text-amber-200/90"></p>
                            <div id="sc-flow-edge-det-block" class="mt-2">
                                <p class="text-[10px] font-medium text-gray-800 dark:text-gray-200">Deterministic branch (when source Router uses rule-based mode)</p>
                                <label class="mt-1 block text-[10px] text-gray-600 dark:text-gray-400" for="sc-flow-edge-condition">Match this outgoing arrow when the user message…</label>
                                <input type="text" id="sc-flow-edge-condition" class="mt-0.5 w-full rounded border border-gray-300 bg-white px-1 py-1 text-[11px] dark:border-gray-600 dark:bg-gray-900" placeholder="e.g. Raha, error:, ticket (empty = default / catch-all branch)" />
                                <label class="mt-1.5 block text-[10px] text-gray-600 dark:text-gray-400" for="sc-flow-edge-match">…matches using</label>
                                <select id="sc-flow-edge-match" class="mt-0.5 w-full rounded border border-gray-300 bg-white px-1 py-1 text-[11px] dark:border-gray-600 dark:bg-gray-900">
                                    <option value="contains">Contains this text (case-insensitive substring)</option>
                                    <option value="equals">Equals entire message (trimmed, case-insensitive)</option>
                                    <option value="startsWith">Starts with this text</option>
                                    <option value="endsWith">Ends with this text</option>
                                    <option value="regex">Matches this .NET-style regular expression</option>
                                </select>
                                <p class="mt-1 text-[9px] text-gray-600 dark:text-gray-400">Leave condition empty on <strong>one</strong> arrow only — that is the fallback if no other branch matches.</p>
                            </div>
                            <div id="sc-flow-edge-llm-block" class="mt-2 hidden border-t border-amber-200/80 pt-2 dark:border-amber-800/60">
                                <p class="text-[10px] font-medium text-gray-800 dark:text-gray-200">LLM branch hint (when source Router uses LLM mode)</p>
                                <label class="mt-1 block text-[10px] text-gray-600 dark:text-gray-400" for="sc-flow-edge-llm-hint">Tell the router model when to choose this persona branch</label>
                                <textarea id="sc-flow-edge-llm-hint" rows="3" class="mt-0.5 w-full resize-y rounded border border-gray-300 bg-white px-1 py-1 text-[11px] dark:border-gray-600 dark:bg-gray-900" placeholder="Example: Use when the user asks who someone is, biographical questions, or &quot;what do we know about X&quot; people queries."></textarea>
                            </div>
                        </div>
                        <div id="sc-flow-router-panel" class="hidden mt-3 rounded border border-violet-200 bg-violet-50/80 p-2 dark:border-violet-800 dark:bg-violet-950/40">
                            <p class="text-[10px] font-semibold text-violet-900 dark:text-violet-200">Router (selected)</p>
                            <label class="mt-1 block text-[10px] font-medium text-gray-700 dark:text-gray-300" for="sc-flow-router-mode">How this router picks the next step</label>
                            <p class="mt-0.5 text-[9px] leading-snug text-gray-600 dark:text-gray-400"><strong>Deterministic</strong> = no extra LLM call; the server matches your message against each outgoing arrow’s condition. <strong>LLM</strong> = one Ollama call reads branch hints + persona summaries and returns target persona(s).</p>
                            <select id="sc-flow-router-mode" class="mt-1 w-full rounded border border-gray-300 bg-white px-1 py-1 text-[11px] dark:border-gray-600 dark:bg-gray-900">
                                <option value="deterministic">Deterministic — keyword / pattern on each edge</option>
                                <option value="llm">LLM (Ollama) — natural-language hints on each edge</option>
                            </select>
                            <div id="sc-flow-router-deterministic" class="mt-2 rounded border border-violet-200/70 bg-white/60 p-2 dark:border-violet-800/50 dark:bg-gray-950/30">
                                <p class="text-[10px] font-semibold text-violet-900 dark:text-violet-200">Rule-based setup</p>
                                <p class="mt-1 text-[9px] leading-relaxed text-gray-700 dark:text-gray-300">Select each <strong>arrow leaving this router</strong> on the canvas. In the edge panel, set a condition and match style, or leave one arrow as the default (empty condition).</p>
                                <p class="mt-1.5 text-[9px] font-medium text-gray-700 dark:text-gray-300">Outgoing sequential edges (preview)</p>
                                <ul id="sc-flow-router-det-edge-preview" class="mt-0.5 max-h-28 list-inside list-disc overflow-y-auto text-[9px] text-gray-600 dark:text-gray-400"></ul>
                            </div>
                            <div id="sc-flow-router-llm-options" class="mt-2 hidden space-y-2 rounded border border-violet-200/70 bg-white/60 p-2 dark:border-violet-800/50 dark:bg-gray-950/30">
                                <p class="text-[10px] font-semibold text-violet-900 dark:text-violet-200">LLM router setup</p>
                                <label class="mt-0.5 block text-[10px] text-gray-600 dark:text-gray-400" for="sc-flow-router-llm-instr">Global policy for this router (optional)</label>
                                <p class="text-[9px] text-gray-500 dark:text-gray-500">Appended to the routing prompt after per-branch hints — use for priorities, exclusions, or tone.</p>
                                <textarea id="sc-flow-router-llm-instr" rows="3" class="mt-0.5 w-full resize-y rounded border border-gray-300 bg-white px-1 py-1 text-[11px] dark:border-gray-600 dark:bg-gray-900" placeholder="e.g. Prefer person-query for any who-is question; never route billing text to extraction."></textarea>
                                <label class="mt-1.5 block text-[10px] font-medium text-gray-700 dark:text-gray-300" for="sc-flow-router-target-policy">How many branches may run per message</label>
                                <p class="text-[9px] text-gray-500 dark:text-gray-500"><strong>Single best match</strong> — one Ollama pick (highest confidence + routing hint). <strong>All matching</strong> — every branch the model marks applicable runs (needs a shared Merge when multiple LlmNodes).</p>
                                <select id="sc-flow-router-target-policy" class="mt-0.5 w-full rounded border border-gray-300 bg-white px-1 py-1 text-[11px] dark:border-gray-600 dark:bg-gray-900">
                                    <option value="single_best">Single best match — one persona only</option>
                                    <option value="all_matching">All matching personas — multiple branches</option>
                                </select>
                                <div id="sc-flow-router-branch-exec-wrap" class="mt-1.5">
                                    <label class="block text-[10px] font-medium text-gray-700 dark:text-gray-300" for="sc-flow-router-branch-exec">How multiple branches run (all-matching only)</label>
                                    <p class="text-[9px] text-gray-500 dark:text-gray-500"><strong>Parallel</strong> — branches start together. <strong>Sequential</strong> — extract/save paths finish before query/read paths. <strong>Auto</strong> — routing LLM picks parallel vs sequential (heuristic fallback when omitted).</p>
                                    <select id="sc-flow-router-branch-exec" class="mt-0.5 w-full rounded border border-gray-300 bg-white px-1 py-1 text-[11px] dark:border-gray-600 dark:bg-gray-900">
                                        <option value="parallel">Parallel — run branches at the same time</option>
                                        <option value="sequential">Sequential — one branch after another</option>
                                        <option value="auto">Auto — LLM decides per message</option>
                                    </select>
                                </div>
                                <label class="mt-1.5 block text-[10px] text-gray-600 dark:text-gray-400" for="sc-flow-router-max">Max persona branches (optional, all-matching only)</label>
                                <p class="text-[9px] text-gray-500 dark:text-gray-500">Caps how many targets run when using <em>all matching</em>. Ignored for single best. Leave empty for no cap.</p>
                                <input type="number" id="sc-flow-router-max" min="1" class="mt-0.5 w-full rounded border border-gray-300 bg-white px-1 py-1 text-[11px] dark:border-gray-600 dark:bg-gray-900" placeholder="empty = no cap" />
                                <label class="mt-1.5 block text-[10px] text-gray-600 dark:text-gray-400" for="sc-flow-router-minconf">Minimum confidence (0–1, optional)</label>
                                <p class="text-[9px] text-gray-500 dark:text-gray-500">Targets below this threshold are dropped before execution.</p>
                                <input type="text" id="sc-flow-router-minconf" class="mt-0.5 w-full rounded border border-gray-300 bg-white px-1 py-1 text-[11px] dark:border-gray-600 dark:bg-gray-900" placeholder="e.g. 0.5" />
                                <label class="mt-1.5 block text-[10px] text-gray-600 dark:text-gray-400" for="sc-flow-router-fallback">Fallback persona id (optional)</label>
                                <p class="text-[9px] text-gray-500 dark:text-gray-500">Must match one of the LlmNode <code class="text-[9px]">personaId</code> values on arrows below; used when the model returns no targets.</p>
                                <input type="text" id="sc-flow-router-fallback" class="mt-0.5 w-full rounded border border-gray-300 bg-white px-1 py-1 text-[11px] dark:border-gray-600 dark:bg-gray-900" />
                                <p class="mt-2 text-[10px] font-medium text-gray-800 dark:text-gray-200">Branches the LLM may choose (sequential → LlmNode)</p>
                                <p class="text-[9px] text-gray-600 dark:text-gray-400">Each row is one candidate. Add per-arrow guidance in the edge panel (LLM branch hint) after selecting that arrow.</p>
                                <ul id="sc-flow-router-candidates" class="mt-0.5 max-h-24 list-inside list-disc overflow-y-auto text-[10px] text-gray-600 dark:text-gray-400"></ul>
                                <p class="text-[9px] text-gray-500 dark:text-gray-500">“Simulate order” does not run Ollama; only a real flow run calls the LLM router.</p>
                            </div>
                        </div>
                        <div id="sc-flow-persona-panel" class="hidden mt-3 rounded border border-sky-200 bg-sky-50/80 p-2 dark:border-sky-800 dark:bg-sky-950/40">
                            <p class="text-[10px] font-semibold text-sky-900 dark:text-sky-200">Agent step (LlmNode)</p>
                            <label class="mt-1 block text-[10px] text-gray-600 dark:text-gray-400" for="sc-flow-persona-select">Persona</label>
                            <select id="sc-flow-persona-select" class="mt-0.5 w-full rounded border border-gray-300 bg-white px-1 py-1 text-[11px] dark:border-gray-600 dark:bg-gray-900"></select>
                            <p id="sc-flow-persona-roster-hint" class="mt-1 hidden text-[10px] text-amber-700 dark:text-amber-300">Add YAML personas to this scenario on the main form, then pick one here.</p>
                            <p id="sc-flow-persona-invalid-hint" class="mt-1 hidden text-[10px] text-red-600 dark:text-red-400"></p>
                            <div id="sc-flow-agent-tools-section" class="mt-2 hidden rounded-lg border border-emerald-200/80 bg-white/90 p-2 dark:border-emerald-800/60 dark:bg-gray-950/40">
                                <div class="flex items-center justify-between gap-2">
                                    <p class="text-[10px] font-semibold text-emerald-900 dark:text-emerald-200">Tools</p>
                                    <a id="sc-flow-edit-agent-link" href="/Dashboard/ProjectMemory/Agents" target="_blank" rel="noopener" class="text-[9px] font-medium text-emerald-800 underline hover:no-underline dark:text-emerald-300">Edit agent YAML</a>
                                </div>
                                <p class="mt-0.5 text-[9px] leading-snug text-gray-600 dark:text-gray-400">Agent defaults come from YAML <code class="text-[9px]">tools.allow</code>. Toggle extras for this flow step only — saved as <code class="text-[9px]">toolIds</code> on the node.</p>
                                <p class="mt-2 text-[9px] font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">Agent defaults</p>
                                <div id="sc-flow-yaml-tools" class="mt-1 flex min-h-[1.25rem] flex-wrap gap-1"></div>
                                <p class="mt-2 text-[9px] font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">This step</p>
                                <div id="sc-flow-llm-tools" class="mt-1 space-y-1.5"></div>
                            </div>
                            <details id="sc-flow-persona-advanced" class="mt-2 rounded border border-sky-300/50 bg-white/60 p-1.5 dark:border-sky-700/40 dark:bg-gray-950/30">
                                <summary class="cursor-pointer select-none text-[10px] font-medium text-gray-700 dark:text-gray-300">Context &amp; capabilities</summary>
                                <div id="sc-flow-pq-context-wrap" class="mt-2 hidden rounded border border-sky-300/60 bg-white/80 p-2 dark:border-sky-700/50 dark:bg-gray-900/50">
                                    <label class="block text-[10px] font-medium text-gray-700 dark:text-gray-300" for="sc-flow-pq-context-strategy">person-query context</label>
                                    <select id="sc-flow-pq-context-strategy" class="mt-1 w-full rounded border border-gray-300 bg-white px-1 py-1 text-[11px] dark:border-gray-600 dark:bg-gray-900">
                                        <option value="markdown_all">All entity markdown (default)</option>
                                        <option value="markdown_focus">Match name from question</option>
                                        <option value="rag">Vector RAG (fallback: all markdown)</option>
                                        <option value="graph_rag">Graph RAG (fallback: all markdown)</option>
                                    </select>
                                </div>
                                <div id="sc-flow-persona-cap" class="mt-2 max-h-36 overflow-y-auto rounded border border-sky-300/70 bg-white/95 p-2 text-[10px] text-gray-800 dark:border-sky-700 dark:bg-gray-950/60 dark:text-gray-100"></div>
                            </details>
                        </div>
                    </div>
                </div>
                <div class="flex min-h-0 min-w-0 flex-1 flex-col rounded-lg border border-gray-200 bg-gray-50 outline-none dark:border-gray-600 dark:bg-gray-800" id="sc-flow-cy" tabindex="0" title="Flow canvas — click to focus for keyboard shortcuts"></div>
            </div>
            <style>
                /* Simulate-order chips: hover links canvas node ↔ traversal step */
                .sc-flow-traverse-wrap { margin-top: 0.15rem; }
                .sc-flow-traverse-track {
                    display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem;
                    margin-top: 0.35rem;
                }
                .sc-flow-traverse-chip {
                    display: inline-flex; align-items: center; gap: 0.35rem;
                    border: 1px solid rgb(203 213 225); border-radius: 0.375rem;
                    background: rgb(255 255 255); padding: 0.15rem 0.45rem;
                    font-size: 11px; line-height: 1.25rem; cursor: pointer;
                    transition: border-color 120ms, background-color 120ms, box-shadow 120ms;
                }
                .dark .sc-flow-traverse-chip {
                    border-color: rgb(71 85 105); background: rgb(15 23 42); color: rgb(226 232 240);
                }
                .sc-flow-traverse-chip:hover,
                .sc-flow-traverse-chip.is-hover {
                    border-color: rgb(34 211 238);
                    background: rgb(236 254 255);
                    box-shadow: 0 0 0 2px rgb(34 211 238 / 0.35);
                }
                .dark .sc-flow-traverse-chip:hover,
                .dark .sc-flow-traverse-chip.is-hover {
                    background: rgb(22 78 99 / 0.35);
                }
                .sc-flow-traverse-idx {
                    display: inline-flex; min-width: 1.1rem; justify-content: center;
                    border-radius: 9999px; background: rgb(241 245 249);
                    font-size: 9px; font-weight: 600; color: rgb(71 85 105);
                }
                .dark .sc-flow-traverse-idx { background: rgb(51 65 85); color: rgb(203 213 225); }
                .sc-flow-traverse-arrow { color: rgb(148 163 184); font-size: 10px; user-select: none; }
            </style>
            <div id="sc-flow-message" class="min-h-[1.25rem] shrink-0 px-4 text-xs text-gray-600 dark:text-gray-300"></div>
            <div class="flex shrink-0 flex-wrap items-center gap-2 border-t border-gray-200 px-4 py-3 dark:border-gray-700">
                <button type="button" id="sc-flow-validate" class="rounded-lg bg-gray-100 px-3 py-2 text-xs font-medium text-gray-800 hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-100 dark:hover:bg-gray-700">Validate</button>
                <button type="button" id="sc-flow-simulate" class="rounded-lg bg-gray-100 px-3 py-2 text-xs font-medium text-gray-800 hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-100 dark:hover:bg-gray-700">Simulate order</button>
                <button type="button" id="sc-flow-save" title="Writes this scenario’s flow to Config/agctor-scenarios.user.json (PUT /api/scenarios/{id}/flow); validates on server." class="rounded-lg bg-indigo-600 px-3 py-2 text-xs font-medium text-white hover:bg-indigo-700">Save flow to scenario</button>
                <button type="button" id="sc-flow-copy" title="Copy the flow on this canvas to a different scenario’s saved flow." class="rounded-lg border border-indigo-300 bg-indigo-50 px-3 py-2 text-xs font-medium text-indigo-900 hover:bg-indigo-100 dark:border-indigo-700 dark:bg-indigo-950/40 dark:text-indigo-100 dark:hover:bg-indigo-950/70">Copy flow to another scenario</button>
                <button type="button" class="rounded-lg border border-gray-300 px-3 py-2 text-xs font-medium dark:border-gray-600" data-sc-flow-close>Cancel</button>
            </div>
        </div>
    </div>
</div>

<div id="sc-flow-copy-modal" class="hidden fixed inset-0 z-[60] overflow-y-auto" aria-modal="true" role="dialog" aria-labelledby="sc-flow-copy-title">
    <div class="flex min-h-full items-center justify-center p-4">
        <div class="fixed inset-0 bg-gray-900/60" data-sc-flow-copy-backdrop></div>
        <div class="relative w-full max-w-md rounded-xl border border-gray-200 bg-white p-4 shadow-xl dark:border-gray-700 dark:bg-gray-900">
            <h2 id="sc-flow-copy-title" class="text-base font-semibold text-gray-900 dark:text-white">Copy conversation flow</h2>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Copies the flow currently on the designer canvas to another scenario’s saved flow. This does not change the scenario you are editing until you save there separately.</p>
            <div id="sc-flow-copy-step-select" class="mt-3 space-y-3">
                <div>
                    <label for="sc-flow-copy-target" class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Target scenario</label>
                    <select id="sc-flow-copy-target" class="w-full rounded-lg border border-gray-300 bg-white p-2.5 text-sm dark:border-gray-600 dark:bg-gray-800 dark:text-white"></select>
                </div>
                <p id="sc-flow-copy-error" class="hidden text-xs text-red-600 dark:text-red-400" role="alert"></p>
            </div>
            <div id="sc-flow-copy-step-confirm" class="hidden mt-3 rounded-md border border-amber-200 bg-amber-50 px-2.5 py-2.5 text-xs leading-snug text-amber-950 dark:border-amber-900/50 dark:bg-amber-900/20 dark:text-amber-100">
                <p class="font-medium">Replace existing flow?</p>
                <p id="sc-flow-copy-confirm-text" class="mt-1"></p>
                <p class="mt-1 text-[11px] opacity-90">The target scenario’s current conversation flow will be permanently replaced by the copy from this canvas.</p>
            </div>
            <div class="mt-4 flex flex-wrap justify-end gap-2">
                <button type="button" class="rounded-lg border border-gray-300 px-3 py-2 text-xs font-medium dark:border-gray-600" data-sc-flow-copy-cancel>Cancel</button>
                <button type="button" id="sc-flow-copy-approve" class="rounded-lg bg-indigo-600 px-3 py-2 text-xs font-medium text-white hover:bg-indigo-700">Approve</button>
                <button type="button" id="sc-flow-copy-override" class="hidden rounded-lg bg-amber-600 px-3 py-2 text-xs font-medium text-white hover:bg-amber-700">Replace existing flow</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/cytoscape@3.30.2/dist/cytoscape.min.js" crossorigin="anonymous"></script>
    <script src="~/js/dashboard/scenario-flow/graph-document.js" asp-append-version="true"></script>
    <script src="~/js/dashboard/scenario-flow/cytoscape-adapter.js" asp-append-version="true"></script>
    <script src="~/js/dashboard/scenario-flow/graph-renderer.js" asp-append-version="true"></script>
    <script src="~/js/dashboard/persona-tools-ui.js" asp-append-version="true"></script>
    <script src="~/js/dashboard/scenarios-page.js" asp-append-version="true"></script>
}
