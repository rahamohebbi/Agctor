@model AgctorSDK.Host.Models.RagProvidersDashboardModel
@using AgctorSDK.Core.Rag
@using AgctorSDK.Host.Models
@{
    var active = Model.Status.Available.FirstOrDefault(p => string.Equals(p.Id, Model.Status.Current.ProviderId, StringComparison.OrdinalIgnoreCase));
    var isActive = string.Equals(Model.SelectedProviderId, Model.Status.Current.ProviderId, StringComparison.OrdinalIgnoreCase);
    var isMarkdown = string.Equals(Model.SelectedProviderId, RagProviderIds.None, StringComparison.OrdinalIgnoreCase);
    var isSceneMemory = Model.SelectedModel?.Kind == nameof(RagProviderKind.SceneMemory);
    var overall = Model.Health?.OverallStatus ?? "unknown";
}
<div id="rag-providers-dashboard" class="rp-workspace" data-selected-provider="@Model.SelectedProviderId" data-active-provider="@Model.Status.Current.ProviderId" data-provider-kind="@Model.SelectedModel?.Kind">
    <section class="rp-current" aria-label="Current default retrieval">
        <div><p class="rp-eyebrow">CURRENT DEFAULT</p><h2 id="rag-current-name">@(active?.DisplayName ?? Model.Status.Current.ProviderId)</h2><p class="rp-muted">Used by flows that request the default retrieval provider.</p></div>
        <div class="rp-current-health" id="rag-health-row"><div class="rp-actions"><span id="rag-health-badge" class="rp-badge @(overall == "healthy" ? "rp-good" : "rp-warning")">@HealthLabel(overall)</span><button type="button" id="rag-health-refresh" class="rp-button rp-small">Check health</button></div><span id="rag-health-checked" class="rp-muted" role="status">Checked on page load</span></div>
        <details class="rp-health-details"><summary>Health details</summary><p id="rag-health-detail" class="rp-muted">@(Model.Health?.Detail ?? Model.Status.Current.HealthMessage)</p><p class="rp-muted">Transport: @Model.Status.Current.Transport. Health is for the current default; local service status appears in Setup.</p></details>
    </section>
    <div class="rp-layout">
        <aside class="rp-sidebar" aria-label="Select provider">
            <h2>Select provider</h2><p class="rp-muted">Explore options without changing your default.</p>
            <nav class="rp-provider-list" aria-label="Retrieval providers">
                @foreach (var provider in Model.Status.Available)
                {
                    var selected = string.Equals(provider.Id, Model.SelectedProviderId, StringComparison.OrdinalIgnoreCase);
                    var current = string.Equals(provider.Id, Model.Status.Current.ProviderId, StringComparison.OrdinalIgnoreCase);
                    <a class="rp-provider" href="/Dashboard/RagProviders?provider=@Uri.EscapeDataString(provider.Id)" data-provider-select="@provider.Id" aria-current="@(selected ? "page" : null)">
                        <span class="rp-provider-title">@ProviderName(provider.Id)</span><span class="rp-provider-description">@ProviderSummary(provider.Id)</span>
                        <span class="rp-provider-meta"><span class="rp-badge">@KindLabel(provider.Kind)</span> @(provider.RequiresDocker ? "External service" : "Built in") @if(current){<span class="rp-badge rp-good">Default</span>} @if(provider.Maturity == "experimental"){<span class="rp-badge rp-warning">Experimental</span>} @if(provider.Maturity == "mvp"){<span class="rp-badge">MVP</span>}</span>
                    </a>
                }
            </nav>
        </aside>
        <section class="rp-detail" aria-label="Provider details">
            <header class="rp-detail-heading"><p class="rp-eyebrow">@(isActive ? "DEFAULT PROVIDER" : "EXPLORING PROVIDER")</p><h2>@ProviderName(Model.SelectedProviderId)</h2><p class="rp-muted">@ProviderSummary(Model.SelectedProviderId)</p>
                @if (isSceneMemory) { <p class="rp-view-note">Use Scene Memory alongside <strong>@(active?.DisplayName ?? Model.Status.Current.ProviderId)</strong>. Attach a scene workspace to a test agent to retrieve its recorded state.</p> }
                else if (!isActive) { <p class="rp-view-note">Your default is still <strong>@(active?.DisplayName ?? Model.Status.Current.ProviderId)</strong>. Use the button in Setup to switch.</p> }
            </header>
            <div class="rp-tabs" role="tablist" aria-label="Provider workspace">
                <button type="button" id="rag-tab-setup" role="tab" aria-selected="true" aria-controls="rag-panel-setup">@(isSceneMemory ? "Overview" : "Setup")</button>
                @if (!isMarkdown && !isSceneMemory) {
                    <button type="button" id="rag-tab-index" role="tab" aria-selected="false" aria-controls="rag-panel-index" tabindex="-1">Index data</button>
                    <button type="button" id="rag-tab-test" role="tab" aria-selected="false" aria-controls="rag-panel-test" tabindex="-1">Test retrieval</button>
                }
            </div>
            <section id="rag-panel-setup" class="rp-panel" role="tabpanel" aria-labelledby="rag-tab-setup" tabindex="0">
                @if (isSceneMemory) {
                    <div class="rp-guide" id="rag-scene-memory-overview">
                        <h3>Remember what changed in your story</h3>
                        <p class="rp-muted">Create a workspace for your story. Add characters, locations, objects, audio and music, then record their properties and changes.</p>
                        <p class="rp-muted">Query current state or an earlier change number, with the source records included. Test it directly or through an AGCTOR agent.</p>
                    </div>
                    <div class="rp-save"><p class="rp-muted">Built into Host. No model or external service needed.</p><a href="/Dashboard/SceneMemory" id="rag-open-scene-memory" class="rp-button rp-primary">Open Scene Memory</a></div>
                    <p class="rp-muted">MVP: manually entered facts and exact-name queries. Media analysis and video generation are future work.</p>
                } else if (isMarkdown) {
                    <div class="rp-markdown"><span class="rp-mode-icon" aria-hidden="true">Aa</span><h3>Your files are the source</h3><p class="rp-muted">Use Project Memory markdown directly, with no external search service or Docker container.</p><p class="rp-muted">Choose an external provider when your flow needs semantic search or graph retrieval. Switching to markdown does not stop existing containers or delete their indexes.</p></div>
                    <form id="rag-save-form"><input type="hidden" name="defaultProvider" value="@Model.SelectedProviderId" /><div class="rp-save"><p class="rp-muted">@(isActive ? "Markdown only is already your default." : "Makes markdown-only retrieval the default for this host.")</p><button type="submit" id="rag-save-btn" class="rp-button rp-primary" disabled="@(isActive ? "disabled" : null)">Use Markdown only</button></div><p id="rag-save-status" class="rp-status" role="status"></p></form>
                } else if (Model.SelectedModel != null) {
                    <div class="rp-guide"><h3>Connect → index → test</h3><p class="rp-muted">Configure this provider and save it as your default, start its service if needed, then index your project files and try a question.</p></div>
                    <form id="rag-save-form" class="rp-config">
                        <h3>Connection settings</h3><p class="rp-muted">Saved on this machine. Indexing and test queries use the saved settings for this provider.</p>
                        <input type="hidden" name="defaultProvider" value="@Model.SelectedProviderId" />
                        <fieldset id="rag-connection-fields">
                        @foreach (var field in Model.SelectedModel.ConfigFields.Where(f => f.Key == "BaseUrl")) {
                            <div class="rp-field"><label for="rag-field-@FieldName(field.Key)">@field.Label</label><input id="rag-field-@FieldName(field.Key)" type="url" name="@FieldName(field.Key)" value="@ResolveFieldValue(field.Key, Model.Status.Configured, Model.SelectedModel.Id)" class="@InputClass" placeholder="@field.Placeholder" required /></div>
                        }
                        <details class="rp-advanced"><summary>Authentication & advanced settings</summary><div class="rp-fields">
                        @foreach (var field in Model.SelectedModel.ConfigFields.Where(f => f.Key != "BaseUrl")) {
                            <div class="rp-field"><label for="rag-field-@FieldName(field.Key)">@field.Label</label>
                            @if (field.FieldType == "select") {
                                var options = (field.Placeholder ?? field.DefaultValue ?? "").Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                                var current = ResolveFieldValue(field.Key, Model.Status.Configured, Model.SelectedModel.Id);
                                <select id="rag-field-@FieldName(field.Key)" name="@FieldName(field.Key)" class="@InputClass">
                                @foreach (var opt in options) { <option value="@opt" selected="@(string.Equals(opt, current, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@opt</option> }
                                </select>
                            } else {
                                <input id="rag-field-@FieldName(field.Key)" type="@(field.FieldType == "password" ? "password" : "text")" name="@FieldName(field.Key)" value="@ResolveFieldValue(field.Key, Model.Status.Configured, Model.SelectedModel.Id)" class="@InputClass" placeholder="@field.Placeholder" autocomplete="off" />
                            }
                            @if (!string.IsNullOrWhiteSpace(field.HelpText)) { <p class="rp-muted">@field.HelpText</p> }
                            </div>
                        }
                        </div></details></fieldset>
                        <div class="rp-save"><div><strong id="rag-draft-state">Saved settings</strong><p class="rp-muted">@(isActive ? "Changes apply to your current default." : "Saving also makes this provider your default.")</p></div><div class="rp-actions"><button type="button" id="rag-reset-settings" class="rp-button hidden">Discard edits</button><button type="submit" id="rag-save-btn" class="rp-button rp-primary">@(isActive ? "Save settings" : "Save & use " + Model.SelectedModel.DisplayName)</button></div></div>
                        <p id="rag-save-status" class="rp-status" role="status"></p>
                    </form>
                    @if (Model.SelectedModel.RequiresDocker) {
                var docker = Model.DockerStatus;
                var stateCls = docker?.State?.Equals("running", StringComparison.OrdinalIgnoreCase) == true
                    ? "bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-200"
                    : docker?.State is "stopped" or "exited"
                        ? "bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200"
                        : "bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-200";
                <details class="rp-advanced rp-docker" id="rag-docker-panel" data-docker-provider-id="@Model.SelectedProviderId">
                    <summary>Local Docker service <span id="rag-docker-summary-state" class="rp-badge">@(docker?.State ?? "unknown")</span></summary>
                    <div class="rp-docker-body">
                    <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
                        <div>
                            <h3 class="text-base font-semibold text-gray-900 dark:text-white">Manage @Model.SelectedModel.DisplayName</h3>
                            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Manage the local service for this provider. Saving settings does not start it.</p>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            <button type="button" data-docker-action="start"
                                    class="inline-flex items-center px-3 py-1.5 text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700 disabled:opacity-50">
                                Start
                            </button>
                            <button type="button" data-docker-action="stop"
                                    class="inline-flex items-center px-3 py-1.5 text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 disabled:opacity-50">
                                Stop
                            </button>
                            <button type="button" data-docker-action="install"
                                    class="inline-flex items-center px-3 py-1.5 text-sm font-medium rounded-md border border-gray-300 bg-white text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600 disabled:opacity-50">
                                Pull image
                            </button>
                            <button type="button" data-docker-action="refresh"
                                    class="inline-flex items-center px-3 py-1.5 text-sm font-medium rounded-md border border-gray-300 bg-white text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600 disabled:opacity-50">
                                Refresh
                            </button>
                        </div>
                    </div>

                    <p id="rag-docker-action-status" class="text-xs text-gray-600 dark:text-gray-300 mb-3 hidden" role="status"></p>

                    @if (docker != null)
                    {
                        <dl id="rag-docker-status-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm mb-2">
                            <div><dt class="text-gray-500 dark:text-gray-400">Docker</dt><dd id="rag-docker-status-available" class="text-gray-900 dark:text-white">@(docker.DockerAvailable ? "Available" : "Not available")</dd></div>
                            <div><dt class="text-gray-500 dark:text-gray-400">State</dt><dd><span id="rag-docker-status-state" class="text-xs font-medium px-2 py-0.5 rounded @stateCls">@docker.State</span></dd></div>
                            <div><dt class="text-gray-500 dark:text-gray-400">Service</dt><dd id="rag-docker-status-service" class="font-mono text-gray-900 dark:text-white">@docker.ServiceName</dd></div>
                            <div><dt class="text-gray-500 dark:text-gray-400">Health</dt><dd id="rag-docker-status-health" class="text-gray-900 dark:text-white">@(docker.Health ?? "—")</dd></div>
                        </dl>
                        <p id="rag-docker-status-message" class="text-xs text-gray-600 dark:text-gray-300 mb-4">@(docker.Message ?? "")</p>
                    }

                    <details class="rp-advanced"><summary>Advanced: Docker terminal</summary>
                    @await Component.InvokeAsync("TerminalCommandPanel", new
                    {
                        componentId = "rag-provider-terminal-" + Model.SelectedModel.Id.Replace('.', '-').ToLowerInvariant(),
                        title = "Docker terminal — " + Model.SelectedModel.DisplayName,
                        description = "Pick a preset or edit the command, then click Run. Commands run from the repo root. First-time Cognee pulls are large (~6 GB) and may take several minutes with no live progress.",
                        contextType = "rag-provider",
                        contextKey = Model.SelectedModel.Id
                    })
                    </details>
                    </div>
                </details>
                    }
                    <details class="rp-advanced"><summary>Provider details & requirements</summary><p class="rp-muted">@Model.SelectedModel.Limitations</p><p class="rp-muted">@Model.SelectedModel.DeploymentNotes</p><p class="rp-muted">Supported flow strategies: @string.Join(", ", Model.SelectedModel.ContextStrategies)</p><p class="rp-muted">Host settings are stored in appsettings.User.json. Docker services may also need their own environment file.</p></details>
                }
            </section>
            @if (!isMarkdown && !isSceneMemory && Model.SelectedModel != null) {
                <section id="rag-panel-index" class="rp-panel hidden" role="tabpanel" aria-labelledby="rag-tab-index" tabindex="0">
                    <h3>Make your project searchable</h3><p class="rp-muted">Preview the Project Memory files, then send them to <strong>@Model.SelectedModel.DisplayName</strong> for indexing. This uses its saved connection and does not change your default provider.</p><p class="rp-draft-notice hidden" data-draft-notice>Save or discard your connection edits in Setup before indexing.</p>
                    <div id="rag-ingest-panel" data-provider-id="@Model.SelectedProviderId">
                <form id="rag-ingest-form" class="mt-4 space-y-3 max-w-xl">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300" for="rag-ingest-source">Data source</label>
                        <select id="rag-ingest-source" name="sourceId" class="@InputClass">
                            <option value="agctor_markdown">Project Memory markdown</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300" for="rag-ingest-collection-id">Collection name (optional)</label>
                        <input type="text" id="rag-ingest-collection-id" name="collectionId"
                               class="@InputClass" placeholder="defaults to scenario id or agctor" />
                    </div>
                    <p id="rag-ingest-project-root-hint" class="text-xs text-gray-500 dark:text-gray-400">
                        Uses <code class="text-[11px]">Agctor:ProjectMemory:ProjectRoot</code> from Maintenance / appsettings.
                    </p>
                    @if (string.Equals(Model.SelectedProviderId, "Cognee", StringComparison.OrdinalIgnoreCase))
                    {
                        <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
                            <input type="checkbox" id="rag-ingest-force-reingest" name="forceReingest"
                                   class="rounded border-gray-300 dark:border-gray-600" />
                            Rebuild existing datasets (slower; runs graph extraction again)
                        </label>
                    }
                    <div class="flex flex-wrap gap-2">
                        <button type="button" id="rag-ingest-preview-btn"
                                class="inline-flex items-center px-4 py-2 text-sm font-medium rounded-md border border-gray-300 bg-white text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600">
                            Preview files
                        </button>
                        <button type="submit" id="rag-ingest-run-btn"
                                class="inline-flex items-center px-4 py-2 text-sm font-medium rounded-md shadow-sm text-white bg-emerald-600 hover:bg-emerald-700">
                            Index files in @Model.SelectedModel.DisplayName
                        </button>
                    </div>
                    <p id="rag-ingest-status" class="text-sm text-gray-600 dark:text-gray-300 hidden" role="status"></p>
                    <ul id="rag-ingest-preview-list" class="text-xs text-gray-600 dark:text-gray-300 space-y-1 hidden"></ul>
                    <ul id="rag-ingest-results" class="space-y-1 text-xs max-h-64 overflow-y-auto"></ul>
                </form>
                    </div>
                </section>
                <section id="rag-panel-test" class="rp-panel hidden" role="tabpanel" aria-labelledby="rag-tab-test" tabindex="0">
                    <h3>Check what your agents can retrieve</h3><p class="rp-muted">Ask <strong>@Model.SelectedModel.DisplayName</strong> a question to see matching source excerpts. Index data first; this checks retrieval, not the full chat workflow.</p><p class="rp-draft-notice hidden" data-draft-notice>Save or discard your connection edits in Setup before testing.</p>
                    <div id="rag-test-query-panel">
                <form id="rag-test-query-form" class="mt-4 space-y-3 max-w-xl">
                    <div>
                        <label for="rag-test-query-input" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Your question</label>
                        <input type="text" id="rag-test-query-input" name="query" required
                               class="@InputClass" placeholder="What does this project do?" />
                    </div>
                    <div>
                        <label for="rag-test-collection-id" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Collection name (optional)</label>
                        <input type="text" id="rag-test-collection-id" name="collectionId"
                               class="@InputClass" placeholder="default" />
                    </div>
                    <button type="submit" id="rag-test-run-btn"
                            class="inline-flex items-center px-4 py-2 text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700">
                        Test retrieval
                    </button>
                    <p id="rag-test-query-status" class="text-sm text-gray-600 dark:text-gray-300 hidden" role="status"></p>
                    <ul id="rag-test-query-results" class="space-y-2 text-sm"></ul>
                </form>
                    </div>
                </section>
            }
        </section>
    </div>
    <div id="rag-leave-dialog" class="rp-dialog hidden" role="dialog" aria-modal="true" aria-labelledby="rag-leave-title">
        <div class="rp-dialog-backdrop"></div><div class="rp-dialog-card"><h2 id="rag-leave-title">Leave unsaved settings?</h2><p class="rp-muted">Your connection edits will be discarded. The saved provider settings will stay unchanged.</p><div class="rp-actions"><button type="button" id="rag-keep-editing" class="rp-button">Keep editing</button><button type="button" id="rag-discard-leave" class="rp-button rp-primary">Discard & continue</button></div></div>
    </div>
</div>

@functions {
    private static string HealthLabel(string status) => status.ToLowerInvariant() switch { "healthy" => "Healthy", "degraded" => "Needs attention", _ => "Status unknown" };
    private static string ProviderName(string id) => id switch { RagProviderIds.None => "Markdown only", RagProviderIds.SceneMemory => "Scene Memory", _ => id };
    private static string KindLabel(string kind) => kind switch { nameof(RagProviderKind.SceneMemory) => "Scene Memory", nameof(RagProviderKind.Markdown) => "File memory", _ => "Knowledge RAG" };
    private static string ProviderSummary(string id) => id switch {
        RagProviderIds.None => "Read your project's markdown files directly.",
        RagProviderIds.LightRag => "Find relevant knowledge with vector and graph search.",
        RagProviderIds.Graphiti => "Retrieve relationships and facts that change over time.",
        RagProviderIds.Cognee => "Build a memory graph and retrieve context for your agents.",
        RagProviderIds.SceneMemory => "Recall entity state and changes across your story.",
        _ => "Explore this retrieval provider."
    };

    private const string InputClass =
        "mt-1 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm " +
        "focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white";

    private static string FieldName(string key) => key switch
    {
        "BaseUrl" => "baseUrl",
        "ApiKey" => "apiKey",
        "DefaultMode" => "defaultMode",
        "Transport" => "transport",
        "McpPath" => "mcpPath",
        "SearchType" => "searchType",
        "LlmApiKey" => "llmApiKey",
        _ => char.ToLowerInvariant(key[0]) + key[1..]
    };

    private static string ResolveFieldValue(string key, ConfiguredRagProviderDto cfg, string providerId)
    {
        if (string.Equals(providerId, RagProviderIds.LightRag, StringComparison.Ordinal))
        {
            return key switch
            {
                "BaseUrl" => cfg.LightRAG.BaseUrl,
                "ApiKey" => cfg.LightRAG.ApiKey,
                "DefaultMode" => cfg.LightRAG.DefaultMode,
                "Transport" => cfg.LightRAG.Transport,
                _ => ""
            };
        }

        if (string.Equals(providerId, RagProviderIds.Graphiti, StringComparison.Ordinal))
        {
            return key switch
            {
                "BaseUrl" => cfg.Graphiti.BaseUrl,
                "ApiKey" => cfg.Graphiti.ApiKey,
                "DefaultGroupId" => cfg.Graphiti.DefaultGroupId,
                "Transport" => cfg.Graphiti.Transport,
                _ => ""
            };
        }

        if (string.Equals(providerId, RagProviderIds.Cognee, StringComparison.Ordinal))
        {
            return key switch
            {
                "BaseUrl" => cfg.Cognee.BaseUrl,
                "McpPath" => cfg.Cognee.McpPath,
                "SearchType" => cfg.Cognee.SearchType,
                "LlmApiKey" => cfg.Cognee.LlmApiKey,
                "Transport" => cfg.Cognee.Transport,
                _ => ""
            };
        }

        return "";
    }
}
