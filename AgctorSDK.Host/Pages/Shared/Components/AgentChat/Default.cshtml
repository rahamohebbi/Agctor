@model AgctorSDK.Host.Models.AgentChatComponentModel
<div id="@Model.ComponentId"
     class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
    <h2 class="mb-2 text-lg font-semibold text-gray-900 dark:text-white">@Model.Title</h2>
    <p id="codegraph-chat-help" class="mb-3 text-sm text-gray-500 dark:text-gray-400">@Model.HelpText</p>
    <div class="flex flex-wrap items-center gap-2 mb-3">
        <label for="codegraph-chat-session" class="text-xs text-gray-500 dark:text-gray-400">Session</label>
        <select id="codegraph-chat-session"
                class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg p-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white min-w-[220px]"></select>
        <button type="button"
                id="codegraph-chat-new-session"
                class="px-3 py-2 text-sm font-medium text-white bg-gray-600 rounded-lg hover:bg-gray-700 dark:bg-gray-600 dark:hover:bg-gray-700">
            New session
        </button>
        <span id="codegraph-chat-session-label" class="text-xs text-gray-500 dark:text-gray-400"></span>
    </div>
    <div class="flex flex-wrap gap-2 mb-3">
        <label for="codegraph-chat-agent" class="sr-only">Agent</label>
        <select id="codegraph-chat-agent"
                class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg p-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white">
            <option value="query-agent">query-agent (Q&amp;A, code questions)</option>
            <option value="coder-agent">coder-agent (write/edit code)</option>
            <option value="refactor-agent">refactor-agent (refactor)</option>
        </select>
        <textarea id="codegraph-chat-input"
                  rows="2"
                  placeholder="e.g. Where is Square defined?"
                  class="flex-1 min-w-[200px] bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white dark:placeholder-gray-400"></textarea>
        <button type="button"
                id="codegraph-chat-send"
                class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 dark:bg-blue-600 dark:hover:bg-blue-700">
            Send
        </button>
    </div>
    <div id="codegraph-chat-status" class="mt-2 hidden"></div>
    <div id="codegraph-chat-messages" class="mt-2 p-3 rounded-lg bg-gray-50 dark:bg-gray-700/50 max-h-64 overflow-y-auto text-sm space-y-2"></div>
    <div id="codegraph-chat-completion-banner" class="mt-3 hidden"></div>
    <div id="codegraph-trace-host" class="mt-4"></div>
</div>
