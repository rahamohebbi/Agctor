@model AgctorSDK.Host.Models.TerminalCommandPanelModel

<div id="@Model.ComponentId"
     class="terminal-command-panel rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50/80 dark:bg-gray-900/40 p-4"
     data-terminal-command-panel
     data-context-type="@Model.ContextType"
     data-context-key="@(Model.ContextKey ?? "")">
    <div class="flex flex-wrap items-start justify-between gap-2 mb-3">
        <div>
            <h3 class="text-base font-semibold text-gray-900 dark:text-white">@Model.Title</h3>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">@Model.Description</p>
            }
        </div>
        @if (Model.Presets.Count > 0)
        {
            <div class="flex items-center gap-2 min-w-[12rem]">
                <label class="sr-only" for="@(Model.ComponentId)-preset">Preset</label>
                <select id="@(Model.ComponentId)-preset"
                        class="block w-full rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm text-gray-900 dark:border-gray-600 dark:bg-gray-700 dark:text-white">
                    <option value="">Choose preset…</option>
                    @foreach (var preset in Model.Presets)
                    {
                        <option value="@preset.Command">@preset.Label</option>
                    }
                </select>
            </div>
        }
    </div>

    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" for="@(Model.ComponentId)-command">Command</label>
    <textarea id="@(Model.ComponentId)-command"
              rows="3"
              spellcheck="false"
              class="terminal-command-input w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-mono text-gray-900 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-100">@Model.Command</textarea>

    <div class="mt-3 flex flex-wrap items-center gap-2">
        <button type="button"
                class="terminal-command-run inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 disabled:opacity-50">
            <svg class="terminal-command-spinner hidden h-4 w-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            <span class="terminal-command-run-label">Run</span>
        </button>
        <button type="button"
                class="terminal-command-copy px-3 py-2 text-sm font-medium rounded-md border border-gray-300 bg-white text-gray-800 hover:bg-gray-50 dark:border-gray-600 dark:bg-gray-700 dark:text-white">
            Copy
        </button>
        <span class="terminal-command-status text-sm text-gray-500 dark:text-gray-400"></span>
    </div>

    <div class="terminal-command-output hidden mt-4">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
            <p class="text-xs font-medium text-gray-600 dark:text-gray-300">Output</p>
            <span class="terminal-command-exit text-xs font-mono text-gray-500 dark:text-gray-400"></span>
        </div>
        <p class="terminal-command-progress text-xs text-blue-700 dark:text-blue-300 mb-2 hidden"></p>
        <pre class="terminal-command-stdout max-h-64 overflow-auto rounded-md border border-gray-200 bg-white p-3 text-xs font-mono text-gray-900 dark:border-gray-600 dark:bg-gray-950 dark:text-gray-100 whitespace-pre-wrap"></pre>
        <pre class="terminal-command-stderr hidden max-h-40 overflow-auto mt-2 rounded-md border border-red-200 bg-red-50 p-3 text-xs font-mono text-red-900 dark:border-red-800 dark:bg-red-950/40 dark:text-red-200 whitespace-pre-wrap"></pre>
    </div>
</div>
