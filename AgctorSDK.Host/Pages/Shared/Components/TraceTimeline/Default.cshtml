@model AgctorSDK.Host.Models.TraceTimelineComponentModel
<div id="@Model.ComponentId"
     data-empty-message="@Model.EmptyMessage"
     data-height-px="@Model.HeightPx"
     data-initial-trace-id="@Model.InitialTraceId"
     class="p-4 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
    <div class="flex flex-wrap items-center justify-between gap-2">
        <div>
            <h3 class="text-base font-semibold text-gray-900 dark:text-white">@Model.Title</h3>
            <p class="text-xs text-gray-500 dark:text-gray-400">Time on X axis, event sequence on Y axis.</p>
        </div>
        <span data-role="status" class="text-xs text-gray-500 dark:text-gray-400">Waiting for trace...</span>
    </div>
    <p data-role="selection" class="mt-2 text-sm text-gray-600 dark:text-gray-300">No trace selected.</p>
    <div class="mt-4 overflow-x-auto">
        <svg data-role="chart"
             class="w-full min-w-[720px] rounded border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/40"
             height="@Model.HeightPx"
             viewBox="0 0 960 @Model.HeightPx"
             preserveAspectRatio="xMinYMin meet"></svg>
    </div>
    <div data-role="details" class="mt-4 space-y-2"></div>
    <div data-role="event-detail" class="mt-3 hidden rounded-lg border border-violet-200 bg-violet-50/60 p-3 text-sm text-gray-900 dark:border-violet-800 dark:bg-violet-950/40 dark:text-gray-100"></div>
</div>

<script>
(function() {
    if (!window.agctorTraceTimeline) {
        const registry = {};

        function esc(value) {
            const div = document.createElement('div');
            div.textContent = value ?? '';
            return div.innerHTML;
        }

        function getRoot(id) {
            return document.getElementById(id);
        }

        function getState(id) {
            if (!registry[id]) {
                registry[id] = { data: null, options: {} };
            }
            return registry[id];
        }

        function applySelection(root, selectionLabel) {
            const selection = root.querySelector('[data-role="selection"]');
            if (selection) {
                selection.textContent = selectionLabel || 'No trace selected.';
            }
        }

        function colorForDepth(depth, hasResult) {
            if (depth === 0) return hasResult ? '#7c3aed' : '#8b5cf6';
            if (depth === 1) return hasResult ? '#2563eb' : '#3b82f6';
            if (depth === 2) return hasResult ? '#0891b2' : '#06b6d4';
            return hasResult ? '#059669' : '#10b981';
        }

        function renderEmpty(root, message, selectionLabel) {
            const chart = root.querySelector('[data-role="chart"]');
            const status = root.querySelector('[data-role="status"]');
            const details = root.querySelector('[data-role="details"]');
            const panel = root.querySelector('[data-role="event-detail"]');
            applySelection(root, selectionLabel);
            if (status) status.textContent = message;
            if (chart) {
                chart.innerHTML = '<text x="24" y="40" fill="#6b7280" font-size="14">' + esc(message) + '</text>';
            }
            if (details) {
                details.innerHTML = '<p class="text-sm text-gray-500 dark:text-gray-400">' + esc(message) + '</p>';
            }
            if (panel) {
                panel.classList.add('hidden');
                panel.innerHTML = '';
            }
        }

        /** Bordered panel so Input vs Outcome reads clearly in Playground/CodeGraph traces (PRD-016). */
        function detailCard(title, innerHtml) {
            return '<section class="rounded-lg border border-gray-200 dark:border-gray-600 bg-white/95 dark:bg-gray-950/60 p-3 shadow-sm">' +
                '<h4 class="text-[11px] font-semibold uppercase tracking-wide text-violet-800 dark:text-violet-200 mb-2 border-b border-gray-100 dark:border-gray-700 pb-1">' +
                esc(title) + '</h4>' +
                '<div class="space-y-2">' + innerHtml + '</div></section>';
        }

        function formatTimelineDetailJson(raw) {
            let o;
            try {
                o = JSON.parse(raw);
            } catch (_) {
                return '<pre class="text-xs whitespace-pre-wrap break-words max-h-96 overflow-auto bg-white/80 dark:bg-black/30 p-2 rounded border border-gray-200 dark:border-gray-600">' +
                    esc(raw) + '</pre>';
            }
            const k = o.kind;
            if (k === 'pm.playground.persona-llm') {
                let meta = '<div class="rounded-md border border-gray-100 dark:border-gray-700 bg-gray-50/80 dark:bg-gray-900/40 p-2 space-y-1">' +
                    '<p class="text-xs text-gray-600 dark:text-gray-400">Ollama <code class="text-[11px]">' + esc(o.ollamaBase || '') + '</code> · model <code class="text-[11px]">' + esc(o.model || '') + '</code></p>' +
                    '<p class="text-xs text-gray-600 dark:text-gray-400">Prompt length ' + esc(String(o.promptChars ?? '')) + ' chars · output ' + esc(String(o.outputChars ?? '')) + ' chars</p>';
                if (o.promptTruncated) meta += '<p class="text-xs text-amber-700 dark:text-amber-300">Prompt truncated in trace payload.</p>';
                if (o.outputTruncated) meta += '<p class="text-xs text-amber-700 dark:text-amber-300">Output truncated in trace payload.</p>';
                meta += '</div>';
                const inputBody = '<pre class="max-h-72 overflow-auto text-xs bg-gray-50 dark:bg-black/40 p-2 rounded border border-gray-100 dark:border-gray-700 whitespace-pre-wrap break-words">' + esc(o.prompt || '') + '</pre>';
                const outBody = '<pre class="max-h-72 overflow-auto text-xs bg-gray-50 dark:bg-black/40 p-2 rounded border border-gray-100 dark:border-gray-700 whitespace-pre-wrap break-words">' + esc(o.output || '') + '</pre>';
                return '<div class="space-y-3">' + meta + '<div class="grid gap-3">' +
                    detailCard('Input (LLM prompt)', inputBody) +
                    detailCard('Output or outcome (raw model text)', outBody) +
                    '</div></div>';
            }
            if (k === 'pm.playground.ingest-disk') {
                const hasPreview = o.extractorOutputPreview != null && String(o.extractorOutputPreview).length > 0;
                let inputInner = '<p class="text-xs text-gray-600 dark:text-gray-400">Scenario <code class="text-[11px]">' + esc(o.scenarioId || '') + '</code></p>';
                if (o.extractorOutputChars != null && o.extractorOutputChars > 0) {
                    inputInner += '<p class="text-xs text-gray-600 dark:text-gray-400">Extractor output length: ' + esc(String(o.extractorOutputChars)) + ' chars.</p>';
                } else {
                    inputInner += '<p class="text-xs text-gray-500 dark:text-gray-400">Extractor raw output was not stored on this trace snapshot (older Host builds).</p>';
                }
                if (o.extractorOutputTruncated) {
                    inputInner += '<p class="text-xs text-amber-700 dark:text-amber-300">Preview truncated for trace size limits.</p>';
                }
                if (hasPreview) {
                    inputInner += '<pre class="max-h-64 overflow-auto text-xs bg-gray-50 dark:bg-black/40 p-2 rounded border border-gray-100 dark:border-gray-700 whitespace-pre-wrap break-words">' +
                        esc(o.extractorOutputPreview) + '</pre>';
                } else if (o.extractorOutputChars != null && o.extractorOutputChars > 0) {
                    inputInner += '<p class="text-xs text-gray-500 dark:text-gray-400">Preview empty (unexpected).</p>';
                }
                let outcomeInner = '<p class="text-xs"><span class="font-medium">Parse success:</span> ' + esc(String(o.parseSuccess)) +
                    ' · <span class="font-medium">Wrote files:</span> ' + esc(String(o.wroteAnyFile)) + '</p>';
                if (o.parseSource) {
                    const isActionSource = String(o.parseSource).indexOf('actionIntents.') === 0;
                    const badgeClass = isActionSource
                        ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-200'
                        : 'bg-slate-100 text-slate-800 dark:bg-slate-800/70 dark:text-slate-200';
                    const badgeLabel = isActionSource ? 'Action-intent' : 'Legacy';
                    outcomeInner += '<p class="text-xs"><span class="font-medium">Parse source:</span> <code class="text-[11px]">' + esc(o.parseSource) + '</code>' +
                        ' <span class="ml-1 inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-medium ' + badgeClass + '">' + esc(badgeLabel) + '</span></p>';
                }
                if (o.summary) outcomeInner += '<p class="text-xs text-gray-800 dark:text-gray-200">' + esc(o.summary) + '</p>';
                if (o.paths && o.paths.length) {
                    outcomeInner += '<ul class="list-disc pl-5 text-xs space-y-0.5">';
                    o.paths.forEach(function(p) {
                        outcomeInner += '<li><code class="break-all">' + esc(p) + '</code></li>';
                    });
                    outcomeInner += '</ul>';
                    if (o.pathsTruncated) outcomeInner += '<p class="text-xs text-amber-700 dark:text-amber-300">Paths list truncated.</p>';
                }
                return '<div class="space-y-3">' +
                    detailCard('Input (extractor raw output → ingest)', inputInner) +
                    detailCard('Outcome (parse + disk)', outcomeInner) +
                    '</div>';
            }
            if (k === 'pm.playground.persist-assistant') {
                const idInner = '<p class="text-xs text-gray-600 dark:text-gray-400">sessionId</p><p class="text-[11px] font-mono break-all">' + esc(o.sessionId || '') + '</p>' +
                    '<p class="text-xs text-gray-600 dark:text-gray-400 mt-2">messageId</p><p class="text-[11px] font-mono break-all">' + esc(o.messageId || '') + '</p>';
                let outInner = '<p class="text-xs text-gray-800 dark:text-gray-200"><span class="font-medium">Assistant body length:</span> ' +
                    esc(String(o.assistantChars ?? '')) + ' chars (includes ingest footer when applicable).</p>';
                if (o.ingestSummary) {
                    outInner += '<p class="text-xs"><span class="font-medium">Ingest summary:</span> ' + esc(o.ingestSummary) + '</p>';
                }
                let filesInner = '';
                if (o.files && o.files.length) {
                    o.files.forEach(function(f) {
                        filesInner += '<div class="mt-2 rounded border border-gray-200 dark:border-gray-600 p-2 bg-white/70 dark:bg-black/30">';
                        filesInner += '<p class="text-[11px] font-mono break-all text-violet-800 dark:text-violet-200">' + esc(f.path || '') + '</p>';
                        if (f.resolvedPath && f.resolvedPath !== f.path) {
                            filesInner += '<p class="text-[10px] text-gray-500 dark:text-gray-400 mt-0.5">resolved: <span class="font-mono break-all">' + esc(f.resolvedPath) + '</span></p>';
                        }
                        if (f.readError) filesInner += '<p class="text-xs text-red-600 dark:text-red-400 mt-1">' + esc(f.readError) + '</p>';
                        filesInner += '<p class="text-[10px] text-gray-500 dark:text-gray-400">file ~' + esc(String(f.fileSizeBytes != null ? f.fileSizeBytes : '')) + ' bytes · preview ' + esc(String(f.previewChars != null ? f.previewChars : '')) + ' chars' + (f.previewTruncated ? ' (truncated)' : '') + '</p>';
                        filesInner += '<pre class="mt-1 max-h-48 overflow-auto text-xs whitespace-pre-wrap break-words bg-gray-50 dark:bg-gray-900/80 p-2 rounded">' + esc(f.preview || '') + '</pre>';
                        filesInner += '</div>';
                    });
                } else {
                    filesInner = '<p class="text-xs text-gray-500 dark:text-gray-400">No file previews (ingest skipped or wrote nothing).</p>';
                }
                return '<div class="space-y-3">' +
                    detailCard('Identifiers', idInner) +
                    detailCard('Outcome', outInner) +
                    detailCard('Artifacts (disk preview)', filesInner) +
                    '</div>';
            }
            if (k === 'pm.playground.stream-root') {
                let inputInner = '<p class="text-xs"><span class="font-medium">Session:</span> <code class="text-[11px] break-all">' + esc(o.sessionId || '') + '</code></p>' +
                    '<p class="text-xs"><span class="font-medium">Message:</span> <code class="text-[11px] break-all">' + esc(o.messageId || '') + '</code></p>' +
                    '<p class="text-xs"><span class="font-medium">Selected agent:</span> <code class="text-[11px]">' + esc(o.selectedAgentId || '') + '</code></p>' +
                    '<p class="text-xs"><span class="font-medium">Scenario:</span> <code class="text-[11px]">' + esc(o.scenarioId || '(none)') + '</code></p>' +
                    '<p class="text-xs"><span class="font-medium">Mode:</span> ' + (o.usedScenarioFlow ? 'Scenario flow graph' : 'Single persona stream') + '</p>';

                let outcomeInner = '<p class="text-xs"><span class="font-medium">Status:</span> ' + esc(String(o.status || 'unknown')) + '</p>';
                if (o.responseChars != null) {
                    outcomeInner += '<p class="text-xs"><span class="font-medium">Response length:</span> ' + esc(String(o.responseChars)) + ' chars</p>';
                }
                if (o.ingestAttempted != null) {
                    outcomeInner += '<p class="text-xs"><span class="font-medium">Ingest attempted:</span> ' + esc(String(o.ingestAttempted)) + '</p>';
                }
                if (o.errorMessage) {
                    outcomeInner += '<pre class="max-h-48 overflow-auto text-xs bg-red-50 dark:bg-red-900/20 p-2 rounded border border-red-200 dark:border-red-700 whitespace-pre-wrap break-words">' + esc(o.errorMessage) + '</pre>';
                }

                let chainInner = '<p class="text-xs text-gray-500 dark:text-gray-400">No persona chain recorded.</p>';
                if (o.personaChain && o.personaChain.length) {
                    chainInner = '<ul class="list-disc pl-5 text-xs space-y-0.5">';
                    o.personaChain.forEach(function(p) {
                        chainInner += '<li><code class="text-[11px]">' + esc(p) + '</code></li>';
                    });
                    chainInner += '</ul>';
                    if (o.personaChainTruncated) {
                        chainInner += '<p class="text-xs text-amber-700 dark:text-amber-300">Persona chain truncated.</p>';
                    }
                }

                return '<div class="space-y-3">' +
                    detailCard('Input (stream request context)', inputInner) +
                    detailCard('Outcome', outcomeInner) +
                    detailCard('Persona chain summary', chainInner) +
                    '</div>';
            }
            if (k === 'pm.playground.resolve') {
                const input = o.input || {};
                const ev = o.evidence || {};
                const outcome = o.outcome || {};
                let inputInner = '<p class="text-xs"><span class="font-medium">Surface:</span> <code class="text-[11px]">' + esc(input.surfaceForm || '') + '</code></p>' +
                    '<p class="text-xs"><span class="font-medium">Scope:</span> <code class="text-[11px]">' + esc(input.scope || 'project') + '</code></p>' +
                    '<p class="text-xs"><span class="font-medium">Candidate:</span> <code class="text-[11px]">' + esc(input.candidateEntityKey || '') + '</code></p>' +
                    '<p class="text-xs"><span class="font-medium">Mention id:</span> <code class="text-[11px] break-all">' + esc(input.mentionId || '') + '</code></p>';
                if (input.allCandidates && input.allCandidates.length) {
                    inputInner += '<div class="mt-2"><p class="text-[11px] font-semibold text-gray-600 dark:text-gray-400">Candidates considered</p><ul class="list-disc pl-5 text-xs">';
                    input.allCandidates.forEach(function(c) {
                        inputInner += '<li><code class="text-[11px]">' + esc(c.entityKey) + '</code> surface=' + Number(c.surfaceScore || 0).toFixed(2) + ' unique=' + Number(c.uniquenessScore || 0).toFixed(2) + '</li>';
                    });
                    inputInner += '</ul></div>';
                }
                let evidenceInner = '<p class="text-xs"><span class="font-medium">Confidence:</span> ' + Number(ev.confidence || 0).toFixed(3) + '</p>';
                if (ev.signals && ev.signals.length) {
                    evidenceInner += '<table class="mt-1 text-xs w-full"><thead><tr class="text-left text-gray-500 dark:text-gray-400"><th class="pr-2">kind</th><th class="pr-2">score</th><th class="pr-2">weight</th><th>rationale</th></tr></thead><tbody>';
                    ev.signals.forEach(function(s) {
                        const neg = s.isNegative ? ' text-rose-700 dark:text-rose-300' : '';
                        evidenceInner += '<tr class="align-top' + neg + '"><td class="pr-2 font-mono">' + esc(s.kind) + '</td><td class="pr-2">' + Number(s.score || 0).toFixed(2) + '</td><td class="pr-2">' + Number(s.weight || 0).toFixed(2) + '</td><td>' + esc(s.rationale || '') + '</td></tr>';
                    });
                    evidenceInner += '</tbody></table>';
                } else {
                    evidenceInner += '<p class="text-xs text-gray-500 dark:text-gray-400">No scored signals yet.</p>';
                }
                let outcomeInner = '<p class="text-xs"><span class="font-medium">Edge:</span> <code class="text-[11px] break-all">' + esc(outcome.edgeId || '') + '</code></p>' +
                    '<p class="text-xs"><span class="font-medium">State:</span> <span class="inline-flex items-center rounded px-1.5 py-0.5 text-[10px] font-medium bg-violet-100 text-violet-800 dark:bg-violet-900/40 dark:text-violet-200">' + esc(outcome.state || '') + '</span></p>';
                if (outcome.promotedBy) {
                    outcomeInner += '<p class="text-xs"><span class="font-medium">Promoted by:</span> <code class="text-[11px]">' + esc(outcome.promotedBy) + '</code></p>';
                }
                return '<div class="space-y-3">' +
                    detailCard('Input (candidate + registry slice)', inputInner) +
                    detailCard('Evidence (signals table)', evidenceInner) +
                    detailCard('Outcome (edge state + confidence)', outcomeInner) +
                    '</div>';
            }
            return '<pre class="text-xs whitespace-pre-wrap break-words max-h-96 overflow-auto bg-white/80 dark:bg-black/30 p-2 rounded border">' + esc(JSON.stringify(o, null, 2)) + '</pre>';
        }

        function showEventDetailPanel(root, evt, selectionBase) {
            const panel = root.querySelector('[data-role="event-detail"]');
            const sel = root.querySelector('[data-role="selection"]');
            const label = '#' + String(evt.sequence || '') + ' ' + (evt.label || evt.name || 'Activity');
            if (sel) sel.textContent = (selectionBase ? selectionBase + ' — ' : '') + label;
            if (!panel) return;
            const raw = evt.timelineDetailJson || evt.TimelineDetailJson;
            if (!raw) {
                panel.classList.remove('hidden');
                panel.innerHTML = '<p class="text-gray-600 dark:text-gray-400 text-sm">No drill-down payload for this span.</p>';
                return;
            }
            panel.classList.remove('hidden');
            panel.innerHTML = '<p class="text-xs font-semibold text-violet-900 dark:text-violet-200 mb-2">Details · click another row to switch</p>' + formatTimelineDetailJson(raw);
        }

        function bindTimelineDetailClicks(root) {
            if (root.dataset.agctorTimelineDetailBound === '1') return;
            root.dataset.agctorTimelineDetailBound = '1';
            root.addEventListener('click', function(ev) {
                const hit = ev.target.closest('[data-timeline-idx]');
                if (!hit || !root.contains(hit)) return;
                const idx = Number(hit.getAttribute('data-timeline-idx'));
                if (!Number.isFinite(idx)) return;
                const st = getState(root.id);
                const list = st.data && st.data.events ? st.data.events : [];
                const evt = list[idx];
                if (!evt) return;
                showEventDetailPanel(root, evt, st.options.selectionLabel || '');
            });
        }

        function render(id, data, options) {
            const root = getRoot(id);
            if (!root) return;

            const state = getState(id);
            state.data = data;
            state.options = options || state.options || {};

            const chart = root.querySelector('[data-role="chart"]');
            const status = root.querySelector('[data-role="status"]');
            const details = root.querySelector('[data-role="details"]');
            const emptyMessage = root.dataset.emptyMessage || 'No trace selected.';
            const selectionLabel = state.options.selectionLabel || '';

            if (!data || !Array.isArray(data.events) || data.events.length === 0) {
                renderEmpty(root, state.options.emptyMessage || emptyMessage, selectionLabel);
                return;
            }

            const width = 960;
            const leftPad = 250;
            const rightPad = 24;
            const topPad = 42;
            const rowHeight = 34;
            const plotWidth = width - leftPad - rightPad;
            const events = data.events.slice();
            const totalDuration = Math.max(Number(data.totalDurationMs || 0), 1);
            const chartHeight = Math.max(Number(root.dataset.heightPx || 360), topPad + (events.length * rowHeight) + 24);

            if (status) {
                const durationLabel = totalDuration >= 1000
                    ? (totalDuration / 1000).toFixed(2) + 's'
                    : totalDuration.toFixed(1) + 'ms';
                status.textContent = events.length + ' events across ' + durationLabel;
            }
            applySelection(root, selectionLabel);

            let svg = '';
            svg += '<rect x="0" y="0" width="' + width + '" height="' + chartHeight + '" fill="transparent"></rect>';

            const tickCount = 5;
            for (let i = 0; i <= tickCount; i++) {
                const ratio = i / tickCount;
                const x = leftPad + (ratio * plotWidth);
                const label = (totalDuration * ratio).toFixed(totalDuration > 1000 ? 0 : 1) + 'ms';
                svg += '<line x1="' + x + '" y1="' + (topPad - 18) + '" x2="' + x + '" y2="' + (chartHeight - 16) + '" stroke="#d1d5db" stroke-dasharray="4 4"></line>';
                svg += '<text x="' + x + '" y="18" text-anchor="middle" fill="#6b7280" font-size="12">' + esc(label) + '</text>';
            }

            events.forEach(function(evt, index) {
                const rowTop = topPad + (index * rowHeight);
                const labelX = 12 + (Math.max(0, Number(evt.depth || 0)) * 14);
                const barX = leftPad + ((Number(evt.startOffsetMs || 0) / totalDuration) * plotWidth);
                const barW = Math.max(6, (Number(evt.durationMs || 0) / totalDuration) * plotWidth);
                const fill = colorForDepth(Number(evt.depth || 0), !!evt.hasResult);
                const durationLabel = Number(evt.durationMs || 0).toFixed(1) + 'ms';

                svg += '<line x1="' + leftPad + '" y1="' + (rowTop + 17) + '" x2="' + (width - rightPad) + '" y2="' + (rowTop + 17) + '" stroke="#e5e7eb"></line>';
                svg += '<text x="12" y="' + (rowTop + 14) + '" fill="#6b7280" font-size="11">#' + esc(String(evt.sequence)) + '</text>';
                svg += '<text x="' + labelX + '" y="' + (rowTop + 28) + '" fill="#111827" font-size="12">' + esc(evt.label || evt.name || 'Activity') + '</text>';
                svg += '<g data-timeline-idx="' + index + '" style="cursor:pointer" role="button" tabindex="-1">';
                svg += '<title>' + esc((evt.label || evt.name || 'Activity') + ' | click for details | start ' + Number(evt.startOffsetMs || 0).toFixed(1) + 'ms | duration ' + durationLabel) + '</title>';
                svg += '<rect x="' + barX + '" y="' + (rowTop + 6) + '" width="' + barW + '" height="22" rx="6" fill="' + fill + '" opacity="0.88"></rect>';
                svg += '<text x="' + (barX + 8) + '" y="' + (rowTop + 21) + '" fill="white" font-size="11" pointer-events="none">' + esc(durationLabel) + '</text>';
                svg += '</g>';
            });

            if (chart) {
                chart.setAttribute('height', String(chartHeight));
                chart.setAttribute('viewBox', '0 0 ' + width + ' ' + chartHeight);
                chart.innerHTML = svg;
            }

            if (details) {
                details.innerHTML = events.map(function(evt, index) {
                    const startedAt = evt.startedAtUtc ? new Date(evt.startedAtUtc).toLocaleTimeString() : 'n/a';
                    const hasDetail = !!(evt.timelineDetailJson || evt.TimelineDetailJson);
                    const hint = hasDetail ? 'Click for prompt/output or file previews.' : 'No drill-down payload.';
                    return '<div data-timeline-idx="' + index + '" tabindex="0" role="button" class="p-3 rounded border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/40 cursor-pointer hover:border-violet-400 dark:hover:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-400">' +
                        '<div class="flex flex-wrap items-center justify-between gap-2">' +
                        '<p class="text-sm font-medium text-gray-900 dark:text-white">#' + esc(String(evt.sequence)) + ' ' + esc(evt.label || evt.name || 'Activity') + '</p>' +
                        '<span class="text-xs text-gray-500 dark:text-gray-400">' + esc(startedAt) + '</span>' +
                        '</div>' +
                        '<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">start ' + esc(Number(evt.startOffsetMs || 0).toFixed(1)) + 'ms, duration ' + esc(Number(evt.durationMs || 0).toFixed(1)) + 'ms' + (evt.parentId ? ', parent ' + esc(evt.parentId) : '') + '</p>' +
                        '<p class="mt-1 text-[11px] text-violet-700 dark:text-violet-300">' + esc(hint) + '</p>' +
                        '</div>';
                }).join('');
            }

            const panel = root.querySelector('[data-role="event-detail"]');
            if (panel) {
                panel.classList.add('hidden');
                panel.innerHTML = '';
            }
        }

        async function load(id, traceId, options) {
            const root = getRoot(id);
            if (!root || !traceId) {
                clear(id, options && options.emptyMessage, options && options.selectionLabel);
                return;
            }

            const state = getState(id);
            state.options = options || {};
            const status = root.querySelector('[data-role="status"]');
            applySelection(root, state.options.selectionLabel);
            if (status) status.textContent = 'Loading trace ' + traceId + '…';

            try {
                const response = await fetch('/api/Visualization/trace/' + encodeURIComponent(traceId) + '/timeline');
                if (!response.ok) {
                    renderEmpty(root, state.options.errorMessage || 'Trace timeline is unavailable for this request.', state.options.selectionLabel);
                    return;
                }

                const data = await response.json();
                render(id, data, state.options);
            } catch (_) {
                renderEmpty(root, state.options.errorMessage || 'Failed to load trace timeline.', state.options.selectionLabel);
            }
        }

        function clear(id, message, selectionLabel) {
            const root = getRoot(id);
            if (!root) return;
            renderEmpty(root, message || root.dataset.emptyMessage || 'Select a trace to visualize.', selectionLabel);
        }

        function init(id) {
            const root = getRoot(id);
            if (!root) return;

            bindTimelineDetailClicks(root);
            clear(id);

            const initialTraceId = root.dataset.initialTraceId;
            if (initialTraceId) {
                load(id, initialTraceId);
            }
        }

        window.agctorTraceTimeline = { init, load, clear, render };
        window.addEventListener('resize', function() {
            Object.keys(registry).forEach(function(id) {
                if (registry[id].data) {
                    render(id, registry[id].data);
                }
            });
        });
    }

    window.agctorTraceTimeline.init('@Model.ComponentId');
})();
</script>
