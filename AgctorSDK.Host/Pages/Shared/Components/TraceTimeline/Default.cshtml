@model AgctorSDK.Host.Models.TraceTimelineComponentModel
<div id="@Model.ComponentId"
     data-empty-message="@Model.EmptyMessage"
     data-height-px="@Model.HeightPx"
     data-initial-trace-id="@Model.InitialTraceId"
     class="p-4 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
    <div class="flex flex-wrap items-center justify-between gap-2">
        <div>
            <h3 class="text-base font-semibold text-gray-900 dark:text-white">@Model.Title</h3>
            <p class="text-xs text-gray-500 dark:text-gray-400">Time on X axis, event sequence on Y axis.</p>
        </div>
        <span data-role="status" class="text-xs text-gray-500 dark:text-gray-400">Waiting for trace...</span>
    </div>
    <div class="mt-4 overflow-x-auto">
        <svg data-role="chart"
             class="w-full min-w-[720px] rounded border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/40"
             height="@Model.HeightPx"
             viewBox="0 0 960 @Model.HeightPx"
             preserveAspectRatio="xMinYMin meet"></svg>
    </div>
    <div data-role="details" class="mt-4 space-y-2"></div>
</div>

<script>
(function() {
    if (!window.agctorTraceTimeline) {
        const registry = {};

        function esc(value) {
            const div = document.createElement('div');
            div.textContent = value ?? '';
            return div.innerHTML;
        }

        function getRoot(id) {
            return document.getElementById(id);
        }

        function getState(id) {
            if (!registry[id]) {
                registry[id] = { data: null, options: {} };
            }
            return registry[id];
        }

        function colorForDepth(depth, hasResult) {
            if (depth === 0) return hasResult ? '#7c3aed' : '#8b5cf6';
            if (depth === 1) return hasResult ? '#2563eb' : '#3b82f6';
            if (depth === 2) return hasResult ? '#0891b2' : '#06b6d4';
            return hasResult ? '#059669' : '#10b981';
        }

        function renderEmpty(root, message) {
            const chart = root.querySelector('[data-role="chart"]');
            const status = root.querySelector('[data-role="status"]');
            const details = root.querySelector('[data-role="details"]');
            if (status) status.textContent = message;
            if (chart) {
                chart.innerHTML = '<text x="24" y="40" fill="#6b7280" font-size="14">' + esc(message) + '</text>';
            }
            if (details) {
                details.innerHTML = '<p class="text-sm text-gray-500 dark:text-gray-400">' + esc(message) + '</p>';
            }
        }

        function render(id, data) {
            const root = getRoot(id);
            if (!root) return;

            const state = getState(id);
            state.data = data;

            const chart = root.querySelector('[data-role="chart"]');
            const status = root.querySelector('[data-role="status"]');
            const details = root.querySelector('[data-role="details"]');
            const emptyMessage = root.dataset.emptyMessage || 'No trace selected.';

            if (!data || !Array.isArray(data.events) || data.events.length === 0) {
                renderEmpty(root, emptyMessage);
                return;
            }

            const width = 960;
            const leftPad = 250;
            const rightPad = 24;
            const topPad = 42;
            const rowHeight = 34;
            const plotWidth = width - leftPad - rightPad;
            const events = data.events.slice();
            const totalDuration = Math.max(Number(data.totalDurationMs || 0), 1);
            const chartHeight = Math.max(Number(root.dataset.heightPx || 360), topPad + (events.length * rowHeight) + 24);

            if (status) {
                const durationLabel = totalDuration >= 1000
                    ? (totalDuration / 1000).toFixed(2) + 's'
                    : totalDuration.toFixed(1) + 'ms';
                status.textContent = events.length + ' events across ' + durationLabel;
            }

            let svg = '';
            svg += '<rect x="0" y="0" width="' + width + '" height="' + chartHeight + '" fill="transparent"></rect>';

            const tickCount = 5;
            for (let i = 0; i <= tickCount; i++) {
                const ratio = i / tickCount;
                const x = leftPad + (ratio * plotWidth);
                const label = (totalDuration * ratio).toFixed(totalDuration > 1000 ? 0 : 1) + 'ms';
                svg += '<line x1="' + x + '" y1="' + (topPad - 18) + '" x2="' + x + '" y2="' + (chartHeight - 16) + '" stroke="#d1d5db" stroke-dasharray="4 4"></line>';
                svg += '<text x="' + x + '" y="18" text-anchor="middle" fill="#6b7280" font-size="12">' + esc(label) + '</text>';
            }

            events.forEach(function(evt, index) {
                const rowTop = topPad + (index * rowHeight);
                const labelX = 12 + (Math.max(0, Number(evt.depth || 0)) * 14);
                const barX = leftPad + ((Number(evt.startOffsetMs || 0) / totalDuration) * plotWidth);
                const barW = Math.max(6, (Number(evt.durationMs || 0) / totalDuration) * plotWidth);
                const fill = colorForDepth(Number(evt.depth || 0), !!evt.hasResult);
                const durationLabel = Number(evt.durationMs || 0).toFixed(1) + 'ms';

                svg += '<line x1="' + leftPad + '" y1="' + (rowTop + 17) + '" x2="' + (width - rightPad) + '" y2="' + (rowTop + 17) + '" stroke="#e5e7eb"></line>';
                svg += '<text x="12" y="' + (rowTop + 14) + '" fill="#6b7280" font-size="11">#' + esc(String(evt.sequence)) + '</text>';
                svg += '<text x="' + labelX + '" y="' + (rowTop + 28) + '" fill="#111827" font-size="12">' + esc(evt.label || evt.name || 'Activity') + '</text>';
                svg += '<rect x="' + barX + '" y="' + (rowTop + 6) + '" width="' + barW + '" height="22" rx="6" fill="' + fill + '" opacity="0.88">';
                svg += '<title>' + esc((evt.label || evt.name || 'Activity') + ' | start ' + Number(evt.startOffsetMs || 0).toFixed(1) + 'ms | duration ' + durationLabel) + '</title>';
                svg += '</rect>';
                svg += '<text x="' + (barX + 8) + '" y="' + (rowTop + 21) + '" fill="white" font-size="11">' + esc(durationLabel) + '</text>';
            });

            if (chart) {
                chart.setAttribute('height', String(chartHeight));
                chart.setAttribute('viewBox', '0 0 ' + width + ' ' + chartHeight);
                chart.innerHTML = svg;
            }

            if (details) {
                details.innerHTML = events.map(function(evt) {
                    const startedAt = evt.startedAtUtc ? new Date(evt.startedAtUtc).toLocaleTimeString() : 'n/a';
                    return '<div class="p-3 rounded border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/40">' +
                        '<div class="flex flex-wrap items-center justify-between gap-2">' +
                        '<p class="text-sm font-medium text-gray-900 dark:text-white">#' + esc(String(evt.sequence)) + ' ' + esc(evt.label || evt.name || 'Activity') + '</p>' +
                        '<span class="text-xs text-gray-500 dark:text-gray-400">' + esc(startedAt) + '</span>' +
                        '</div>' +
                        '<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">start ' + esc(Number(evt.startOffsetMs || 0).toFixed(1)) + 'ms, duration ' + esc(Number(evt.durationMs || 0).toFixed(1)) + 'ms' + (evt.parentId ? ', parent ' + esc(evt.parentId) : '') + '</p>' +
                        '</div>';
                }).join('');
            }
        }

        async function load(id, traceId) {
            const root = getRoot(id);
            if (!root || !traceId) {
                clear(id);
                return;
            }

            const status = root.querySelector('[data-role="status"]');
            if (status) status.textContent = 'Loading trace ' + traceId + '…';

            try {
                const response = await fetch('/api/Visualization/trace/' + encodeURIComponent(traceId) + '/timeline');
                if (!response.ok) {
                    renderEmpty(root, 'Trace timeline is unavailable for this request.');
                    return;
                }

                const data = await response.json();
                render(id, data);
            } catch (_) {
                renderEmpty(root, 'Failed to load trace timeline.');
            }
        }

        function clear(id) {
            const root = getRoot(id);
            if (!root) return;
            renderEmpty(root, root.dataset.emptyMessage || 'Select a trace to visualize.');
        }

        function init(id) {
            const root = getRoot(id);
            if (!root) return;

            clear(id);

            const initialTraceId = root.dataset.initialTraceId;
            if (initialTraceId) {
                load(id, initialTraceId);
            }
        }

        window.agctorTraceTimeline = { init, load, clear, render };
        window.addEventListener('resize', function() {
            Object.keys(registry).forEach(function(id) {
                if (registry[id].data) {
                    render(id, registry[id].data);
                }
            });
        });
    }

    window.agctorTraceTimeline.init('@Model.ComponentId');
})();
</script>
