{
  "version": 1,
  "scenarios": [
    {
      "id": "people",
      "displayName": "People / person",
      "description": "Chat and session memory oriented around people workflows.",
      "kind": "declarative",
      "agentTypes": [
        "SessionCoordinatorAgent",
        "SessionMemoryAgent"
      ],
      "personaAgentIds": [
        "person-extractor",
        "memory-curator",
        "person-query"
      ],
      "personaBindings": {
        "extractor": "person-extractor",
        "curator": "memory-curator",
        "query": "person-query"
      }
    },
    {
      "id": "code-generation-chain",
      "displayName": "Code generation chain",
      "description": "Creates Root Agent -> LLM Agent with CodeExecutor tool for code generation and validation",
      "kind": "scripted",
      "handler": "CodeGenerationChainScenario",
      "agentTypes": [
        "Agent",
        "LLMAgent"
      ]
    },
    {
      "id": "code-graph-demo",
      "displayName": "Code graph demo",
      "description": "Creates a minimal CodeGraph with an IndexerAgent that indexes sample files",
      "kind": "scripted",
      "handler": "CodeGraphDemoScenario",
      "agentTypes": [
        "Agent",
        "LLMAgent",
        "CoderAgent",
        "SessionCoordinatorAgent"
      ]
    },
    {
      "id": "scene-video-chain",
      "displayName": "Scene Memory \u2014 video sequence",
      "description": "Plan a sequence from your prompt with specialist agents (Director, Planner, Project, Memory, Render, Visual critic, Editor, Audio Engineer). Maintain Scene Memory and ask Cynelo to render consecutive clips.",
      "kind": "declarative",
      "agentTypes": [],
      "flow": {
        "schemaVersion": "1.0",
        "graphId": "scene-video-chain",
        "name": "Scene video sequence",
        "outputPolicy": "first_non_empty",
        "nodes": [
          {
            "id": "input",
            "type": "ChatInput",
            "label": "Your idea"
          },
          {
            "id": "director",
            "type": "AgentLoop",
            "label": "Director",
            "config": {
              "workflow": "scene-video",
              "maxAttempts": 3,
              "role": "director",
              "instructions": "Keep identities, locations, props and actions consistent across clips. Ask the creator when essential story intent is unclear."
            }
          },
          {
            "id": "planner",
            "type": "AgentLoop",
            "label": "Planner",
            "config": {
              "workflow": "scene-video",
              "role": "planner"
            }
          },
          {
            "id": "project",
            "type": "AgentLoop",
            "label": "Project",
            "config": {
              "workflow": "scene-video",
              "role": "project"
            }
          },
          {
            "id": "memory",
            "type": "AgentLoop",
            "label": "Memory agent",
            "config": {
              "workflow": "scene-video",
              "role": "memory"
            }
          },
          {
            "id": "render",
            "type": "AgentLoop",
            "label": "Render",
            "config": {
              "workflow": "scene-video",
              "role": "render"
            }
          },
          {
            "id": "visual-critic",
            "type": "AgentLoop",
            "label": "Visual critic",
            "config": {
              "workflow": "scene-video",
              "role": "visual-critic"
            }
          },
          {
            "id": "editor",
            "type": "AgentLoop",
            "label": "Editor",
            "config": {
              "workflow": "scene-video",
              "role": "editor"
            }
          },
          {
            "id": "audio-engineer",
            "type": "AgentLoop",
            "label": "Audio Engineer",
            "config": {
              "workflow": "scene-video",
              "role": "audio-engineer"
            }
          },
          {
            "id": "ollama",
            "type": "Capability",
            "label": "Ollama",
            "config": {
              "kind": "llm",
              "detail": "Planning / review model",
              "ownerRole": "planner"
            }
          },
          {
            "id": "scene-memory",
            "type": "Capability",
            "label": "Scene Memory",
            "config": {
              "kind": "memory",
              "detail": "Recorded facts",
              "ownerRole": "memory"
            }
          },
          {
            "id": "audio-production",
            "type": "Capability",
            "label": "Audio production",
            "config": {
              "kind": "tool",
              "detail": "Cynelo API",
              "ownerRole": "audio-engineer"
            }
          },
          {
            "id": "speech-inspection",
            "type": "Capability",
            "label": "Speech inspection",
            "config": {
              "kind": "tool",
              "detail": "Cynelo API",
              "ownerRole": "audio-engineer"
            }
          },
          {
            "id": "frame-sampler",
            "type": "Capability",
            "label": "Frame sampler",
            "config": {
              "kind": "tool",
              "detail": "Cynelo API",
              "ownerRole": "render"
            }
          },
          {
            "id": "video-rendering",
            "type": "Capability",
            "label": "Video rendering",
            "config": {
              "kind": "tool",
              "detail": "Cynelo API",
              "ownerRole": "render"
            }
          },
          {
            "id": "project-storage",
            "type": "Capability",
            "label": "Project storage",
            "config": {
              "kind": "tool",
              "detail": "Cynelo API",
              "ownerRole": "project"
            }
          },
          {
            "id": "story-storage",
            "type": "Capability",
            "label": "Story storage",
            "config": {
              "kind": "tool",
              "detail": "Cynelo API",
              "ownerRole": "memory"
            }
          },
          {
            "id": "film-assembly",
            "type": "Capability",
            "label": "Film assembly",
            "config": {
              "kind": "tool",
              "detail": "Cynelo API",
              "ownerRole": "editor"
            }
          },
          {
            "id": "output",
            "type": "Output",
            "label": "Finished video with reviewed audio"
          }
        ],
        "edges": [
