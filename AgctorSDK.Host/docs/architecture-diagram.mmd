graph TB
    subgraph AgctorSDK_Host [AgctorSDK.Host]
        subgraph HTTP_API [HTTP API]
            AgentsCtrl[AgentsController /api/agents]
            DefsCtrl[AgentsDefinitionsController /api/agents/definitions]
            GoalsCtrl[GoalsController]
            ToolsCtrl[ToolsController]
            RuntimeCtrl[RuntimeController]
            ConfigCtrl[ConfigController]
            LlmCtrl[LlmController]
            ScenariosCtrl[ScenariosController /api/scenarios]
            TestCtrl[TestController]
            CodeGraphCtrl[CodeGraphController]
            ChatProjCtrl[ChatProjectsController]
            ChatSessCtrl[ChatSessionsController]
            VizCtrl[VisualizationController]
            PmCtrl[ProjectMemoryController /api/project-memory]
            ResCtrl[ResolutionReviewController /api/project-memory/resolution]
            Swagger[Swagger OpenAPI]
        end

        subgraph MCP [MCP]
            McpListener[McpListener TCP JSON to MessageDispatcher]
        end

        subgraph Host_Services [Host services]
            MessageDispatcher[MessageDispatcher]
            SessionStore[SqliteSessionStore]
            TraceStore[SqliteTraceTimelineStore]
            AgctorToolCatalog[AgctorToolCatalog]
            ToolInvoker[ToolInvoker]
            ToolAgentsInsight[ToolAgentsInsightService]
            ScenarioServices[Scenario catalog factory application]
            PmServices[Project memory file YAML Ollama helpers]
            PlaygroundTrace[Playground SSE plus trace timeline UX]
        end

        subgraph Background [Background work]
            TaskScoper[TaskScoperHostedService]
            TaskFlow[TaskFlowHostedService]
        end

        ProgramCS[Program.cs DI and pipeline]
    end

    subgraph Framework [Referenced SDK projects]
        Core[AgctorSDK.Core]
        Agents[AgctorSDK.Agents]
        Tools[AgctorSDK.Tools]
        Ext[AgctorSDK.Extensions]
        Cg[AgctorSDK.CodeGraph]
    end

    subgraph External [Callers and systems]
        Browser[Browser or API clients]
        McpClient[MCP clients]
    end

    Browser --> HTTP_API
    McpClient --> MCP
    AgentsCtrl --> MessageDispatcher
    PmCtrl --> PmServices
    PmCtrl --> PlaygroundTrace
    ResCtrl --> Core
    DefsCtrl --> ToolAgentsInsight
    ToolsCtrl --> ToolInvoker
    ToolsCtrl --> ToolAgentsInsight
    ToolInvoker --> AgctorToolCatalog
    ToolAgentsInsight --> AgctorToolCatalog
    ChatSessCtrl --> SessionStore
    VizCtrl --> TraceStore
    VizCtrl --> PlaygroundTrace
    MessageDispatcher --> Agents
    ToolInvoker --> Tools
    TaskScoper --> Core
    TaskFlow --> Core
    ProgramCS --> Ext

    style AgctorSDK_Host fill:#e1f5ff
    style MCP fill:#fff9c4
