classDiagram
    class AgentsController {
        -IAgentFactory _factory
        -IAgentRegistry _registry
        -IAgentTypeEnablementService _agentTypeEnablement
        -IActorRuntimeAdapter _runtime
        -IAgentOutputStreamRegistry _streamRegistry
        +CreateAgent(request) ActionResult
        +ListAgents() ActionResult
        +SetAgentTypeEnabled(typeName, request) ActionResult
        +GetAgent(agentId) ActionResult
        +SendMessage(agentId, request) ActionResult
        +SendMessageStream(agentId, request) Task
        +HealthCheck() ActionResult
    }

    class AgentOutputStreamRegistry {
        +Register(streamId, writer) IDisposable
        +Publish(streamId, evt) void
    }

    class AgentTypeEnablementService {
        +GetEffectiveEnablement(registered) dict
        +IsTypeEnabled(logicalKey) bool
        +SetTypeEnabledAsync(key, enabled) Task
        +StopAgentsOfLogicalTypeAsync(key) Task
    }

    class HostConfigurationService {
        +GetConfigurationAsync() Task
    }

    class GoalsController {
        -IGoalStore _store
        +ListGoals() ActionResult
        +GetGoal(id) ActionResult
        +CreateGoal(request) ActionResult
        +UpdateGoal(id, request) ActionResult
        +DeleteGoal(id) ActionResult
    }

    class ToolsController {
        -ToolInvoker _invoker
        +InvokeTool(toolId, request) ActionResult
        +ListTools() ActionResult
        +GetTool(toolId) ActionResult
        +BatchInvoke(request) ActionResult
        +HealthCheck() ActionResult
    }

    class TestController {
        -IScenarioFactory _scenarioFactory
        -IConfiguration _configuration
        +SetupScenario(request) ActionResult
        +ListScenarios() ActionResult
        +GetScenario(name) ActionResult
    }

    class CodeGraphController {
        -ICodeGraphContextAccessor _contextAccessor
        +GetCurrentAsync() ActionResult
        +GetEmbeddingsAsync() ActionResult
        +GetFileContentAsync(path) ActionResult
    }

    class ChatSessionsController {
        -ISessionStore _sessionStore
        +CreateAsync(request) ActionResult
        +ListAsync(limit, offset) ActionResult
        +GetAsync(sessionId, lastTurns) ActionResult
    }

    class VisualizationController {
        -IVisualizationService _visualizationService
        -ISessionStore _sessionStore
        -ITraceTimelineStore _traceTimelineStore
        +GetTimelineAsync(traceId) ActionResult
        +GetTimelineByMessageAsync(sessionId, turnId) ActionResult
        +GetTimelineByTurnAsync(sessionId, turnId) ActionResult
    }

    class EmbeddingStoreViewComponent {
        +Invoke(componentId, title, description) IViewComponentResult
    }

    class AgentChatViewComponent {
        +Invoke(componentId, title, helpText) IViewComponentResult
    }

    class ActorTreeViewComponent {
        +Invoke(componentId, title, description, emptyMessage) IViewComponentResult
    }

    class TraceTimelineViewComponent {
        +Invoke(componentId, title, emptyMessage, heightPx) IViewComponentResult
    }

    class EmbeddingDebugViewComponent {
        +Invoke(componentId, title, description) IViewComponentResult
    }

    class RawJsonViewComponent {
        +Invoke(componentId, title) IViewComponentResult
    }

    class McpListener {
        -IActorRuntimeAdapter _runtime
        -int _port
        +StartAsync(ct) Task
        +StopAsync(ct) Task
    }

    class MessageDispatcher {
        -IActorRuntimeAdapter _runtime
        -ISessionStore _sessionStore
        -ITraceTimelineStore _traceTimelineStore
        -IAgentOutputStreamRegistry _streamRegistry
        +SendMessageAsync(agentId, request, streamId)
    }

    class SqliteSessionStore {
        +AppendTurnAsync(turn) Task
        +GetTraceLinksAsync(sessionId) Task
        +UpsertTraceLinkAsync(traceLink) Task
    }

    class SqliteTraceTimelineStore {
        +SaveAsync(timeline) Task
        +GetAsync(traceId) Task
    }

    class SessionTraceLink {
        +TraceLinkId string
        +SessionId string
        +TurnGroupId string
        +RequestTurnId string
        +ResponseTurnId string
        +PrimaryTraceId string
    }

    class ToolInvoker {
        -IServiceProvider _provider
        +InvokeAsync(toolId, request) ToolResult
    }

    class IScenarioFactory {
        <<interface>>
        +CreateScenario(name) IScenario
        +GetAvailableScenarios() IEnumerable
    }

    class ScenarioFactory {
        +CreateScenario(name) IScenario
        +GetAvailableScenarios() IEnumerable
    }

    class CurrentScenarioStore {
        +GetCurrentScenarioName() string
        +GetCurrentScenarioDescription() string
        +SetCurrentScenario(name, description)
        +Clear()
    }

    class IScenario {
        <<interface>>
        +string Name
        +string Description
        +SetupAsync(runtime, factory) Task
    }

    class TaskScoperHostedService {
        -IGoalStore _goalStore
        -ITaskStore _taskStore
        -IAgentFactory _factory
        +ExecuteAsync(ct) Task
    }

    class TaskFlowHostedService {
        -TaskFlowEngine _engine
        -ITaskStore _store
        +ExecuteAsync(ct) Task
    }

