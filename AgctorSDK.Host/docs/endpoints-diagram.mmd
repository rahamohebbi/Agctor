graph LR
    subgraph "HTTP REST API"
        subgraph "Config PRD006"
            GetConfig["GET /api/Config<br/>Host configuration"]
        end

        subgraph "Agents /api/agents"
            CreateAgent["POST /api/agents<br/>Create agent"]
            ListAgents["GET /api/agents<br/>List all agents"]
            GetAgent["GET /api/agents/id<br/>Get agent info"]
            GetAgentDetail["GET /api/agents/id/detail<br/>Agent detail PRD006"]
            SendMsg["POST /api/agents/id/message<br/>Send message"]
            AgentHealth["GET /api/agents/health<br/>Health check"]
        end

        subgraph "Goals /api/goals"
            ListGoals["GET /api/goals<br/>List all goals"]
