            CreateGoal["POST /api/goals<br/>Create goal"]
            UpdateGoal["PUT /api/goals/id<br/>Update goal"]
            DeleteGoal["DELETE /api/goals/id<br/>Delete goal"]
        end

        subgraph "Tools /api/tools"
            ListTools["GET /api/tools<br/>List available tools"]
