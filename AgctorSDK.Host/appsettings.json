{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AgctorSDK.Host": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Mcp": {
    "Host": "0.0.0.0",
    "Port": 8080
  },
  "Swagger": {
    "Title": "AGCTOR Host API",
    "Version": "v1",
    "Description": "HTTP + MCP Integration Gateway for the AGCTOR Agent Framework"
  },
  "Agctor": {
    "DefaultRuntime": "InMemory",
    "AllowExperimentalRuntimes": false,
    "ProtoHost": "127.0.0.1",
    "ProtoPort": 12000,
    "GeneratedCodeRoot": "/tmp/agctor-generated-code",
    "Dashboard": {
      "ScenarioName": "code-graph-demo"
    },
    "LLM": {
      "OllamaApiUrl": "http://localhost:11434",
      "DefaultModel": "ministral-3:latest",
      "VisionModel": "gemma4:31b",
      "VisionFallbackModels": ["gemma4:e4b"],
      "VisionTimeoutSeconds": 300,
      "MaxVisualEdgePixels": 1024,
      "VisualTokenBudget": 280,
      "ExtractPromptVersion": "visual-extract-v1"
    },
    "ProjectMemory": {
      "ProjectRoot": ""
    },
    "ScenarioFlow": {
      "InboxInGraph": false,
      "LlmNodeTimeoutSeconds": 600
    },
    "Visual": {
      "Provider": "file",
      "Endpoint": "http://localhost:9000",
      "Bucket": "agctor-visual",
      "Region": "us-east-1",
      "ForcePathStyle": true,
      "MaxUploadBytes": 15728640,
      "MaxAttachmentsPerTurn": 5,
      "PresignedUploadExpirySeconds": 900,
      "PresignedViewExpirySeconds": 900,
      "DefaultVisualContextPhotos": 3,
      "MaxVisualContextPhotos": 12
    },
    "Scenarios": {
      "DefaultFile": "Config/agctor-scenarios.json",
      "UserFile": "Config/agctor-scenarios.user.json"
    }
  },
  "TaskScoper": {
    "ScanInterval": 30
  },
  "TaskFlow": { "Interval": 10 }
} 