<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>AgctorSDK.Core.IntegrationTests</AssemblyName>
    <RootNamespace>AgctorSDK.Core.IntegrationTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.2.2" />
    <PackageReference Include="MSTest.TestFramework" Version="3.2.2" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="OpenTelemetry" Version="1.6.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.6.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the project containing LLMAgent and its Agctor.Core stubs -->
    <ProjectReference Include="../AgctorSDK.Core/AgctorSDK.Core.csproj" />
    <ProjectReference Include="..\AgctorSDK.Agents\AgctorSDK.Agents.csproj" />
    <ProjectReference Include="..\AgctorSDK.Tools\AgctorSDK.Tools.csproj" />
    <ProjectReference Include="..\AgctorSDK.Extensions\AgctorSDK.Extensions.csproj" />
  </ItemGroup>

</Project> 