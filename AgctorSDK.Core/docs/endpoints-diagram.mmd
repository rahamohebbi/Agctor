graph LR
    subgraph "Actor Lifecycle API"
        Init["IActor.InitializeAsync"]
        Receive["IActor.ReceiveAsync<br/>IMessageEnvelope"]
        Shutdown["IActor.ShutdownAsync"]
    end

    subgraph "Agent API"
        ProcessPrompt["IAgent.ProcessPromptAsync<br/>prompt string"]
        AssignSubtask["IAgent.AssignSubtaskAsync<br/>subtaskPrompt, agentType"]
        HandleComplete["IAgent.HandleSubtaskCompletionAsync<br/>childId, result"]
        HandleFail["IAgent.HandleSubtaskFailureAsync<br/>childId, error"]
    end

    subgraph "Factory API"
        Spawn["IAgentFactory.SpawnAgentAsync<br/>agentType, prompt, parentId"]
        Stop["IAgentFactory.StopAgentAsync<br/>agentId"]
        GetAgent["IAgentFactory.GetAgentAsync<br/>agentId"]
        GenId["IAgentFactory.GenerateAgentId<br/>typeName, parentId"]
    end

    subgraph "Runtime Adapter API"
        RtInit["InitializeAsync<br/>config"]
        RtSpawn["SpawnActorAsync<br/>actorId, initData"]
        RtSend["SendMessageAsync<br/>targetId, message, headers"]
        RtSendResp["SendMessageAsync TResponse<br/>targetId, message, timeout"]
        RtStop["StopActorAsync<br/>actorId"]
        RtStats["GetStatisticsAsync"]
        RtHuman["RequestHumanInputAsync<br/>agentId, prompt"]
    end

    subgraph "Registry API"
        Register["RegisterAgentAsync<br/>agent"]
        Unregister["UnregisterAgentAsync<br/>agentId"]
        GetById["GetAgentByIdAsync<br/>agentId"]
        GetAll["GetAllAgentIdsAsync"]
        GetRoot["GetRootAgentIdsAsync"]
    end

    subgraph "Task API"
        TaskCreate["ITaskStore.CreateAsync<br/>task"]
        TaskGet["ITaskStore.GetByIdAsync<br/>id"]
        TaskGetAll["ITaskStore.GetAllAsync"]
        TaskUpdate["ITaskStore.UpdateAsync<br/>task"]
        TaskExec["ITaskExecutor.ExecuteAsync<br/>task"]
        FlowRun["TaskFlowEngine.RunAsync<br/>goalId"]
    end

    subgraph "Goal API"
        GoalCreate["IGoalStore.CreateAsync<br/>goal"]
        GoalGet["IGoalStore.GetByIdAsync<br/>id"]
        GoalGetAll["IGoalStore.GetAllAsync"]
        GoalUpdate["IGoalStore.UpdateAsync<br/>goal"]
    end

    subgraph "Timeout API"
        TRegister["RegisterTimeoutAsync<br/>agentId, operationId, context"]
        TCancel["CancelTimeoutAsync<br/>agentId, operationId"]
        TUpdate["UpdateProgressAsync<br/>agentId, operationId, progress"]
        TCheck["CheckTimeoutAsync<br/>agentId, operationId"]
    end

    subgraph "Observability API"
        MetricsInc["IMetricsCollector.IncrementCounter"]
        MetricsGauge["IMetricsCollector.RecordGauge"]
        MetricsHist["IMetricsCollector.RecordHistogram"]
        TraceStart["IActivityTracker.StartActivity"]
        VisHierarchy["IVisualizationService<br/>.GenerateAgentHierarchyMermaidDiagramAsync"]
        VisFlow["IVisualizationService<br/>.GenerateMessageFlowMermaidDiagramAsync"]
    end

    %% Flow
    Spawn --> RtSpawn
    ProcessPrompt --> AssignSubtask
    AssignSubtask --> Spawn
    RtSend --> Receive
    HandleComplete --> ProcessPrompt
    FlowRun --> TaskExec

    style Receive fill:#e1f5ff
    style ProcessPrompt fill:#b3e5fc
    style Spawn fill:#fff9c4
    style RtSend fill:#f3e5f5
    style FlowRun fill:#e8f5e9
