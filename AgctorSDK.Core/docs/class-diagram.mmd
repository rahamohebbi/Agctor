classDiagram
    class IActor {
        <<interface>>
        +string Id
        +string ActorType
        +ActorState State
        +InitializeAsync()
        +ReceiveAsync(envelope)
        +ShutdownAsync()
    }

    class IAgent {
        <<interface>>
        +AgentStatus Status
        +string? CurrentPrompt
        +string? ParentAgentId
        +IReadOnlyList ChildAgentIds
        +ProcessPromptAsync(prompt)
        +AssignSubtaskAsync(subtaskPrompt)
        +HandleSubtaskCompletionAsync(childId, result)
        +HandleSubtaskFailureAsync(childId, error)
        +SetAgentFactory(factory)
    }

    class IAgentFactory {
        <<interface>>
        +IActorRuntimeAdapter RuntimeAdapter
        +SpawnAgentAsync(agentType, prompt, parentId)
        +StopAgentAsync(agentId)
        +GetAgentAsync(agentId)
        +GenerateAgentId(typeName, parentId)
    }

    class IAgentRegistry {
        <<interface>>
        +RegisterAgentAsync(agent)
        +UnregisterAgentAsync(agentId)
        +GetAgentByIdAsync(agentId)
        +GetAllAgentIdsAsync()
        +GetRootAgentIdsAsync()
    }

    class IActorRuntimeAdapter {
        <<interface>>
        +string Name
        +bool IsInitialized
        +InitializeAsync(config)
        +SpawnActorAsync(actorId, initData)
        +SendMessageAsync(targetId, message)
        +SendMessageAsync~TResponse~(targetId, message, timeout)
        +StopActorAsync(actorId)
        +GetStatisticsAsync()
        +RequestHumanInputAsync(agentId, prompt, instructions)
    }

    class IMessageEnvelope {
        <<interface>>
        +string Id
        +object Payload
        +IDictionary Metadata
        +IDictionary Headers
        +WithPayload(payload)
        +WithHeaders(headers)
        +WithMetadata(key, value)
    }

    class MessageEnvelope {
        +string Id
        +object Payload
        +IDictionary Metadata
        +IDictionary Headers
    }

    class ITimeoutSupervisor {
        <<interface>>
        +RegisterTimeoutAsync(agentId, operationId, context)
        +CancelTimeoutAsync(agentId, operationId)
        +UpdateProgressAsync(agentId, operationId, progress)
        +CheckTimeoutAsync(agentId, operationId)
    }

    class ITimeoutPolicy {
        <<interface>>
        +GetTimeout(context)
        +ShouldReschedule(context, progress)
        +ShouldAbort(context, state)
    }

    class TimeoutSupervisorActor {
        +RegisterTimeoutAsync(agentId, operationId, context)
        +CancelTimeoutAsync(agentId, operationId)
        +ReceiveAsync(envelope)
    }

    class ProjectTask {
        +Guid Id
        +string Title
        +string? Description
        +TaskStatus Status
        +Guid? GoalId
        +List~Guid~ DependsOn
    }

    class ITaskStore {
        <<interface>>
        +CreateAsync(task)
        +GetByIdAsync(id)
        +GetAllAsync()
        +UpdateAsync(task)
        +DeleteAsync(id)
    }

    class ITaskExecutor {
        <<interface>>
        +ExecuteAsync(task)
    }

    class TaskFlowEngine {
        -ITaskStore _store
        -ITaskExecutor _executor
        +RunAsync(goalId)
    }

    class Goal {
        +Guid Id
        +string Title
        +string? Description
        +GoalStatus Status
    }

    class IGoalStore {
        <<interface>>
        +CreateAsync(goal)
        +GetByIdAsync(id)
        +GetAllAsync()
        +UpdateAsync(goal)
        +DeleteAsync(id)
    }

    class ICodeGenerator {
        <<interface>>
        +GenerateAsync(task)
    }

    class IEventStore {
        <<interface>>
        +RecordAsync(event)
        +QueryAsync(promptHash)
    }

    class IGitService {
        <<interface>>
        +CreateBranchAsync(name)
        +CommitAsync(message, paths)
        +CreatePullRequestAsync(info)
    }

    class IMetricsCollector {
        <<interface>>
        +IncrementCounter(name, value, tags)
        +RecordGauge(name, value, tags)
        +RecordHistogram(name, value, tags)
        +TimeOperation(name, tags)
    }

    class IActivityTracker {
        <<interface>>
        +StartActivity(name, tags)
        +PropagateContext(headers)
        +ExtractContext()
    }

    class IVisualizationService {
        <<interface>>
        +GenerateAgentHierarchyMermaidDiagramAsync(rootId)
        +GenerateMessageFlowMermaidDiagramAsync(traceId)
        +GenerateVisualizationHtmlAsync(hierarchy, flow)
    }

    class InMemoryAgentRegistry {
        +RegisterAgentAsync(agent)
        +GetAgentByIdAsync(agentId)
        +GetAllAgentsAsync()
    }

    IActor <|-- IAgent
    IMessageEnvelope <|.. MessageEnvelope
    IAgentRegistry <|.. InMemoryAgentRegistry
    ITimeoutSupervisor <|.. TimeoutSupervisorActor
    IActor <|.. TimeoutSupervisorActor
    TaskFlowEngine --> ITaskStore : uses
    TaskFlowEngine --> ITaskExecutor : uses
    IAgentFactory --> IActorRuntimeAdapter : uses
    IAgentFactory --> IAgentRegistry : uses
