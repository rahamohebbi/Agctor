flowchart TB
    subgraph into [Clients call Agctor]
        direction TB
        client([TCP client])
        listen["Host listener<br/>127.0.0.1:8080"]
        dispatch["Message dispatcher"]
        named["Named agent"]
        client -->|JSON line| listen
        listen --> dispatch
        dispatch -->|message| named
    end

    subgraph outto [Agctor calls Cognee]
        direction TB
        person["Person-query agent"]
        memory["Person memory tool"]
        rag["Rag context"]
        cognee["Cognee server<br/>HTTP /mcp"]
        person -->|BuildContext| memory
        memory --> rag
        rag -->|recall| cognee
    end

    %% Invisible link keeps the client lane above Cognee.
    into ~~~ outto

