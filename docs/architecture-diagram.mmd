graph TB
    subgraph consumers [Consumers]
        HTTPClient[HTTP clients and dashboard]
        MCPClient[MCP TCP clients]
        CLIUser[AgctorCLI users]
    end

    subgraph app [Application hosts]
        subgraph host [AgctorSDK.Host]
            Http["HTTP API default http://localhost:5274 unless ASPNETCORE_URLS set"]
            Swagger[Swagger UI at /swagger]
            Mcp["McpListener TCP Mcp:Port default 8080 JSON messages"]
            Ctrls["Controllers agents goals tools scenarios test chat project-memory resolution visualization CodeGraph Llm Config Runtime"]
            Svcs["MessageDispatcher Sqlite session and trace stores ToolInvoker scenarios"]
            Bg["TaskScoperHostedService TaskFlowHostedService"]
        end
        subgraph cli [AgctorCLI]
            CliApp[Single-prompt runner]
        end
    end

    subgraph ext [AgctorSDK.Extensions]
        Di["ServiceCollectionExtensions AddAgctor variants"]
        Factory[IActorRuntimeAdapterFactory ActorRuntimeAdapterFactory]
        Feat[Code graph generation PR automation activity tracking]
    end

    subgraph intel [Agents and code intelligence]
        subgraph agents [AgctorSDK.Agents]
            RuntimeImpl[InMemoryActorRuntime ProtoActorAdapter OrleansAdapter]
            Af[AgentFactory AgentRegistry]
            Ag[Agent LLMAgent CoderAgent session and project-memory agents]
        end
        subgraph cg [AgctorSDK.CodeGraph]
            Graph[Graph actors Indexer Search Query Refactor and snippet resolver]
        end
    end

    subgraph tools [AgctorSDK.Tools]
        ToolActors[CodeEditor CodeExecutor Compile Format TestRunner FileSystem tools]
    end

    subgraph core [AgctorSDK.Core]
        Abstractions[IActor IAgent messages goals tasks project memory resolution interfaces]
        ObsCore[Logging activity metrics visualization helpers]
    end

    subgraph external [External]
        Ollama[Ollama LLM and embeddings]
        Roslyn[Roslyn analysis]
        OTelBack[OpenTelemetry backends optional]
        FS[File system and git]
    end

    HTTPClient --> Http
    HTTPClient --> Swagger
    MCPClient --> Mcp
    CLIUser --> CliApp

    Http --> Di
    CliApp --> Di
    Mcp --> Svcs
    Ctrls --> Svcs
    Bg --> Abstractions

    Di --> Factory
    Di --> Af
    Factory --> RuntimeImpl
    Af --> Ag
    Ag --> Abstractions
    RuntimeImpl --> Abstractions
    ToolActors --> Ag
    ToolActors --> Abstractions
    Graph --> Ag
    Graph --> Abstractions

    Ag --> Ollama
    Graph --> Ollama
    ToolActors --> Roslyn
    ObsCore --> OTelBack
    Abstractions --> FS

    style core fill:#e1f5ff
    style host fill:#fff9c4
    style agents fill:#b3e5fc
