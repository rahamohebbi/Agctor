# Copy to graphiti.env and configure before starting the Graphiti sidecar.
# See https://help.getzep.com/graphiti and https://github.com/getzep/graphiti
#
# Neo4j auth must match docker-compose graphiti-db (defaults below).
# LLM: OpenAI by default, or point OPENAI_BASE_URL at Ollama on the host.
#
# Ollama (optional — same models as LightRAG/Cognee):
#   ollama pull gemma3:4b
#   ollama pull bge-m3:latest
#   OPENAI_API_KEY=ollama
#   OPENAI_BASE_URL=http://host.docker.internal:11434/v1
#   MODEL_NAME=gemma3:4b
#   EMBEDDING_MODEL_NAME=bge-m3:latest

OPENAI_API_KEY=sk-replace-me
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# MODEL_NAME=gemma3:4b
# EMBEDDING_MODEL_NAME=bge-m3:latest

NEO4J_URI=bolt://graphiti-db:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=agctor-graphiti
db_backend=neo4j
PORT=8000
