# Copy to lightrag.env and configure before starting the LightRAG sidecar.
# See https://github.com/HKUDS/LightRAG/blob/main/env.example
#
# Prerequisites (host Ollama): run ./setup-ollama-models.sh or:
#   ollama pull gemma3:4b
#   ollama pull bge-m3:latest

HOST=0.0.0.0
PORT=9621
WORKING_DIR=/app/data/rag_storage
INPUT_DIR=/app/data/inputs
LLM_BINDING=ollama
LLM_BINDING_HOST=http://host.docker.internal:11434
LLM_MODEL=gemma3:4b
EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://host.docker.internal:11434
EMBEDDING_MODEL=bge-m3:latest
# LIGHTRAG_API_KEY=optional-local-key
