# Copy to cognee.env before starting the Cognee MCP sidecar.
# See https://github.com/topoteretes/cognee/blob/main/.env.template
#
# Ollama (free, local) — same models as lightrag.env.example.
# LLM_API_KEY is required by Cognee config but use the literal value "ollama" (not a paid key).
# Prerequisites: run ./setup-ollama-models.sh on the host before starting this sidecar.

LLM_API_KEY=ollama
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b
LLM_ENDPOINT=http://host.docker.internal:11434/v1
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_ENDPOINT=http://host.docker.internal:11434/api/embed
EMBEDDING_DIMENSIONS=1024
# Tokenizer repo ID for bge-m3 — required by Cognee when EMBEDDING_PROVIDER=ollama.
HUGGINGFACE_TOKENIZER=BAAI/bge-m3

# --- OpenAI (paid API) — uncomment and remove Ollama block above if you prefer cloud ---
# LLM_API_KEY=sk-your-openai-key
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
