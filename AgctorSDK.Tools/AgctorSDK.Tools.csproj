<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>Tool actors for Agctor, including in-process C# and Python execution and filesystem access.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Language executors live in this assembly, not Core. -->
    <PackageReference Include="IronPython" Version="3.4.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgctorSDK.Core\AgctorSDK.Core.csproj" />
    <ProjectReference Include="..\AgctorSDK.Agents\AgctorSDK.Agents.csproj" />
  </ItemGroup>

</Project> 