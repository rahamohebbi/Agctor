using System;
using System.Threading.Tasks;
using System.IO;
using System.Text;
using System.Threading;
using System.Collections.Generic;
using System.Diagnostics;
using Microsoft.Extensions.DependencyInjection;
using AgctorSDK.Core.DependencyInjection;
using AgctorSDK.Core.Interfaces;
using AgctorSDK.Core.Utils.Logging;
using AgctorSDK.Core.Utils.Observability.Visualization;
using AgctorSDK.Core.Utils.ActivityTracking;
using AgctorSDK.Core.Utils.ActivityTracking.Logger;
using AgctorSDK.Core.Agents;
using AgctorSDK.Core.Messages;
using AgctorSDK.Core.Actors;
using OpenTelemetry;
using OpenTelemetry.Resources;
using OpenTelemetry.Trace;

namespace AgctorSDK.VisualizationExample
{
    /// <summary>
    /// Demonstrates the Agctor visualization capabilities.
    /// </summary>
    class VisualizationExample
    {
        // Define a static ActivitySource for OpenTelemetry
        private static readonly ActivitySource ActivitySource = new ActivitySource("Agctor.VisualizationDemo", "1.0.0");
        
        static async Task Main(string[] args)
        {
            Console.WriteLine("=== Agctor Visualization Example ===\n");
            Console.WriteLine("1. Run simplified visualization demo");
            Console.WriteLine("2. Run full visualization demo (with DI)");
            Console.Write("Choose an option (1-2): ");
            
            string? choice = Console.ReadLine();
            switch (choice)
            {
                case "1":
                    await RunSimplifiedVisualizationDemo();
                    break;
                case "2":
                    await RunFullVisualizationDemo();
                    break;
                default:
                    Console.WriteLine("Invalid choice. Exiting.");
                    break;
            }
        }
        
        static async Task RunSimplifiedVisualizationDemo()
        {
            Console.WriteLine("\n=== Running Simplified Visualization Demo ===\n");
            
            // Create a simple trace for demonstration
            GenerateRealTraceForJaeger("simplified-demo");

            // Create a visualization service (simplified)
            var logger = LoggerFactory.CreateLogger("VisualizationExample");
            var visualizationService = new VisualizationService(
                logger, 
                new AgctorSDK.Core.Registry.InMemoryAgentRegistry(), // Empty registry
                new LoggerActivityTracker(logger),  // Simple activity tracker
                new VisualizationOptions { TraceViewerType = TraceViewerType.Jaeger });
            
            // Generate agent hierarchy diagram (mocked for simplicity)
            string agentHierarchyDiagram = GenerateSampleAgentHierarchyDiagram();
            Console.WriteLine("Agent Hierarchy Diagram (Mermaid format):");
            Console.WriteLine(agentHierarchyDiagram);
            Console.WriteLine();
            
            // Generate message flow diagram (mocked for simplicity)
            string messageFlowDiagram = GenerateSampleMessageFlowDiagram();
            Console.WriteLine("Message Flow Diagram (Mermaid format):");
            Console.WriteLine(messageFlowDiagram);
            Console.WriteLine();
            
            // Get the latest trace ID from our demo
            string traceId = GetLatestDemoTraceId();
            
            // Generate HTML with both visualizations
            string html = "<div class=\"agctor-visualization\">";
            
            // Add Jaeger link if Jaeger is running
            html += "<div class=\"viz-links\">";
            html += $"<a href=\"{visualizationService.GetTraceViewerUrl(traceId)}\" target=\"_blank\">View Trace in External Viewer</a>";
            html += "</div>";
            
            // Add agent hierarchy visualization
            html += "<div class=\"viz-section\">";
            html += "<h2>Agent Hierarchy</h2>";
            html += "<pre class=\"mermaid\">";
            html += agentHierarchyDiagram;
            html += "</pre>";
            html += "</div>";
            
            // Add message flow visualization
            html += "<div class=\"viz-section\">";
            html += "<h2>Message Flow</h2>";
            html += "<pre class=\"mermaid\">";
            html += messageFlowDiagram;
            html += "</pre>";
            html += "</div>";
            
            // Close main container and add Mermaid script
            html += "</div>";
            html += "<script src=\"https://cdn.jsdelivr.net/npm/mermaid@10.2.3/dist/mermaid.min.js\"></script>";
            html += "<script>mermaid.initialize({startOnLoad:true});</script>";
            html += "<style>.agctor-visualization { font-family: Arial, sans-serif; max-width: 1200px; margin: 0 auto; padding: 20px; } .viz-section { margin-top: 30px; border: 1px solid #eee; padding: 20px; border-radius: 5px; } .viz-links { margin-bottom: 20px; } .viz-links a { display: inline-block; background: #4285f4; color: white; padding: 8px 16px; text-decoration: none; border-radius: 4px; } h2 { color: #333; }</style>";
            
            // Save to file
            File.WriteAllText("visualization_example.html", html);
            Console.WriteLine("Visualization saved to: visualization_example.html");
            Console.WriteLine("Open this file in a web browser to see the visualizations.");
            Console.WriteLine($"Trace URL: {visualizationService.GetTraceViewerUrl(traceId)}");
        }
        
        static async Task RunFullVisualizationDemo()
        {
            Console.WriteLine("\n=== Running Full Visualization Demo ===\n");
            
            // Generate a real trace with a parent span and multiple child spans
            GenerateRealTraceForJaeger("full-demo");
            
            // 1. Setup DI container with Agctor services including visualization
            var services = new ServiceCollection();
            
            // Add logger
            services.AddSingleton<IAgctorLogger>(LoggerFactory.CreateLogger("VisualizationExample"));
            
            // Add agent registry (required by VisualizationService)
            services.AddSingleton<IAgentRegistry, AgctorSDK.Core.Registry.InMemoryAgentRegistry>();
            
            // Add activity tracker (required by VisualizationService)
            services.AddSingleton<IActivityTracker, LoggerActivityTracker>();
            
            // Add Agctor core services
            services.AddAgctor(options =>
            {
                options.DefaultRuntime = "InMemory";
                options.MaxConcurrentMessages = 100;
                options.EnableDetailedLogging = true;
                options.EnableVisualization = true;
            });
            
            // Get the service provider
            var serviceProvider = services.BuildServiceProvider();
            
            // 2. Get the visualization service
            var visualizationService = serviceProvider.GetRequiredService<IVisualizationService>();
            var logger = serviceProvider.GetRequiredService<IAgctorLogger>();
            
            // Get the agent registry to populate with mock agents
            var agentRegistry = serviceProvider.GetRequiredService<IAgentRegistry>();
            
            // Create and register mock agents to demonstrate hierarchy visualization
            var rootAgentId = "root-agent-123";
            var childAgent1Id = "child-agent-1";
            var childAgent2Id = "child-agent-2";
            var grandchildAgent1Id = "grandchild-agent-1";
            
            var rootAgent = new MockAgent(rootAgentId, "Root Coordinator", null);
            var childAgent1 = new MockAgent(childAgent1Id, "Data Processor", rootAgentId);
            var childAgent2 = new MockAgent(childAgent2Id, "Report Generator", rootAgentId);
            var grandchildAgent1 = new MockAgent(grandchildAgent1Id, "Format Processor", childAgent1Id);
            
            // Register the agents
            await agentRegistry.RegisterAgentAsync(rootAgent);
            await agentRegistry.RegisterAgentAsync(childAgent1);
            await agentRegistry.RegisterAgentAsync(childAgent2);
            await agentRegistry.RegisterAgentAsync(grandchildAgent1);
            
            // 3. Generate agent hierarchy visualization
            logger.LogInfo($"Generating agent hierarchy visualization for root agent: {rootAgentId}");
            string agentHierarchyDiagram = await visualizationService.GenerateAgentHierarchyDiagramAsync(rootAgentId);
            Console.WriteLine("\nAgent Hierarchy Diagram (Mermaid format):");
            Console.WriteLine(agentHierarchyDiagram);
            
            // Get the latest trace ID from our demo
            string traceId = GetLatestDemoTraceId();
            
            // 4. Generate message flow visualization
            logger.LogInfo($"Generating message flow visualization for trace: {traceId}");
            string messageFlowDiagram = await visualizationService.GenerateMessageFlowDiagramAsync(traceId);
            Console.WriteLine("\nMessage Flow Diagram (Mermaid format):");
            Console.WriteLine(messageFlowDiagram);
            
            // 5. Generate HTML with both visualizations
            logger.LogInfo("Generating HTML with visualizations...");
            string html = await visualizationService.GenerateVisualizationHtmlAsync(rootAgentId, traceId);
            
            // Save to file
            File.WriteAllText("visualization_full_example.html", html);
            logger.LogInfo("HTML saved to: visualization_full_example.html");
            logger.LogInfo("Open this file in a web browser to see the visualizations rendered.");
            logger.LogInfo($"Trace viewer URL: {visualizationService.GetTraceViewerUrl(traceId)}");
            logger.LogInfo("Note: Make sure Jaeger is running to use this URL.");
        }
        
        /// <summary>
        /// Generates a real trace with multiple spans and sends it to Jaeger.
        /// </summary>
        private static string GenerateRealTraceForJaeger(string scenarioName)
        {
            // Set up the OpenTelemetry tracer with Jaeger exporter
            using var tracerProvider = Sdk.CreateTracerProviderBuilder()
                .SetResourceBuilder(ResourceBuilder.CreateDefault().AddService("agctor-visualization-demo"))
                .AddSource("Agctor.VisualizationDemo")
                .AddConsoleExporter()
                .AddJaegerExporter(opts =>
                {
                    opts.AgentHost = "localhost";
                    opts.AgentPort = 6831;
                })
                .Build();

            // Create a parent span for the whole operation
            using (var parentActivity = ActivitySource.StartActivity($"{scenarioName}-root-operation", ActivityKind.Internal))
            {
                if (parentActivity != null)
                {
                    // Root agent processing span
                    parentActivity.SetTag("agent.id", "root-agent-123");
                    parentActivity.SetTag("agent.type", "Coordinator");
                    parentActivity.SetTag("operation", "ProcessTask");
                    
                    // Add events to the parent span
                    parentActivity.AddEvent(new ActivityEvent("StartProcessing"));
                    
                    // Sleep to simulate work
                    Thread.Sleep(100);
                    
                    // Create a child span for data processing
                    using (var dataProcessActivity = ActivitySource.StartActivity($"{scenarioName}-data-processing", ActivityKind.Internal))
                    {
                        if (dataProcessActivity != null)
                        {
                            dataProcessActivity.SetTag("agent.id", "child-agent-1");
                            dataProcessActivity.SetTag("agent.type", "DataProcessor");
                            dataProcessActivity.SetTag("operation", "ProcessData");
                            
                            // Simulate work
                            Thread.Sleep(150);
                            
                            // Create a grandchild span for data formatting
                            using (var formatActivity = ActivitySource.StartActivity($"{scenarioName}-format-data", ActivityKind.Internal))
                            {
                                if (formatActivity != null)
                                {
                                    formatActivity.SetTag("agent.id", "grandchild-agent-1");
                                    formatActivity.SetTag("agent.type", "Formatter");
                                    formatActivity.SetTag("operation", "FormatData");
                                    
                                    // Simulate work
                                    Thread.Sleep(75);
                                    
                                    formatActivity.AddEvent(new ActivityEvent("FormattingComplete"));
                                }
                            }
                            
                            dataProcessActivity.AddEvent(new ActivityEvent("ProcessingComplete"));
                        }
                    }
                    
                    // Create another child span for report generation
                    using (var reportActivity = ActivitySource.StartActivity($"{scenarioName}-report-generation", ActivityKind.Internal))
                    {
                        if (reportActivity != null)
                        {
                            reportActivity.SetTag("agent.id", "child-agent-2");
                            reportActivity.SetTag("agent.type", "ReportGenerator");
                            reportActivity.SetTag("operation", "GenerateReport");
                            
                            // Simulate work
                            Thread.Sleep(120);
                            
                            // Simulate an external service call
                            using (var externalActivity = ActivitySource.StartActivity($"{scenarioName}-external-service", ActivityKind.Client))
                            {
                                if (externalActivity != null)
                                {
                                    externalActivity.SetTag("service.name", "ExternalAPI");
                                    externalActivity.SetTag("http.method", "GET");
                                    externalActivity.SetTag("http.url", "https://api.example.com/data");
                                    
                                    // Simulate external service latency
                                    Thread.Sleep(50);
                                    
                                    externalActivity.SetTag("http.status_code", 200);
                                    externalActivity.AddEvent(new ActivityEvent("ResponseReceived"));
                                }
                            }
                            
                            reportActivity.AddEvent(new ActivityEvent("ReportComplete"));
                        }
                    }
                    
                    parentActivity.AddEvent(new ActivityEvent("CompletedAllTasks"));
                    
                    // Return the trace ID for later use
                    return parentActivity.TraceId.ToString();
                }
            }
            
            return string.Empty;
        }
        
        /// <summary>
        /// Gets the latest trace ID from the demo for visualization.
        /// </summary>
        private static string GetLatestDemoTraceId()
        {
            var activity = Activity.Current;
            if (activity != null)
            {
                return activity.TraceId.ToString();
            }
            
            // If no current activity, return the last one from our thread-local storage
            // This is for demo purposes - in a real app, you'd use a more robust approach
            return Activity.GetRootId() ?? "6525672aa63d82161156e2f2e0e393cd"; // Fallback to existing trace
        }
        
        static string GenerateSampleAgentHierarchyDiagram()
        {
            var sb = new StringBuilder();
            
            sb.AppendLine("graph TD");
            sb.AppendLine("root-agent-001[\"root-agent-001<br/>Coordinator<br/>Root agent coordinating tasks\"]");
            sb.AppendLine("child-agent-001[\"child-agent-001<br/>Processor<br/>Process data\"]");
            sb.AppendLine("grandchild-agent-001[\"grandchild-agent-001<br/>Formatter<br/>Format results\"]");
            sb.AppendLine("child-agent-001 --> grandchild-agent-001");
            sb.AppendLine("root-agent-001 --> child-agent-001");
            sb.AppendLine("child-agent-002[\"child-agent-002<br/>Generator<br/>Generate report\"]");
            sb.AppendLine("root-agent-001 --> child-agent-002");
            sb.AppendLine("classDef root fill:#f96,stroke:#333,stroke-width:2px");
            sb.AppendLine("classDef agent fill:#bbf,stroke:#333,stroke-width:1px");
            sb.AppendLine("class root-agent-001 root");
            sb.AppendLine("class child-agent-001,grandchild-agent-001,child-agent-002 agent");
            
            return sb.ToString();
        }
        
        static string GenerateSampleMessageFlowDiagram()
        {
            var sb = new StringBuilder();
            
            sb.AppendLine("sequenceDiagram");
            sb.AppendLine("participant root as \"Root Agent\"");
            sb.AppendLine("participant child1 as \"Child Agent 1\"");
            sb.AppendLine("participant child2 as \"Child Agent 2\"");
            sb.AppendLine("participant grandchild as \"Grandchild Agent\"");
            sb.AppendLine("root->>child1: Process data (150ms)");
            sb.AppendLine("root->>child2: Generate report (120ms)");
            sb.AppendLine("child1->>grandchild: Format results (75ms)");
            sb.AppendLine("grandchild-->child1: Return formatted data");
            sb.AppendLine("child1-->root: Return processed data");
            sb.AppendLine("child2-->root: Return generated report");
            
            return sb.ToString();
        }
    }
    
    /// <summary>
    /// A simple mock implementation of IAgent for demonstration purposes.
    /// </summary>
    public class MockAgent : IAgent
    {
        private readonly List<string> _childIds = new List<string>();
        private readonly string _name;
        private readonly string _description;
        private IAgentFactory? _agentFactory;
        
        public MockAgent(string id, string description, string? parentId)
        {
            Id = id;
            _name = id;
            _description = description;
            ParentAgentId = parentId;
        }
        
        public string Id { get; }
        public AgentStatus Status => AgentStatus.Idle;
        public string ActorType => "MockAgent";
        public ActorState State => ActorState.Active; // Using Active which is a valid ActorState value
        public string? CurrentPrompt => null;
        public string? ParentAgentId { get; private set; }
        
        public IReadOnlyList<string> ChildAgentIds => _childIds;
        
        public string? Name => _name;
        public string? Description => _description;
        
        public Task InitializeAsync(IAgentFactory agentFactory, CancellationToken cancellationToken = default)
        {
            _agentFactory = agentFactory;
            return Task.CompletedTask;
        }
        
        public Task InitializeAsync(CancellationToken cancellationToken = default)
        {
            return Task.CompletedTask;
        }
        
        public Task ShutdownAsync(CancellationToken cancellationToken = default)
        {
            return Task.CompletedTask;
        }
        
        public Task<string> CreateChildAgentAsync(string name, string description, string? configuration = null, CancellationToken cancellationToken = default)
        {
            var childId = $"child-{Guid.NewGuid()}";
            _childIds.Add(childId);
            ChildAgentSpawned?.Invoke(this, new ChildAgentSpawnedEventArgs(childId, Id, name, description));
            return Task.FromResult(childId);
        }
        
        public Task<string> AssignSubtaskAsync(string subtask, string? childId = null, CancellationToken cancellationToken = default)
        {
            return Task.FromResult("task-123");
        }
        
        public Task HandleSubtaskCompletionAsync(string childAgentId, object result, CancellationToken cancellationToken = default)
        {
            SubtaskCompleted?.Invoke(this, new SubtaskCompletedEventArgs(childAgentId, Id, result));
            return Task.CompletedTask;
        }
        
        public Task HandleSubtaskFailureAsync(string childAgentId, Exception exception, CancellationToken cancellationToken = default)
        {
            return Task.CompletedTask;
        }
        
        public void SetAgentFactory(IAgentFactory agentFactory)
        {
            _agentFactory = agentFactory;
        }
        
        public void SetParentAgentId(string? parentAgentId)
        {
            ParentAgentId = parentAgentId;
        }
        
        public event EventHandler<AgentStatusChangedEventArgs>? StatusChanged;
        public event EventHandler<SubtaskCompletedEventArgs>? SubtaskCompleted;
        public event EventHandler<ActorStateChangedEventArgs>? StateChanged;
        public event EventHandler<ChildAgentSpawnedEventArgs>? ChildAgentSpawned;
        
        public Task<IMessageEnvelope> ReceiveAsync(IMessageEnvelope envelope, CancellationToken cancellationToken = default)
        {
            return Task.FromResult(envelope);
        }
        
        public Task HandleMessageAsync(IAgentMessage message, CancellationToken cancellationToken = default)
        {
            return Task.CompletedTask;
        }
        
        public Task<bool> TryExecuteAsync(string code, object? context = null, CancellationToken cancellationToken = default)
        {
            return Task.FromResult(true);
        }
        
        public Task ProcessPromptAsync(string prompt, CancellationToken cancellationToken = default)
        {
            return Task.CompletedTask;
        }
        
        public Task ProcessPromptAsync(CancellationToken cancellationToken = default)
        {
            return Task.CompletedTask;
        }
    }
} 